@{
    ViewBag.RouteMap = Html.ToRoutMap("系统管理", "用户管理");
    Layout = "~/Views/Shared/Layout/_ContentLayout.cshtml";
}

@section include_res
{
    <link href="@Url.Content("~/Content/css/ios-page.css?v=" + ConfigHelper.Get("WebVer"))" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/app/user.mgr.js?v=" + ConfigHelper.Get("WebVer"))"></script>
}

<!-- iOS 风格用户管理(参照 178 附件"会员盈亏详情"页) -->
<div class="container">
    <!-- 统计卡 -->
    <div class="stats-grid" id="statsGrid"></div>

    <!-- 筛选行 -->
    <div class="filter-row">
        <select class="ios-select" id="selRole" style="min-width:120px;"></select>
        <input type="text" class="ios-input" id="txtUsrNameOrAccounts" placeholder="用户名/账号" style="flex:1;min-width:120px;" />
        <button type="button" class="ios-btn secondary" id="btnSearch">查找</button>
        <button type="button" class="ios-btn primary" id="btnAdd">新增用户</button>
    </div>

    <!-- 数据表格 -->
    <div class="table-container">
        <div class="table-scroll">
            <table class="data-table" id="tbUsers">
                <thead>
                    <tr>
                        <th>序号</th>
                        <th>角色</th>
                        <th>账号</th>
                        <th>名字</th>
                        <th>状态</th>
                        <th>备注信息</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="tbUsersBody"></tbody>
            </table>
        </div>
    </div>
    <div class="scroll-hint">左右滑动查看更多数据</div>
</div>

<!-- 新增/编辑用户弹窗 -->
<div class="modal-overlay" id="userModal">
    <div class="modal-card">
        <div class="modal-head">
            <div class="modal-title" id="userModalTitle">新增用户</div>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">角色</label>
                <select class="form-control" id="fRoleID"></select>
            </div>
            <div class="form-group">
                <label class="form-label">用户名</label>
                <input type="text" class="form-control" id="fUName" placeholder="请输入用户名" autocomplete="off" />
            </div>
            <div class="form-group">
                <label class="form-label">账号</label>
                <input type="text" class="form-control" id="fUAccounts" placeholder="请输入账号" autocomplete="off" />
            </div>
            <div class="form-group">
                <label class="form-label">密码<span class="form-tip" id="pwdTip">(编辑时留空则不修改)</span></label>
                <input type="text" class="form-control" id="fUPwd" placeholder="请输入密码" autocomplete="off" />
            </div>
            <div class="form-group">
                <label class="form-label">备注信息</label>
                <input type="text" class="form-control" id="fRemark" placeholder="请输入备注" autocomplete="off" />
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="ios-btn secondary" id="btnModalCancel">取消</button>
            <button type="button" class="ios-btn primary" id="btnModalSave">保存</button>
        </div>
    </div>
</div>

<!-- 删除确认弹窗 -->
<div class="modal-overlay" id="delModal">
    <div class="modal-card">
        <div class="modal-body center">
            <div class="modal-title">确认删除</div>
            <div class="modal-message">删除后不可恢复，确定删除该用户？</div>
        </div>
        <div class="modal-foot">
            <button type="button" class="ios-btn secondary" id="btnDelCancel">取消</button>
            <button type="button" class="ios-btn danger" id="btnDelOk">删除</button>
        </div>
    </div>
</div>
