@{
    ViewBag.RouteMap = "修改密码";
    Layout = "~/Views/Shared/Layout/_ContentLayout.cshtml";
}
@section include_res
{
    <link href="@Url.Content("~/Content/css/ios-page.css?v=" + ConfigHelper.Get("WebVer"))" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/app/user.repwd.js?v=" + ConfigHelper.Get("WebVer"))"></script>
}
<div class="container">
    <div class="ios-form-card">
        <div class="ios-form-title">修改密码</div>
        <form id="form1">
            <div class="form-group">
                <label class="form-label">旧密码</label>
                <input type="password" name="OldPwd" class="form-control" maxlength="20" autocomplete="off" placeholder="请输入旧密码" />
            </div>
            <div class="form-group">
                <label class="form-label">新密码</label>
                <input type="password" name="NewPwd" class="form-control" maxlength="20" autocomplete="off" placeholder="请输入新密码" />
            </div>
            <div class="form-group">
                <label class="form-label">确认新密码</label>
                <input type="password" name="RePwd" class="form-control" maxlength="20" autocomplete="off" placeholder="请再次输入新密码" />
            </div>
            <button type="button" class="ios-btn primary" id="btnSave" style="width:100%;margin-top:8px;">保存</button>
            @Html.AntiForgeryToken()
        </form>
    </div>
</div>
