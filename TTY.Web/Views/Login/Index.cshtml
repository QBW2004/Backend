@{
    Layout = null;
    var srvMsg = TempData["msg"] != null ? TempData["msg"].ToString() : "";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <title>管理后台</title>
    <script type="text/javascript">if (top.window.location.href != window.location.href) top.window.location.href = "/Login/Index";</script>

    @Styles.Render("~/res/login-css")
    <script>
        var _msg = '@srvMsg';
    </script>
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="login-logo">
                <img src="@Url.Content("~/Content/img/logo.png")" alt="LOGO">
            </div>
            <div class="login-title">管理后台</div>
            <div class="login-subtitle">请登录您的管理账号</div>

            <div id="alert-msg" class="alert-msg"></div>

            @using (Html.BeginForm("Index", "Login", new { i = DateTime.Now.Ticks }, FormMethod.Post, new { role = "form", autocomplete = "off" }))
            {
                <div class="login-field">
                    <label class="login-field-label" for="loginUsername">用户名</label>
                    <div class="login-input-wrap">
                        <input type="text" id="loginUsername" name="uname" placeholder="请输入用户名" autocomplete="off">
                    </div>
                </div>
                <div class="login-field">
                    <label class="login-field-label" for="loginPassword">密码</label>
                    <div class="login-input-wrap">
                        <input type="password" id="loginPassword" name="upwd" placeholder="请输入密码" autocomplete="off">
                        <button type="button" class="toggle-pwd" id="togglePwd">显示</button>
                    </div>
                </div>
                <button type="submit" class="login-btn" id="loginBtn">登录</button>

                @Html.AntiForgeryToken()
            }
        </div>
        <div class="login-tip">请使用 Chrome 56+、IE10+、Firefox 51+、Safari 9.3+ 版本的浏览器。</div>
    </div>
    @Scripts.Render("~/res/login-js")
</body>
</html>
