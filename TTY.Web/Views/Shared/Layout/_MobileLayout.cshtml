@{
    M_LoginUser mUser = WebHelper.GetLoginInfo();
    string webVer = ConfigHelper.Get("WebVer");
    bool isRMB = ConfigHelper.Get("IsRMB") == "1";
    int exchangeRate = 0;
    int.TryParse(ConfigHelper.Get("ExchangeRate"), out exchangeRate);

    int priv = mUser != null && mUser.UserPriv.HasValue ? mUser.UserPriv.Value : -1;
    bool isSuper = priv == 0;
    bool canUpDown = isSuper || (mUser != null && mUser.IsUpDown == 1);
    bool canFrozen = isSuper || (mUser != null && mUser.IsFrozen == 1);
    bool canKick = isSuper || (mUser != null && mUser.IsKicking == 1);
    bool canCreateAgent = isSuper || (mUser != null && mUser.IsCreateAgent == 1);
    bool canModifyPwd = isSuper || (mUser != null && mUser.IsModifyPwd == 1);

    // 当前页标识，用于抽屉菜单高亮
    string mPage = ViewBag.MPage == null ? "" : (string)ViewBag.MPage;
    // 顶栏按钮：菜单常驻在左；需要返回时放在菜单右侧，两者不互斥
    bool showMenu = ViewBag.MShowMenu == null ? true : (bool)ViewBag.MShowMenu;
    bool showBack = ViewBag.MShowBack == null ? mPage != "index" : (bool)ViewBag.MShowBack;
    bool showRefresh = ViewBag.MShowRefresh == null ? true : (bool)ViewBag.MShowRefresh;
    bool showSearch = ViewBag.MShowSearch == null ? false : (bool)ViewBag.MShowSearch;

    // 抽屉菜单高亮 class（预先算好，避免在属性里写带引号的方法调用）
    string navIndex = "m-sidebar-item" + (mPage == "index" ? " active" : "");
    string navAgents = "m-sidebar-item" + (mPage == "agents" ? " active" : "");
    string navAddAgent = "m-sidebar-item" + (mPage == "addagent" ? " active" : "");
    string navRecharge = "m-sidebar-item" + (mPage == "recharge" ? " active" : "");
    string navRecords = "m-sidebar-item" + (mPage == "records" ? " active" : "");
}<!DOCTYPE html>
<html lang="zh" class="m-html">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#007aff" />
    <title>@(ViewBag.MTitle ?? "管理后台")</title>
    <link href="@Url.Content("~/Content/css/mobile.css?v=" + webVer)" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/jquery-2.1.4.js")"></script>
    <script>
        window.MConfig = {
            isRMB: @Html.Raw(isRMB ? "true" : "false"),
            exchangeRate: @exchangeRate,
            page: '@Html.Raw(mPage)',
            token: '',
            user: {
                accounts: '@Html.Raw(HttpUtility.JavaScriptStringEncode(mUser != null ? mUser.Accounts : ""))',
                priv: @priv,
                inviteCode: '@Html.Raw(HttpUtility.JavaScriptStringEncode(mUser != null ? (mUser.InviteCode ?? "") : ""))'
            },
            perms: {
                isSuper: @Html.Raw(isSuper ? "true" : "false"),
                upDown: @Html.Raw(canUpDown ? "true" : "false"),
                frozen: @Html.Raw(canFrozen ? "true" : "false"),
                kick: @Html.Raw(canKick ? "true" : "false"),
                createAgent: @Html.Raw(canCreateAgent ? "true" : "false"),
                modifyPwd: @Html.Raw(canModifyPwd ? "true" : "false")
            }
        };
    </script>
    @RenderSection("head", required: false)
</head>
<body class="m-body m-app" data-page="@mPage">

    <!-- 隐藏的防伪令牌，供所有 ajax POST 复用 -->
    <form id="mTokenForm" style="display:none">@Html.AntiForgeryToken()</form>

    <!-- ============== 顶栏 ============== -->
    <header class="m-header">
        <div class="m-header-content">
            @if (showMenu)
            {
                <button type="button" class="m-header-btn left" id="mMenuBtn" aria-label="菜单">
                    <svg viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" /></svg>
                </button>
            }
            @if (showBack)
            {
                <button type="button" class="m-header-btn @(showMenu ? "left-2" : "left")" id="mBackBtn" aria-label="返回">
                    <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" /></svg>
                </button>
            }

            @if (showSearch)
            {
                <button type="button" class="m-header-btn right-2" id="mSearchBtn" aria-label="搜索">
                    <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" /></svg>
                </button>
            }
            @if (showRefresh)
            {
                <button type="button" class="m-header-btn right" id="mRefreshBtn" aria-label="刷新">
                    <svg viewBox="0 0 24 24"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" /></svg>
                </button>
            }

            <h1>@(ViewBag.MTitle ?? "管理后台")</h1>
            <div class="m-subtitle" id="mSubtitle">@Html.Raw(ViewBag.MSubtitle ?? "")</div>
        </div>
    </header>

    <!-- ============== 侧边抽屉 ============== -->
    <div class="m-sidebar-overlay" id="mSidebarOverlay"></div>
    <aside class="m-sidebar" id="mSidebar">
        <div class="m-sidebar-header">
            <div class="m-sidebar-user">
                <div class="m-sidebar-avatar">
                    <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                </div>
                <div class="m-sidebar-user-details">
                    <div class="m-sidebar-username">@(mUser != null ? mUser.Accounts : "")</div>
                    <div class="m-sidebar-role">
                        @if (isSuper)
                        {
                            <text>管理员</text>
                        }
                        else if (priv == 9)
                        {
                            <text>副管理</text>
                        }
                        else if (priv == 10)
                        {
                            <text>运营</text>
                        }
                        else if (priv > 0)
                        {
                            <text>@priv 级代理</text>
                        }
                        @if (mUser != null && !string.IsNullOrWhiteSpace(mUser.InviteCode))
                        {
                            <text> · 邀请码 @mUser.InviteCode</text>
                        }
                    </div>
                </div>
            </div>
            <button type="button" class="m-sidebar-close" id="mSidebarClose" aria-label="关闭">
                <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg>
            </button>
        </div>

        <nav class="m-sidebar-menu">
            <a class="@navIndex" href="@Url.Action("Index", "Home", new { area = "Mobile" })">
                <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg>
                <span>玩家列表</span>
            </a>
            <a class="@navAgents" href="@Url.Action("Agents", "Home", new { area = "Mobile" })">
                <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                <span>我的代理</span>
            </a>
            @if (canCreateAgent)
            {
                <a class="@navAddAgent" href="@Url.Action("AddAgent", "Home", new { area = "Mobile" })">
                    <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>
                    <span>添加代理</span>
                </a>
            }
            @if (canUpDown)
            {
                <a class="@navRecharge" href="@Url.Action("Recharge", "Home", new { area = "Mobile" })">
                    <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" /></svg>
                    <span>玩家充退</span>
                </a>
            }
            <a class="@navRecords" href="@Url.Action("Records", "Home", new { area = "Mobile" })">
                <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-7-2h2v-4h4v-2h-4V7h-2v4H8v2h4z" /></svg>
                <span>充退记录</span>
            </a>
        </nav>

        <div class="m-sidebar-actions">
            @if (canKick)
            {
                <button type="button" class="m-sidebar-action kick" id="mKickAllBtn">
                    <svg viewBox="0 0 24 24"><path d="M20 17.17L18.83 16H4V4h16v13.17zM20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4V4c0-1.1-.9-2-2-2z" /></svg>
                    一键踢人
                </button>
            }
            <button type="button" class="m-sidebar-action password" id="mChangePwdBtn">
                <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z" /></svg>
                修改密码
            </button>
            <button type="button" class="m-sidebar-action desktop" id="mDesktopBtn">
                <svg viewBox="0 0 24 24"><path d="M20 18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z" /></svg>
                切换电脑版
            </button>
            <button type="button" class="m-sidebar-action logout" id="mLogoutBtn">
                <svg viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" /></svg>
                退出登录
            </button>
        </div>
    </aside>

    <!-- ============== 主内容 ============== -->
    <main class="m-page" id="mMain">
        @RenderBody()
    </main>

    <!-- ============== 全局构件 ============== -->
    <div id="mModalHost"></div>
    <div class="m-loading" id="mLoading"><span class="m-spinner"></span><span class="m-loading-text">处理中...</span></div>
    <div class="m-toast-container" id="mToast"></div>

    <script src="@Url.Content("~/Scripts/app/mobile/mobile.core.js?v=" + webVer)"></script>
    <script>
        jQuery(function () { MApp.initShell(); });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
