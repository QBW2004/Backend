@{
    M_LoginUser mUser = WebHelper.GetLoginInfo();
    string webVer = ConfigHelper.Get("WebVer");
    bool isRMB = ConfigHelper.Get("IsRMB") == "1";
    int exchangeRate = 0;
    int.TryParse(ConfigHelper.Get("ExchangeRate"), out exchangeRate);

    int priv = mUser != null && mUser.UserPriv.HasValue ? mUser.UserPriv.Value : -1;
    bool isSuper = priv == 0;
    bool canUpDown = isSuper || (mUser != null && mUser.IsUpDown == 1);
    bool canFrozen = isSuper || (mUser != null && mUser.IsFrozen == 1);
    bool canCreateAgent = isSuper || (mUser != null && mUser.IsCreateAgent == 1);

    // 当前页标识，用于抽屉菜单高亮
    string mPage = ViewBag.MPage == null ? "" : (string)ViewBag.MPage;
    // 头部按钮：玩家列表页是 菜单+刷新(+搜索)；其余子页是 返回+刷新
    bool showMenu = ViewBag.MShowMenu != null && (bool)ViewBag.MShowMenu;
    bool showBack = ViewBag.MShowBack == null ? !showMenu : (bool)ViewBag.MShowBack;
    bool showRefresh = ViewBag.MShowRefresh == null ? true : (bool)ViewBag.MShowRefresh;
    bool showSearch = ViewBag.MShowSearch != null && (bool)ViewBag.MShowSearch;
    bool headerTall = ViewBag.MHeaderTall != null && (bool)ViewBag.MHeaderTall;

    string roleName = "管理员";
    if (!isSuper)
    {
        if (priv == 9) { roleName = "副管理"; }
        else if (priv == 10) { roleName = "运营"; }
        else if (priv > 0) { roleName = priv + "级代理"; }
        else { roleName = (mUser != null ? mUser.Accounts : ""); }
    }
    string inviteCode = mUser != null && !string.IsNullOrWhiteSpace(mUser.InviteCode) ? mUser.InviteCode : "--";
}<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="theme-color" content="#007aff">
    <title>@(ViewBag.MTitle ?? "管理后台")</title>
    <link href="@Url.Content("~/Content/css/phone.css?v=" + webVer)" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/jquery-2.1.4.min.js")"></script>
    <script>
        window.MConfig = {
            isRMB: @Html.Raw(isRMB ? "true" : "false"),
            exchangeRate: @exchangeRate,
            page: '@Html.Raw(mPage)',
            token: '',
            user: {
                accounts: '@Html.Raw(HttpUtility.JavaScriptStringEncode(mUser != null ? mUser.Accounts : ""))',
                priv: @priv,
                inviteCode: '@Html.Raw(HttpUtility.JavaScriptStringEncode(inviteCode))'
            },
            perms: {
                isSuper: @Html.Raw(isSuper ? "true" : "false"),
                upDown: @Html.Raw(canUpDown ? "true" : "false"),
                frozen: @Html.Raw(canFrozen ? "true" : "false"),
                createAgent: @Html.Raw(canCreateAgent ? "true" : "false")
            }
        };
    </script>
    @RenderSection("head", required: false)
</head>
<body>

    <!-- 隐藏的防伪令牌，供所有 ajax POST 复用 -->
    <form id="mTokenForm" style="display:none">@Html.AntiForgeryToken()</form>

    <!-- ============== 头部 ============== -->
    <div class="header@(headerTall ? " tall" : "")">
        <div class="header-content">
            @if (showMenu)
            {
                <button class="menu-btn" id="menuBtn">
                    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"></path></svg>
                </button>
            }
            @if (showBack)
            {
                <button class="back-btn" id="backBtn">
                    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path></svg>
                </button>
            }
            <h1>@(ViewBag.MTitle ?? "管理后台")</h1>
            <div class="subtitle">
                @if (ViewBag.MSubtitle != null)
                {
                    <text>@ViewBag.MSubtitle</text>
                }
                @if (ViewBag.MSubtitleHtml != null)
                {
                    @Html.Raw(ViewBag.MSubtitleHtml)
                }
            </div>
            @if (showRefresh)
            {
                <button class="refresh-btn" id="refreshBtn">
                    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"></path></svg>
                </button>
            }
            @if (showSearch)
            {
                <button class="search-btn" id="searchBtn">
                    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"></path></svg>
                </button>
            }
        </div>
    </div>

    <!-- ============== 侧边抽屉（仅玩家列表主页有） ============== -->
    @if (showMenu)
    {
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-user-info">
                    <div class="sidebar-avatar">
                        <svg viewBox="0 0 24 24" width="40" height="40">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="#007aff"></path>
                        </svg>
                    </div>
                    <div class="sidebar-user-details">
                        <div class="sidebar-username" id="sidebarUsername">@roleName</div>
                        <div class="sidebar-invite-code" id="sidebarInviteCode">邀请码: @inviteCode</div>
                    </div>
                </div>
                <button class="sidebar-close-btn" id="sidebarCloseBtn">
                    <svg viewBox="0 0 24 24" width="24" height="24">
                        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="currentColor"></path>
                    </svg>
                </button>
            </div>
            <div class="sidebar-menu">
                @if (canCreateAgent)
                {
                    <a href="@Url.Action("AddAgent", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"></path></svg>
                        添加代理
                    </a>
                }
                <a href="@Url.Action("Agents", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="currentColor"></path></svg>
                    我的代理
                </a>
                <a href="@Url.Action("Huiyuan", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor"></path></svg>
                    我的会员
                </a>
                @if (canUpDown)
                {
                    <a href="@Url.Action("Recharge", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" fill="currentColor"></path></svg>
                        玩家充退
                    </a>
                }
                <a href="@Url.Action("Records", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-7-2h2v-4h4v-2h-4V7h-2v4H8v2h4z" fill="currentColor"></path></svg>
                    充退记录
                </a>
                @if (isSuper)
                {
                    <a href="@Url.Action("Abnormal", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" fill="currentColor"></path></svg>
                        异常账号
                    </a>
                }
                @if (canFrozen)
                {
                    <a href="@Url.Action("BanPlayer", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" fill="currentColor"></path></svg>
                        玩家封号
                    </a>
                }
                @if (isSuper)
                {
                    <a href="@Url.Action("BanAgent", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="currentColor"></path></svg>
                        代理封号
                    </a>
                    <a href="@Url.Action("Blacklist", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm5 11H7v-2h10v2z" fill="currentColor"></path></svg>
                        代理拉黑
                    </a>
                    <a href="@Url.Action("Songjiang", "Home", new { area = "Mobile" })" class="sidebar-menu-item">
                        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 9h-2V5h2v6zm0 4h-2v-2h2v2z" fill="currentColor"></path></svg>
                        送奖管理
                    </a>
                }
                <div class="sidebar-menu-placeholder">
                    <div class="placeholder-text">更多功能即将上线</div>
                </div>
                <button class="kick-machine-btn" id="kickMachineBtn" style="display: none;">
                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M20 17.17L18.83 16H4V4h16v13.17zM20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4V4c0-1.1-.9-2-2-2z"></path></svg>
                    卡机踢人
                </button>
                <button class="change-password-btn" id="changePasswordBtn">
                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"></path></svg>
                    修改密码
                </button>
                <button class="logout-btn" id="logoutBtn">
                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"></path></svg>
                    退出登录
                </button>
            </div>
        </div>
    }

    <!-- ============== 主内容 ============== -->
    <main>@RenderBody()</main>

    <!-- ============== 全局构件 ============== -->
    <div class="loading-container" id="mLoading">处理中...</div>
    <div class="m-toast-container" id="mToast"></div>

    <script src="@Url.Content("~/Scripts/app/phone/phone.core.js?v=" + webVer)"></script>
    <script>
        // 脚本在 body 末尾加载，DOM 已就绪；不依赖 jQuery ready
        //（部分 WebView 中 ready 之后注册的回调不会被执行）
        MApp.initShell();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
