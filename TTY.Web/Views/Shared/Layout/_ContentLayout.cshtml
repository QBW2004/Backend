@using YYT.Common

<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="utf-8" />
    @*<meta name="viewport" content="width=device-width" />*@
    <meta name="viewport" content="initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    @Styles.Render("~/res/easyui-css")
    <link href="@Url.Content("~/Content/css/font-awesome.css?v=" + ConfigHelper.Get("WebVer"))" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/animate.css?v=" + ConfigHelper.Get("WebVer"))" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/layout.css?v=" + ConfigHelper.Get("WebVer"))" rel="stylesheet" />
    <script src="~/Scripts/jquery-2.1.4.js"></script>


    </style>



    @Scripts.Render("~/res/jquery-js")
    <script>
        // 代理线隔离（2026-10-30）：登录账号所在线的可玩游戏（null = 不限，总台恒为 null）。控制页的游戏下拉按它过滤，
        // 保存控制时服务端还会按玩家所在线再校验。控牌指令号 → GameId 与中心服 cardActionToGameId 同口径。
        window.MTH_PLAYABLE_GAMES = @Html.Raw(YYT.BLL.EF.LineScopeRules.PlayableGamesJson(WebHelper.GetLoginInfo()));
        window.MTH_CARD_ACTION_GAME = { 5: 15, 7: 37, 8: 25, 12: 14, 13: 44, 14: 5, 15: 53, 16: 16, 17: 40, 19: 54 };
        window.mthFilterCardActions = function (list) {
            var pg = window.MTH_PLAYABLE_GAMES;
            if (!pg || !list) return list;
            var out = [], hasSelected = false;
            for (var i = 0; i < list.length; i++) {
                var gid = window.MTH_CARD_ACTION_GAME[list[i].id];
                if (gid && pg.indexOf(gid) < 0) continue;
                out.push(list[i]);
                if (list[i].selected) hasSelected = true;
            }
            if (out.length > 0 && !hasSelected) out[0].selected = true;
            return out;
        };
    </script>
        @RenderSection("include_res", required: false)
</head>
<body>
    <div class="title-map"><span>当前位置</span><span>@Html.Raw(ConstStr.FONT_SIGN_DB_GT) @ViewBag.RouteMap</span> </div>
    <div class="main">
        <div class="main-loading bg"><div class="main-loading-mask">正在处理;请稍待。。。</div></div>
        @RenderBody()
    </div>

    <!-- 注：内容页缩放由父框架 #wrapper 的 CSS zoom 统一处理，此处无需再次缩放，
         否则会与父级缩放叠加导致双重缩放。 -->
</body>
</html>
