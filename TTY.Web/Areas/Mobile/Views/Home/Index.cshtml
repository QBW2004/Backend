@{
    Layout = "~/Views/Shared/Layout/_MobileLayout.cshtml";
    string webVer = ConfigHelper.Get("WebVer");
}

<div class="m-container">
    <div class="m-tabs">
        <div class="m-tabs-header">
            <div class="m-tab active" data-tab="online">
                在线玩家<span class="m-tab-count" id="mOnlineCount">0</span>
            </div>
            <div class="m-tab" data-tab="all">
                全部玩家<span class="m-tab-count" id="mAllCount">0</span>
            </div>
        </div>

        <div class="m-tab-pane active" id="mPaneOnline">
            <div class="m-chips">
                <button type="button" class="m-chip active" data-sort="win">今日赢最多</button>
                <button type="button" class="m-chip" data-sort="loss">今日输最多</button>
                <button type="button" class="m-chip" data-sort="bet">押注最大</button>
                <button type="button" class="m-chip" data-sort="account">按账号</button>
            </div>
            <div id="mOnlineList">
                <div class="m-empty"><span class="m-spinner dark"></span> 加载中...</div>
            </div>
        </div>

        <div class="m-tab-pane" id="mPaneAll">
            <div id="mSearchTip" class="m-chips m-hidden"></div>
            <div id="mAllList">
                <div class="m-empty">点击右上角刷新或搜索加载玩家</div>
            </div>
            <div class="m-load-more" id="mAllLoadMoreBox">
                <button type="button" class="m-load-more-btn" id="mAllLoadMore">加载更多</button>
            </div>
            <div class="m-empty m-hidden" id="mAllNoMore">已加载全部数据</div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        window.MPage = {
            canUpDown: @Html.Raw(ViewBag.CanUpDown == true ? "true" : "false"),
            canFrozen: @Html.Raw(ViewBag.CanFrozen == true ? "true" : "false"),
            canKick: @Html.Raw(ViewBag.CanKick == true ? "true" : "false"),
            canModifyPwd: @Html.Raw(ViewBag.CanModifyPwd == true ? "true" : "false")
        };
    </script>
    <script src="@Url.Content("~/Scripts/app/mobile/mobile.players.js?v=" + webVer)"></script>
}
