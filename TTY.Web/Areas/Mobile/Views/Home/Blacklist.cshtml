@{
    /* 黑名单管理（吃分，2026-11-04 从操作管理拆出，对齐参考站 heimingdang）：玩家账号 + 吃分金额，确定 / 移除黑名单 */
    string webVer = ConfigHelper.Get("WebVer");
    string presetAccount = (string)(ViewBag.PresetAccount ?? "");
    Layout = "~/Views/Shared/Layout/_MobileLayout.cshtml";
}
@section head {
<style>
    .container { padding: 20px 10px 28px; max-width: 600px; margin: 0 auto; }
    .input-section { padding: 18px 16px 22px; max-width: 100%; display: block; }
    .bl-row { display: block; margin-bottom: 20px; }
    .bl-row > label { display: block; margin-bottom: 8px; color: #333; font-size: 14px; font-weight: 500; }
    .bl-row .input-field { width: 100%; height: 46px; font-size: 15px; }
    .bl-actions { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
    .bl-actions button { width: 100%; height: 48px; border: 0; border-radius: 10px; color: #fff; font-size: 16px; font-weight: 600; cursor: pointer; }
    .bl-apply { background: #0071e3; }
    .bl-remove { background: #ff3b30; }
    .bl-actions button:disabled { opacity: .5; cursor: default; }
    /* 当前控制（2026-11-04）：吃分与放水互斥，下发前要看得到玩家正在执行什么 */
    .bl-status { display: flex; align-items: flex-start; gap: 10px; margin: -6px 0 20px; padding: 9px 10px; background: rgba(0,122,255,.06); border: 1px solid #eef0f2; border-radius: 8px; font-size: 14px; color: #666; }
    .bl-status > span:first-child { flex: 0 0 auto; }
    .bl-status-value { margin-left: auto; min-width: 0; text-align: right; color: #ff3b30; font-weight: 500; overflow-wrap: anywhere; }
    .bl-status-value.none { color: #8e8e93; font-weight: 400; }
    .bl-hint { margin: -12px 0 16px; color: #ff9500; font-size: 12px; text-align: right; }
    .bl-hint:empty { display: none; }
</style>
}
<div class="container">
    <div class="input-section">
        <div class="bl-row">
            <label for="blAccount">玩家账号</label>
            <input type="text" id="blAccount" class="input-field" placeholder="请输入玩家账号" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false">
        </div>
        <div class="bl-status"><span>当前控制</span><span class="bl-status-value none" id="blStatus">--</span></div>
        <div class="bl-hint" id="blHint"></div>
        <div class="bl-row">
            @* 吃分金额 = 吃钻数，与原操作管理“目标（钻）”同一口径（GoldThreshold 单位为钻，吃满即自动结束） *@
            <label for="blGold">吃分金额（钻）</label>
            <input type="number" id="blGold" class="input-field" min="1" step="1" placeholder="请输入吃钻数，吃满后自动结束" inputmode="numeric" autocomplete="off">
        </div>
        <div class="bl-actions">
            <button type="button" class="bl-apply" id="blApplyBtn">确定</button>
            <button type="button" class="bl-remove" id="blRemoveBtn">移除黑名单</button>
        </div>
    </div>
</div>
@section scripts {
    <script>window.MPagePreset = { account: '@Html.Raw(HttpUtility.JavaScriptStringEncode(presetAccount))' };</script>
    <script src="@Url.Content("~/Scripts/app/phone/phone.blacklist.js?v=" + webVer)"></script>
}
