@{
    /* 送奖管理（1:1 复刻参考站 songjiang 的视觉结构）
       说明：参考站的牌型赔率/奖池/实时押注依赖其游戏服子系统，本项目按
            「带风控的赠送」简化落地：查询玩家 → 校验今日输赢 → 赠送金币。
       数据源：/Game/UserInfo/GetVisibleUserRows、/Game/UserInfo/SaveGive、
              /Game/Recharge/GetReChargeRecordsForPhone(TypeFlag=3) */
    string webVer = ConfigHelper.Get("WebVer");
    string presetAccount = (string)(ViewBag.PresetAccount ?? "");
    Layout = "~/Views/Shared/Layout/_MobileLayout.cshtml";
}

@section head {
<style>
    .diamond-count {
        color: #ffd700;
        font-weight: 500;
    }

    .container {
        padding: 16px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-title {
        font-size: 16px;
        font-weight: 600;
        color: #666;
        margin: 0 0 12px;
        padding-bottom: 8px;
        text-align: center;
        border-bottom: 1px solid #eaeaea;
    }

    .form-row {
        margin-bottom: 12px;
    }

    .form-row:last-child {
        margin-bottom: 0;
    }

    .form-label {
        display: block;
        font-size: 14px;
        font-weight: 500;
        color: #666;
        margin-bottom: 8px;
    }

    .give-btn {
        height: 44px;
        background-color: #34c759;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 0 20px;
        font-size: 16px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
        white-space: nowrap;
        width: 100%;
        -webkit-appearance: none;
        appearance: none;
    }

    .give-btn:hover {
        background-color: #2db149;
    }

    .give-btn:active {
        transform: scale(0.98);
    }

    .give-btn:disabled {
        background-color: #a1a1a6;
        cursor: not-allowed;
    }

    /* 玩家信息卡 */
    .player-info-card {
        margin-top: 4px;
        padding: 15px;
        border-radius: 12px;
        background-color: rgba(0, 122, 255, 0.08);
        display: none;
    }

    .player-info-card.show {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .player-info-card .info-row {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        background: white;
        border-radius: 6px;
        border: 1px solid #eaeaea;
        font-size: 14px;
        color: #666;
    }

    .player-info-card .info-value {
        margin-left: auto;
        font-size: 15px;
        font-weight: 600;
        color: #1d1d1f;
    }

    .status-online {
        color: #34c759;
    }

    .status-offline {
        color: #8e8e93;
    }

    .input-with-btn {
        display: flex;
        gap: 8px;
    }

    .input-with-btn .input-field {
        flex: 1;
    }

    .query-btn {
        height: 44px;
        padding: 0 20px;
        background-color: #007aff;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        -webkit-appearance: none;
        appearance: none;
    }

    .table-container table {
        min-width: 560px;
    }

    .amount {
        font-family: -apple-system-monospace, monospace;
        font-weight: 500;
    }

    .amount.positive {
        color: #34c759;
    }

    .time {
        color: #666;
        white-space: nowrap;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 20px;
        gap: 8px;
    }

    .pagination-btn {
        padding: 8px 16px;
        border: 1px solid #e5e5e5;
        border-radius: 6px;
        background-color: white;
        color: #333;
        cursor: pointer;
        -webkit-appearance: none;
        appearance: none;
    }

    .pagination-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .pagination-info {
        color: #666;
        font-size: 14px;
    }

    @@media (max-width: 768px) {
        .table-container {
            overflow-x: auto;
        }
    }
</style>
}

    <div class="container">
        <div class="input-section" style="max-width:100%;">
            <div class="section-title">送奖</div>
            <div class="form-row">
                <label class="form-label" for="giveAccount">玩家账号</label>
                <div class="input-with-btn">
                    <input type="text" id="giveAccount" class="input-field" placeholder="输入玩家账号" autocomplete="off">
                    <button class="query-btn" id="queryBtn" type="button">查询</button>
                </div>
            </div>

            <div class="player-info-card" id="playerInfoCard">
                <div class="info-row"><span>昵称</span><span class="info-value" id="piName">--</span></div>
                <div class="info-row"><span>剩余金币</span><span class="info-value" id="piCoins">--</span></div>
                <div class="info-row"><span>今日输赢</span><span class="info-value" id="piToday">--</span></div>
                <div class="info-row"><span>在线状态</span><span class="info-value" id="piOnline">--</span></div>
            </div>

            <div class="form-row" style="margin-top:12px;">
                <label class="form-label" for="giveAmount">送奖金额（金币）</label>
                <input type="number" id="giveAmount" class="input-field" placeholder="请输入送奖金额" inputmode="numeric" autocomplete="off">
            </div>
            <div class="form-row">
                <button class="give-btn" id="giveBtn" type="button" disabled>送奖</button>
            </div>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>时间</th>
                        <th>玩家账号</th>
                        <th>玩家名称</th>
                        <th>送奖金额</th>
                        <th>操作人</th>
                        <th>状态</th>
                    </tr>
                </thead>
                <tbody id="recordBody"></tbody>
            </table>
            <div class="no-data" id="noData" style="display: block;">暂无送奖记录</div>
        </div>

        <div class="pagination">
            <button class="pagination-btn" id="prevBtn" disabled>上一页</button>
            <div class="pagination-info" id="paginationInfo">第 1 页 / 共 0 页</div>
            <button class="pagination-btn" id="nextBtn" disabled>下一页</button>
        </div>
    </div>

@section scripts {
    <script>
        window.MPagePreset = { account: '@Html.Raw(HttpUtility.JavaScriptStringEncode(presetAccount))' };
    </script>
    <script src="@Url.Content("~/Scripts/app/phone/phone.songjiang.js?v=" + webVer)"></script>
}
