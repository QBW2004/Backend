    function gcOpenNewTableDialog() {
        openWin({
            winId: '#gcNewTableWin',
            title: '【新建桌台】',
            height: 245,
            width: 430,
            iconCls: 'icon-add',
            callBack: function () {
                var $count = $('#gcNewTableCount');
                if (!$count.data('numberbox')) $count.numberbox({ min: 1, max: GC_NEW_TABLE_MAX, precision: 0 });
                $count.numberbox('setValue', GC_NEW_TABLE_COUNT > 0 ? GC_NEW_TABLE_COUNT : 1);
            }
        });
    }

    function gcReadNewTableCount() {
        var $count = $('#gcNewTableCount');
        var value = $count.data('numberbox') ? Number($count.numberbox('getValue')) : Number($count.val());
        if (!isFinite(value) || Math.floor(value) !== value || value < 1 || value > GC_NEW_TABLE_MAX) return 0;
        return value;
    }

    function gcPrepareNewTableForm(count) {
        var type = gcGetType();
        if (gcCurLine()) {
            showToast('专属桌台请用「从公共桌台复制一套」生成，不能直接新建！', 'warning');
            return;
        }
        if (type != 0 && type != 1 && type != 2 && type != 3) {
            showToast('请先选择游戏类型与游戏！', 'warning');
            return;
        }
        var gameId = parseInt($('#gcGameSel').val(), 10);
        $('#gcTableList li').removeClass('active');
        var src = gcLatestTable();
        if (src) {
            gcFill(src);
        } else {
            gcZeroForm();
            $('#gcEnabled').prop('checked', true);
            if (type === 1 || type === 3) gcApplyCardDefaults();
        }
        GC_NEW_TABLE_COUNT = count || 1;
        $('#gcId').val(-1);
        $('#gcGameId').val(isNaN(gameId) ? -1 : gameId);
        $('#gcGameType').val(type);
        $('#gcTableName').val('');
        gcApplyType();
        $('#gcCurTableName').text(src
            ? '新建' + GC_NEW_TABLE_COUNT + '张桌台（已套用最近桌台基础参数，填写桌名并核对权重后保存）'
            : '新建' + GC_NEW_TABLE_COUNT + '张桌台（基础参数与权重一并保存）');
        if (window.labaWeightsLoad) window.labaWeightsLoad();
        if (window.phenixConfigLoad) window.phenixConfigLoad();
        if (window.rabbitPayoutLoad) window.rabbitPayoutLoad();
        if (window.rabbitConfigLoad) window.rabbitConfigLoad();
        if (window.attMhbLoad) window.attMhbLoad();
        gcSyncSwitch();
        gcUpdateSaveBtn();
    }

    function gcNewTable() {
        var type = gcGetType();
        if (gcCurLine()) {
            showToast('专属桌台请用「从公共桌台复制一套」生成，不能直接新建！', 'warning');
            return;
        }
        if (type != 0 && type != 1 && type != 2 && type != 3) {
            showToast('请先选择游戏类型与游戏！', 'warning');
            return;
        }
        gcOpenNewTableDialog();
    }

    function gcConfirmNewTable() {
        var count = gcReadNewTableCount();
        if (!count) {
            showToast('新建数量必须是 1~' + GC_NEW_TABLE_MAX + ' 的整数！', 'warning');
            return;
        }
        $('#gcNewTableWin').dialog('close');
        gcPrepareNewTableForm(count);
    }

