        $('#gcMaxBet').val(1);
        $('#gcCoinSc').val(1);
        $('#gcCoinNeed').val(1);
        $('#gcScoreSwitch').val(1);
    }

    function gcNewTable() {
        var type = gcGetType();
        if (type != 0 && type != 1 && type != 2 && type != 3) {
            showToast('请先选择游戏类型与游戏！', 'warning');
            return;
        }
        var gameId = parseInt($('#gcGameSel').val(), 10);
        $('#gcTableList li').removeClass('active');
        var src = gcLatestTable();
        if (src) {
            gcFill(src);
        } else {
            gcZeroForm();
            $('#gcEnabled').prop('checked', true);
            if (type === 1 || type === 3) gcApplyCardDefaults();
        }
        $('#gcId').val(-1);
        $('#gcGameId').val(isNaN(gameId) ? -1 : gameId);
        $('#gcGameType').val(type);
        $('#gcTableName').val('');
        gcApplyType();
        $('#gcCurTableName').text(src ? '新建桌台（已套用最近桌台基础参数，填写桌名即可保存；中奖权重须单独设置）' : '新建桌台（保存基础信息后设置中奖权重）');
        gcSyncSwitch();
        gcUpdateSaveBtn();
    }

