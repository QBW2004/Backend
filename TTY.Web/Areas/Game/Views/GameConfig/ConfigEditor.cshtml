    // 恢复基础桌台默认值，保留已编辑的中奖权重，统一由底部保存按钮提交。
    function gcResetForm() {
        gcZeroForm();
        if ($('#gcGameId').val() === '55') {
            gcApplyCardDefaults();
            if (window.rabbitConfigReset) window.rabbitConfigReset();
            return;
        }
        if (gcGetType() !== 3) return;          // 非拉霸维持原"清空=默认"
        if (gcIsMjhl()) {
            // 麻将胡了默认 0.4～20 分、每次增加 0.1 分，与新建桌台保持一致。
            gcApplyCardDefaults();
            return;
        }
        // 拉霸可见的押分/兑换默认（最小/最大押分 1、每个钻分值 1、进房钻 1、加炮分值 1；与新建桌台一致）
        $('#gcMinBet').val(1);
        $('#gcMaxBet').val(1);
