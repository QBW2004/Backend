                $('#mjhlActualRtp').text(gcMjhlRtpText(stats, result.exact) + ' · 已调好，尚未保存');
            } else $('#mjhlActualRtp').text(gcMjhlRtpText(stats, !!result.exact));
            $('#mjhlRtpDistribution').text(gcMjhlDistributionText(stats, !!result.exact));
            GC_MJHL_RTP_RESULT = { total:stats.total, half95:stats.half95, count:stats.count, distribution:stats.distribution, precisionReached:type === 'verify' ? !!result.precisionReached : type === 'calibrate' && !!result.success, intervalReliable:stats.intervalReliable, unobservedReturn:stats.unobservedReturn, exact:!!result.exact, normalOnly:true };
            GC_MJHL_RTP_KEY = gcMjhlRtpMathKey(gcMjhlEngineProfile());
            GC_MJHL_RTP_RESULT.mathFingerprint = gcMjhlRtpFingerprint(GC_MJHL_RTP_KEY);
            // 保存后重新载入相同快照，保留本页已完成的大样本结果；任何权重或开关变化都需重算。
            GC_MJHL_RTP_CACHE[line] = { key:GC_MJHL_RTP_KEY, stats:$.extend(true, {}, GC_MJHL_RTP_RESULT) };
        };
        worker.onerror = function () { if (!current()) return; finish(); $('#mjhlActualRtp').text('RTP 计算失败，请重试。'); };
        worker.postMessage({ type:type, profile:profile, target:profile.targetRtp, reservedScatter:{n:natural ? [0,0,0,0,0] : originalWeights.n[10], f:natural && free ? [0,0,0,0,0] : originalWeights.f[10]} });
    }
    function gcMjhlActualRtp() { gcMjhlRunRtp('verify'); }
    function gcMjhlScheduleVerify() {
        if (!GC_MJHL_AGENT) return;
        gcMjhlReadWeights(); gcMjhlWeightSummary(); gcMjhlSwitchText();
        var profile = gcMjhlEngineProfile(), key = gcMjhlRtpMathKey(profile);
        if ((GC_MJHL_RTP_WORKER && GC_MJHL_RTP_JOB === 'verify' && GC_MJHL_RTP_RUNNING_KEY === key) || GC_MJHL_RTP_PENDING_KEY === key || (GC_MJHL_RTP_KEY === key && gcMjhlRtpReusable(GC_MJHL_RTP_RESULT, profile))) return;
        gcMjhlCancelRtp(); GC_MJHL_RTP_PENDING_KEY = key;
        $('#mjhlActualRtp').text('等待计算当前权重 RTP…');
        window.__mjhlRtpTimer = window.setTimeout(gcMjhlActualRtp, 600);
    }
    function gcMjhlCommitTarget() {
        var raw = $.trim($('#mjhlTargetRtp').val()), target = Number(raw);
        if (!GC_MJHL_AGENT_CAN_EDIT || raw === '' || !isFinite(target) || target < 0 || target > 1000) return;
        var value = String(target);
        if (value === GC_MJHL_TARGET_COMMITTED) return;
        GC_MJHL_TARGET_COMMITTED = value;
        gcMjhlRunRtp('calibrate');
    }
    function gcMjhlCalibrate() {
        if (GC_MJHL_CALIBRATING) { gcMjhlCancelRtp(); $('#mjhlActualRtp').text('计算已停止，当前权重未修改。'); return; }
        if ($.trim($('#mjhlTargetRtp').val()) === '') { showToast('请填写目标 RTP。', 'warning'); return; }
        if (GC_MJHL_AGENT_CAN_EDIT) { GC_MJHL_TARGET_COMMITTED = String(Number($('#mjhlTargetRtp').val())); gcMjhlRunRtp('calibrate'); }
    }
    function gcMjhlVerify() {
        if (GC_MJHL_CALIBRATING && GC_MJHL_RTP_JOB === 'verify') { gcMjhlCancelRtp(); $('#mjhlActualRtp').text('计算已停止，手动权重未改变。'); return; }
        if (!GC_MJHL_CALIBRATING && GC_MJHL_AGENT) gcMjhlRunRtp('verify', true);
    }
    function gcMjhlFill(config, meta) {
        gcMjhlCancelRtp();
