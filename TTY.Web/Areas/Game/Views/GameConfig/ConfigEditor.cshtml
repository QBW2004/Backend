        }
        var html = '<div style="border:1px solid #e5e9f0;border-radius:6px;padding:12px 14px;margin-bottom:14px;background:#fafcff;">';
        html += '<div style="font-size:13px;font-weight:600;color:#2f6fed;margin-bottom:4px;">' + sm.title + '</div>';
        html += '<div style="font-size:12px;color:#8a94a1;margin-bottom:12px;">' + sm.desc + '</div>';
        html += '<div style="display:flex;flex-wrap:wrap;gap:10px 18px;">';
        $.each(sm.fields, function (i, f) {
            html += '<div class="gc-field" style="flex:0 0 210px;margin-bottom:8px;">' +
                '<label>' + f.lbl + (f.hint ? ' <span style="color:#c2c9d4;font-weight:400;cursor:help;" title="' + f.hint + '">ⓘ</span>' : '') + '</label>' +
                '<input type="number" class="gc-input gc-betspec" data-id="' + f.id + '" min="' + (f.min !== undefined ? f.min : 0) + '"' + (f.max !== undefined ? ' max="' + f.max + '"' : '') + ' step="' + (f.step || 1) + '" value="' + f.def + '" />' +
                '</div>';
        });
        html += '</div>';
        if (sm.doorsLabel) {
            var dm = gcGetBetDoorMeta();
            html += '<div style="margin-top:10px;font-size:12px;color:#5a6573;">' + sm.doorsLabel + '</div>';
            html += '<div style="display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:6px;">';
            $.each(dm.doors, function (i, d) {
                html += '<label style="display:flex;align-items:center;gap:4px;font-size:13px;color:#36404a;"><input type="checkbox" class="gc-betspec-door" data-idx="' + i + '" checked /> ' + d.n + '</label>';
            });
            html += '</div>';
        }
        html += '</div>';
        $box.html(html);
        gcBuildBetDoorTable();
    }

    // 渲染「押注门赔率权重配置」表（RTP 实时核算，服务端当前内置倍率仅展示预留）
    function gcBuildBetDoorTable() {
        var dm = gcGetBetDoorMeta();
        var $box = $('#gcBetDoorBox');
        $box.empty();
        if (!dm) {
            $('#gcBetDoorHint').text('');
            return;
        }
        var fixed = !!dm.fixedOdd;
        var hasMinW = dm.doors[0] && dm.doors[0].minW !== undefined;
        // 展示按倍率从低到高排序（仅调整行显示顺序；data-idx 仍为真实门索引，
        // RTP 核算与保存收集按索引取数，不破坏服务端按位置消费权重的语义）
        var sortedDoors = dm.doors.map(function (d, i) { return { d: d, i: i }; }).sort(function (a, b) {
            var ka = a.d.minOdd !== undefined ? a.d.minOdd : (a.d.odd || 0);
            var kb = b.d.minOdd !== undefined ? b.d.minOdd : (b.d.odd || 0);
            if (ka !== kb) return ka - kb;
            var ma = a.d.maxOdd !== undefined ? a.d.maxOdd : ka;
            var mb = b.d.maxOdd !== undefined ? b.d.maxOdd : kb;
            if (ma !== mb) return ma - mb;
            return a.i - b.i;
        });
        var html = '<table style="width:100%;border-collapse:collapse;margin-bottom:8px;">';
        html += '<thead><tr style="background:#f5f8ff;color:#5a6573;font-size:13px;">' +
            '<th style="padding:8px;border:1px solid #e5e9f0;text-align:left;">押注门</th>' +
            (fixed
                ? '<th style="padding:8px;border:1px solid #e5e9f0;">固定倍率</th>'
                : '<th style="padding:8px;border:1px solid #e5e9f0;">最小赔率</th><th style="padding:8px;border:1px solid #e5e9f0;">最大赔率</th>') +
            (hasMinW
                ? '<th style="padding:8px;border:1px solid #e5e9f0;">权重最小(万)</th><th style="padding:8px;border:1px solid #e5e9f0;">权重最大(万)</th>'
                : '<th style="padding:8px;border:1px solid #e5e9f0;">权重(万分)</th>') +
            '<th style="padding:8px;border:1px solid #e5e9f0;">单门RTP(%)</th></tr></thead><tbody>';
        $.each(sortedDoors, function (_, s) {
            var i = s.i, d = s.d;
            html += '<tr>' +
                '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#36404a;">' + d.n + '</td>';
            // 赔率（min/max/固定）只读展示：服务端当前使用内置倍率，仅作 RTP 核算参考，不可调整
            var roStyle = 'readonly style="background:#f7f9fc;color:#8a94a1;"';
            if (fixed) {
                html += '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-odd" data-idx="' + i + '" min="0" step="0.1" value="' + d.odd + '" ' + roStyle + ' /></td>';
            } else {
                html += '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-minodd" data-idx="' + i + '" min="0" step="0.1" value="' + d.minOdd + '" ' + roStyle + ' /></td>' +
                    '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-maxodd" data-idx="' + i + '" min="0" step="0.1" value="' + d.maxOdd + '" ' + roStyle + ' /></td>';
            }
            if (hasMinW) {
                html += '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-minw" data-idx="' + i + '" min="0" step="1" value="' + d.minW + '" /></td>' +
                    '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-maxw" data-idx="' + i + '" min="0" step="1" value="' + d.maxW + '" /></td>';
            } else {
                html += '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-w" data-idx="' + i + '" min="0" step="1" value="' + d.w + '" /></td>';
            }
            html += '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:12px;color:#009944;text-align:center;" class="gc-betdoor-rtp" data-idx="' + i + '">-</td></tr>';
        });
        html += '<tr style="background:#d6eaf8;font-weight:600;">' +
            '<td style="padding:6px 8px;border:1px solid #e5e9f0;">全局合计</td>' +
            (fixed ? '<td style="padding:6px 8px;border:1px solid #e5e9f0;">-</td>' : '<td style="padding:6px 8px;border:1px solid #e5e9f0;">-</td><td style="padding:6px 8px;border:1px solid #e5e9f0;">-</td>') +
            (hasMinW
                ? '<td style="padding:6px 8px;border:1px solid #e5e9f0;" id="gcBetDoorSumMinW">-</td><td style="padding:6px 8px;border:1px solid #e5e9f0;" id="gcBetDoorSumMaxW">-</td>'
                : '<td style="padding:6px 8px;border:1px solid #e5e9f0;" id="gcBetDoorSumW">-</td>') +
            '<td style="padding:6px 8px;border:1px solid #e5e9f0;" id="gcBetDoorRtp">-</td></tr>';
        html += '</tbody></table>';
        $box.html(html);
        $box.find('.gc-betdoor').on('input', gcUpdateBetDoorRtp);
        gcUpdateBetDoorRtp();
        $('#gcBetDoorHint').text('赔率（倍率）为只读展示，来自服务端内置规则；出现机会用于估算各下注门的相对比例。保存后会热更新可配置部分，全部填 0 时回退服务端默认机会。');
    }

    // RTP 实时核算（算法与参考 HTML 一致：单门RTP=权重/10000×赔率×100，全局=各门合计+特殊奖励贡献）
    function gcUpdateBetDoorRtp() {
        var sm = gcGetBetSpecMeta();
        var dm = gcGetBetDoorMeta();
        if (!sm || !dm) return;
        var spec = {};
        $.each(sm.fields, function (i, f) {
            spec[f.id] = parseFloat($('.gc-betspec[data-id="' + f.id + '"]').val()) || 0;
        });
        var fixed = !!dm.fixedOdd;
        var hasMinW = dm.doors[0] && dm.doors[0].minW !== undefined;
        var sumW = 0, sumMinW = 0, sumMaxW = 0, rtpMin = 0, rtpMax = 0;
        $.each(dm.doors, function (i, d) {
            var oMin, oMax, w, wMin, wMax, r1, r2, $rtp = $('.gc-betdoor-rtp[data-idx="' + i + '"]');
            if (fixed) {
                oMin = oMax = parseFloat($('.gc-betdoor-odd[data-idx="' + i + '"]').val()) || 0;
                w = parseFloat($('.gc-betdoor-w[data-idx="' + i + '"]').val()) || 0;
                sumW += w;
                r1 = (w / 10000) * oMin * 100;
                $rtp.text(r1.toFixed(2));
                rtpMin += r1; rtpMax += r1;
                return;
            }
            oMin = parseFloat($('.gc-betdoor-minodd[data-idx="' + i + '"]').val()) || 0;
            oMax = parseFloat($('.gc-betdoor-maxodd[data-idx="' + i + '"]').val()) || 0;
            if (hasMinW) {
                wMin = parseFloat($('.gc-betdoor-minw[data-idx="' + i + '"]').val()) || 0;
                wMax = parseFloat($('.gc-betdoor-maxw[data-idx="' + i + '"]').val()) || 0;
                sumMinW += wMin; sumMaxW += wMax;
                r1 = (wMin / 10000) * oMin * 100;
                r2 = (wMax / 10000) * oMax * 100;
                $rtp.text(r1.toFixed(2) + '~' + r2.toFixed(2));
            } else {
                w = parseFloat($('.gc-betdoor-w[data-idx="' + i + '"]').val()) || 0;
                sumW += w;
                r1 = (w / 10000) * oMin * 100;
                r2 = (w / 10000) * oMax * 100;
                $rtp.text(r1.toFixed(2) + '~' + r2.toFixed(2));
            }
            rtpMin += r1; rtpMax += r2;
        });
        // 特殊奖励对全局 RTP 的贡献（移植参考 HTML：皇冠/钻石、四大奖励、彩金派送）
        var specRtp = 0;
        var gid = parseInt($('#gcGameId').val(), 10);
        if (gid === 47 || gid === 29) {
            var lampAvg = ((spec.goldLampMin || 1) + (spec.goldLampMax || 1)) / 2;
            var silAvg = ((spec.silverRateMin || 1) + (spec.silverRateMax || 1)) / 2;
            specRtp = (spec.goldW / 10000) * lampAvg * 100 + (spec.silverW / 10000) * silAvg * 100;
        } else if (gid === 10) {
            specRtp = (spec.dsyW / 10000) * (spec.dsyBonus || 0) * 100 +
                (spec.dsxW / 10000) * (spec.dsxBonus || 0) * 100 +
                (spec.pldW / 10000) * (spec.pldRate || 0) * 100 +
                (spec.xysdW / 10000) * 30 * 100;
        } else if (gid === 2) {
            specRtp = (spec.jpW / 10000) * 52 * 100;
        }
        var totalMin = rtpMin + specRtp;
        var totalMax = rtpMax + specRtp;
        if (hasMinW) {
            $('#gcBetDoorSumMinW').text(sumMinW.toFixed(2));
            $('#gcBetDoorSumMaxW').text(sumMaxW.toFixed(2));
            $('#gcBetDoorSumMinW').css('color', sumMinW > 10000 ? '#d33b3b' : '');
            $('#gcBetDoorSumMaxW').css('color', sumMaxW > 10000 ? '#d33b3b' : '');
        } else {
            $('#gcBetDoorSumW').text(sumW.toFixed(2));
            $('#gcBetDoorSumW').css('color', sumW > 10000 ? '#d33b3b' : '');
        }
        $('#gcBetDoorRtp').text(totalMin.toFixed(2) + ' ~ ' + totalMax.toFixed(2) + '（含特殊奖励 ' + specRtp.toFixed(2) + '）');
    }

    // 收集页面配置为 JSON（spec + doors），写入隐藏域随表单提交
    function gcCollectBetSpec() {
        var sm = gcGetBetSpecMeta();
        var dm = gcGetBetDoorMeta();
        if (!sm || !dm) {
            $('#gcBetGameCfg').val('');
            return;
        }
        var cfg = { ver: 1, spec: {}, doors: [] };
        $.each(sm.fields, function (i, f) {
            var v = parseFloat($('.gc-betspec[data-id="' + f.id + '"]').val()) || 0;
            cfg.spec[f.id] = f.x100 ? Math.round(v * 100) : v;
        });
        if (sm.doorsLabel) {
            var arr = [];
            $.each(dm.doors, function (i, d) {
                arr.push($('.gc-betspec-door[data-idx="' + i + '"]').is(':checked') ? 1 : 0);
            });
            cfg.spec.goldDoors = arr;
        }
        $.each(dm.doors, function (i, d) {
            var row = {};
            if (dm.fixedOdd) {
                row.odd = parseFloat($('.gc-betdoor-odd[data-idx="' + i + '"]').val()) || 0;
                row.weight = parseFloat($('.gc-betdoor-w[data-idx="' + i + '"]').val()) || 0;
            } else if (d.minW !== undefined) {
                row.minOdd = parseFloat($('.gc-betdoor-minodd[data-idx="' + i + '"]').val()) || 0;
                row.maxOdd = parseFloat($('.gc-betdoor-maxodd[data-idx="' + i + '"]').val()) || 0;
                row.minW = parseFloat($('.gc-betdoor-minw[data-idx="' + i + '"]').val()) || 0;
                row.maxW = parseFloat($('.gc-betdoor-maxw[data-idx="' + i + '"]').val()) || 0;
            } else {
                row.minOdd = parseFloat($('.gc-betdoor-minodd[data-idx="' + i + '"]').val()) || 0;
                row.maxOdd = parseFloat($('.gc-betdoor-maxodd[data-idx="' + i + '"]').val()) || 0;
                row.weight = parseFloat($('.gc-betdoor-w[data-idx="' + i + '"]').val()) || 0;
            }
            cfg.doors.push(row);
        });
        $('#gcBetGameCfg').val(JSON.stringify(cfg));
    }

    function gcFillBetSpec(t) {
        gcBuildBetSpec();
        var sm = gcGetBetSpecMeta();
        if (!sm) return;
        var cfg = t.betGameCfg;
        if (typeof cfg === 'string' && cfg) {
            try { cfg = JSON.parse(cfg); } catch (e) { cfg = null; }
        }
        if (!cfg || typeof cfg !== 'object') cfg = {};
        var spec = cfg.spec || {};
        $.each(sm.fields, function (i, f) {
            var v = spec[f.id];
            if (v !== undefined && v !== null) $('.gc-betspec[data-id="' + f.id + '"]').val(f.x100 ? v / 100 : v);
        });
        if (sm.doorsLabel && spec.goldDoors) {
            $.each(spec.goldDoors, function (i, v) {
                $('.gc-betspec-door[data-idx="' + i + '"]').prop('checked', v == 1);
            });
        }
        var dm = gcGetBetDoorMeta();
        var doors = cfg.doors;
        if (dm && doors && doors.length > 0) {
            $.each(doors, function (i, d) {
                if (i >= dm.doors.length || !d) return;
                // 只回填可编辑权重（weight/minW/maxW）；最小/最大赔率为只读展示列，
                // 恒显服务端内置区间（GC_BET_DOOR_META），不被库内旧 doors 残留值覆盖
                if (dm.fixedOdd) {
                    if (d.weight !== undefined) $('.gc-betdoor-w[data-idx="' + i + '"]').val(d.weight);
                } else if (dm.doors[i].minW !== undefined) {
                    if (d.minW !== undefined) $('.gc-betdoor-minw[data-idx="' + i + '"]').val(d.minW);
                    if (d.maxW !== undefined) $('.gc-betdoor-maxw[data-idx="' + i + '"]').val(d.maxW);
                } else {
                    if (d.weight !== undefined) $('.gc-betdoor-w[data-idx="' + i + '"]').val(d.weight);
                }
            });
        }
        gcUpdateBetDoorRtp();
    }

    // 牌型行：ht=服务端 te_CardsType 枚举索引(0..12)，name=各服务端注释里的规范名，
    // p=未配置时的默认出现率(万分比)建议值；倍率由下方客户端固定表只读展示。
    var GC_PAYOUT_ROWS = [
        { ht: 0, name: '杂牌', p: 6000 },
        { ht: 1, name: '对子', p: 2000 },
        { ht: 2, name: '两对', p: 1000 },
        { ht: 3, name: '三条', p: 500 },
        { ht: 4, name: '杂顺', p: 400 },
        { ht: 5, name: '同花', p: 60 },
        { ht: 6, name: '葫芦', p: 20 },
        { ht: 7, name: '小四梅', p: 10 },
        { ht: 8, name: '大四梅', p: 3 },
        { ht: 9, name: '同花顺', p: 5 },
        { ht: 10, name: '五梅', p: 2 },
        { ht: 11, name: '同花大顺', p: 4 },
        { ht: 12, name: '五鬼', p: 1 }
    ];

    // 各游戏客户端 Blueeboard.cs 写死倍率，按牌型索引 0..12。
    // 服务端结算表与此处保持一致；后台只读展示，禁止被数据库旧值覆盖。
    var GC_MAG_TAB = {
        phenix: [0, 1, 2, 3, 5, 7, 10, 40, 80, 120, 250, 500, 1000],
        king3:  [0, 1, 2, 3, 5, 7, 10, 60, 60, 120, 250, 500, 1000],
        dazhi:  [0, 1, 2, 3, 5, 7, 15, 65, 65, 150, 350, 250, 350],
        nba:    [0, 1, 2, 3, 5, 7, 10, 50, 50, 100, 400, 200, 1000],
        dscj: {
            small:  [0, 1, 2, 3, 4, 6, 8, 40, 40, 100, 300, 150, 1000],
            middle: [0, 1, 2, 3, 5, 7, 10, 50, 50, 120, 400, 200, 1000],
            big:    [0, 1, 2, 3, 6, 8, 12, 60, 60, 140, 500, 250, 1000]
        }
    };

    // 机台“有效出牌率”交付系数（按牌型索引 0..12，ht0 杂牌不用）。
    // 扑克保留换牌机制下，客户端自动保留 × 服务端二手生成存在结构性交付损耗：
    // 抽中的牌型不一定能真正开出（全保留按一手结算 / 鬼牌数不符 / dis_flag 随机补牌）。
    // 系数 = 实测开出率 / 配置出现率，由服务端真实算法 + 客户端自动保留策略模拟 200 万局得出：
    //   phenix/king3/dazhi/nba = 实测；dscj = 按 phenix 近似（点石成金 客户端保留策略未在本仓库）。
    //   nba 已于 2026-08 修复三条换牌死循环 bug + srand(1) 后重新实测校准。
    // 后台“实际预计RTP” = Σ(出现率/10000 × 倍数 × 交付系数)；理论RTP = Σ(出现率/10000 × 倍数)。
    var GC_DELIVERY_FACTOR = {
        phenix: [0, 1.30, 0.84, 0.83, 0.73, 0.65, 0.57, 0.64, 0.58, 0.55, 0.38, 0.43, 0.00],
        king3:  [0, 1.31, 0.82, 0.84, 0.75, 0.62, 0.51, 0.64, 0.66, 0.57, 0.93, 0.48, 0.00],
        dazhi:  [0, 1.28, 0.84, 0.83, 0.74, 0.54, 0.53, 0.63, 0.55, 0.17, 1.15, 0.19, 0.00],
        nba:    [0, 1.259, 1.156, 0.857, 0.742, 0.607, 0.573, 0.643, 0.708, 0.330, 0.805, 0.185, 0.000],
        dscj:   [0, 1.30, 0.84, 0.83, 0.73, 0.65, 0.57, 0.64, 0.58, 0.55, 0.38, 0.43, 0.00]
    };

    function gcGetMagKey() {
        var name = ($('#gcGameSel').find('option:selected').text() || '');
        if (/nba/i.test(name)) return 'nba';
        if (/dianshichengjin|dscj|点石成金|att|连环炮/i.test(name)) return 'dscj';
        if (/皇冠|king/i.test(name)) return 'king3';
        if (/大字|dazhi/i.test(name)) return 'dazhi';
        return 'phenix';
    }

    function gcGetMagSpec(ht) {
        var key = gcGetMagKey();
        if (key === 'dscj') {
            var small = GC_MAG_TAB.dscj.small[ht] || 0;
            var middle = GC_MAG_TAB.dscj.middle[ht] || 0;
            var big = GC_MAG_TAB.dscj.big[ht] || 0;
            var attText = small + ' / ' + middle + ' / ' + big;
            if (ht === 12) attText += '（客户端未展示）';
            return { text: attText, rtp: small * 0.60 + middle * 0.25 + big * 0.15 };
        }

        var value = GC_MAG_TAB[key][ht] || 0;
        if (key === 'phenix' && ht === 7) {
            return { text: '40 / 50（机台档位）', rtp: 40 };
        }
        if ((key === 'nba' || key === 'dazhi') && ht === 12) {
            return { text: value + '（客户端未展示）', rtp: value };
        }
        return { text: value.toString(), rtp: value };
    }

    function gcGetMagRtpNote() {
        var key = gcGetMagKey();
        if (key === 'dscj' && gcIsAttMhb()) return 'ATT满花版 倍数同 点石成金，按服务端 60% / 25% / 15% 抽档加权（满花 ×2/×3 与彩金未计入）';
        if (key === 'dscj') return '点石成金 倍数按服务端 60% / 25% / 15% 抽档加权';
        if (key === 'phenix') return '火凤凰小四梅按 40 档估算，实际结算由机台 40 / 50 档位决定';
        return '倍数取客户端固定值';
    }

    function gcBuildPayoutTable() {
        var $tb = $('#gcPayoutTable tbody');
        var dazhiNoBars = gcGetMagKey() === 'dazhi'; // 大字板五鬼已下线: 机台设定不显示五鬼行
        $tb.empty();
        $.each(GC_PAYOUT_ROWS, function (i, r) {
            if (dazhiNoBars && r.ht === 12) return; // 大字板五鬼已下线
            var mag = gcGetMagSpec(r.ht);
            // 杂牌(ht=0)为余量行，始终启用不可勾选；其余牌型逐行启用(he{ht}，隐藏域保证序列化)
            var enCell = r.ht === 0
                ? '<td style="padding:4px;border:1px solid #e5e9f0;text-align:center;color:#9aa4b1;font-size:12px;">—</td>'
                : '<td style="padding:4px;border:1px solid #e5e9f0;text-align:center;">' +
                  '<input type="checkbox" id="gcHeChk' + r.ht + '" class="gc-payout-e" data-ht="' + r.ht + '" checked />' +
                  '<input type="hidden" name="he' + r.ht + '" id="gcHe' + r.ht + '" value="1" /></td>';
            $tb.append('<tr>' +
                '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#36404a;">' + r.name + '</td>' +
                '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" name="hp' + r.ht + '" id="gcHp' + r.ht + '" class="gc-input gc-payout-p" min="0" max="10000" step="1" value="' + r.p + '" /></td>' +
                '<td style="padding:6px 8px;border:1px solid #e5e9f0;background:#f7f9fc;color:#5a6573;text-align:center;">' +
                    '<span id="gcHm' + r.ht + '" data-rtp-m="' + mag.rtp + '" title="客户端 Blueeboard.cs 写死，后台不可修改">' + mag.text + '</span></td>' +
                enCell +
                '</tr>');
        });
        $tb.find('.gc-payout-p').on('input', gcUpdatePayoutSum);
        $tb.find('.gc-payout-e').on('change', function () {
            var ht = $(this).attr('data-ht');
            var on = $(this).is(':checked');
            $('#gcHe' + ht).val(on ? 1 : 0);
            $('#gcHp' + ht + ',#gcHm' + ht).css('opacity', on ? 1 : 0.45);
            gcUpdatePayoutSum();
        });
        gcUpdatePayoutSum();
    }

    function gcUpdatePayoutSum() {
        var winSum = 0;
        var rtp = 0;      // 理论返奖率：Σ(出现率×倍数)
        var rtpReal = 0;  // 机台实际预计返奖率：Σ(出现率×倍数×交付系数)
        var key = gcGetMagKey();
        var effTab = GC_DELIVERY_FACTOR[key] || GC_DELIVERY_FACTOR.phenix;
        $.each(GC_PAYOUT_ROWS, function (i, r) {
            if (r.ht !== 0 && !$('#gcHeChk' + r.ht).is(':checked')) return; // 停用行不计入
            var p = parseFloat($('#gcHp' + r.ht).val()) || 0;
            var m = parseFloat($('#gcHm' + r.ht).attr('data-rtp-m')) || 0;
            if (r.ht !== 0) winSum += p;
            rtp += p / 10000 * m;
            rtpReal += p / 10000 * m * (effTab[r.ht] !== undefined ? effTab[r.ht] : 1);
        });
        // ATT满花版金拇指：杂牌局(余量)按万分比触发，五档倍数等概率，期望 GC_GOLD_FINGER_AVG_MAG 倍
        var gfRtp = 0;
        if (gcIsAttMhb() && $('#gcGfOn').is(':checked')) {
            var gfP = parseFloat($('#gcGf').val()) || 0;
            gfRtp = Math.max(0, 10000 - winSum) / 10000 * gfP / 10000 * GC_GOLD_FINGER_AVG_MAG;
            rtp += gfRtp;
            rtpReal += gfRtp;
        }
        var gfTag = gfRtp > 0 ? '；以上含金拇指 ≈ ' + (gfRtp * 100).toFixed(2) + '%' : '';
        var $el = $('#gcPayoutSum');
        var estTag = (key === 'dscj') ? '（dscj 按 phenix 近似，待实测校准）' : '';
        var color = rtpReal >= 100 ? '#d33b3b' : (rtpReal > 98 ? '#c98f2b' : '#9aa4b1');
        $el.text('中奖牌型出现率合计（仅启用行）：' + winSum + ' / 10000（余量自动落入杂牌）；' +
            gcGetMagRtpNote() + '，理论返奖率 RTP ≈ ' + (rtp * 100).toFixed(2) + '%' +
            '，机台实际预计 RTP ≈ ' + (rtpReal * 100).toFixed(2) + '%' + estTag + gfTag);
        $el.css('color', winSum > 10000 ? '#d33b3b' : color);
        if (winSum > 10000) {
            $el.css('color', '#d33b3b');
        }
    }

    function gcFillPayout(t) {
        // 每次切换牌机都重建，确保只读倍率来自当前游戏的客户端固定表，而非上一个游戏或数据库旧值。
        gcBuildPayoutTable();
        $('#gcPayoutOn').prop('checked', t.payoutOn == 1);
        var po = t.payout || {};
        $.each(GC_PAYOUT_ROWS, function (i, r) {
            $('#gcHp' + r.ht).val(po['p' + r.ht] !== undefined ? po['p' + r.ht] : r.p);
            if (r.ht !== 0) {
                // 已保存档：总开关开启时 Enabled=0 才是逐行停用；无存档/总关时默认启用
                var on = !(t.payoutOn == 1 && po['e' + r.ht] !== undefined && po['e' + r.ht] == 0);
                $('#gcHeChk' + r.ht).prop('checked', on);
                $('#gcHe' + r.ht).val(on ? 1 : 0);
                $('#gcHp' + r.ht + ',#gcHm' + r.ht).css('opacity', on ? 1 : 0.45);
            }
        });
        // 鬼牌三段概率回显
        $('#gcJokerOn').prop('checked', t.jokerOn == 1);
        $('#gcJk1').val(t.jk1 || 0);
        $('#gcJk2').val(t.jk2 || 0);
        $('#gcJk3').val(t.jk3 || 0);
        gcSyncJoker();
        // 金拇指回显(仅 ATT满花版)
        $('#gcGfOn').prop('checked', t.goldFingerOn == 1);
        $('#gcGf').val(t.goldFinger || 0);
        // 彩金出货权重回显(仅 ATT满花版)
        $('#gcDpOn').prop('checked', t.diamondFlushOn == 1);
        $('#gcDp').val(t.diamondFlush || 0);
        $('#gcArOn').prop('checked', t.allRoyalOn == 1);
        $('#gcAr').val(t.allRoyal || 0);
        gcSyncGoldFinger();
        gcUpdatePayoutSum();
        gcUpdateJpBox(t);
    }

    function gcSyncJoker() {
        $('#gcJokerOnVal').val($('#gcJokerOn').is(':checked') ? 1 : 0);
        var s = 0;
        for (var j = 1; j <= 3; j++) s += parseFloat($('#gcJk' + j).val()) || 0;
        var $el = $('#gcJokerSum');
        $el.text('1/2/3 王概率合计：' + s + ' / 10000（余量为无鬼）；硬约束不变：两对无鬼、五鬼固定 5 鬼、正宗大四梅无鬼、各牌型鬼数上下限自动限幅。');
        $el.css('color', s > 10000 ? '#d33b3b' : '#9aa4b1');
    }

    // ATT满花版(gameId=25)：金拇指与方块彩金/满花彩金为该游戏独有；金拇指五档 ×20/×50/×100/×200/×400 平均 154 倍
    var GC_GOLD_FINGER_AVG_MAG = 154;
    function gcIsAttMhb() {
        return parseInt($('#gcGameSel').val(), 10) === 25;
    }

    // 金拇指区：仅 ATT满花版牌机显示；不显示时禁用输入，避免 serializeObject 带出无关字段
    function gcSyncGoldFinger() {
        var show = gcGetType() === 1 && gcIsAttMhb();
        $('#gcGfBox').toggle(show);
        $('#gcGfBox input').prop('disabled', !show);
        $('#gcGfOnVal').val($('#gcGfOn').is(':checked') ? 1 : 0);
        $('#gcDpOnVal').val($('#gcDpOn').is(':checked') ? 1 : 0);
        $('#gcArOnVal').val($('#gcArOn').is(':checked') ? 1 : 0);
        var p = parseFloat($('#gcGf').val()) || 0;
        var $el = $('#gcGfSum');
        $el.text('杂牌局触发金拇指机会：' + p + ' / 10000（停用或填 0 = 不触发；控牌/点杀/吃分局不触发）；玩家五选一翻牌，五个位置随机分配 ×20/×50/×100/×200/×400，奖励 = 押分 × 所翻倍数（平均 ×' + GC_GOLD_FINGER_AVG_MAG + '）。');
        $el.css('color', p > 10000 ? '#d33b3b' : '#9aa4b1');
        var dp = parseFloat($('#gcDp').val()) || 0;
        var ar = parseFloat($('#gcAr').val()) || 0;
        var $pw = $('#gcPoolWSum');
        $pw.text('彩金出货权重（条件局内升级命中，不改牌型概率结构）：方块彩金 ' + dp + ' / 10000 —— 同花/同花顺/同花大顺且无鬼的局按此权重染成方块；满花彩金 ' + ar + ' / 10000 —— 两对/三条/葫芦/大四梅且无鬼的局按此权重改写成正宗满花（赔付 ×3 并领满花池）。停用或填 0 = 只自然出货；控牌/黑名单局不触发。');
        $pw.css('color', (dp > 10000 || ar > 10000) ? '#d33b3b' : '#9aa4b1');
    }

    // 彩金奖池：仅 点石成金/NBA（按游戏名匹配），上半段为程序固定规则只读展示，下半段为本机台四池分数（可设置）。
    // t 为当前选中桌台行数据（gcFillPayout 传入）；gcApplyType 无参调用时仅刷新规则并清空数值输入。
    function gcUpdateJpBox(t) {
        var name = ($('#gcGameSel').find('option:selected').text() || '');
        var isNba = /nba/i.test(name);
        var isAtt = /dianshichengjin|dscj|点石成金|att|连环炮/i.test(name);
        var isMhb = gcIsAttMhb();
        if (gcGetType() !== 1 || (!isNba && !isAtt)) {
            $('#gcJpBox').hide();
            return;
        }
        var rows;
        if (isAtt) {
            $('#gcJpRule').html('点石成金 规则（服务端常量）：桦台累计押分每满 <b>3000</b> 分，4 个独立池各 +1 分；领取额 = 奖池 ×（本局押分 ÷ 1000），押分 ≥1000 领取 100%；领奖后奖池降至保底。');
            $('.gc-jp-nba').hide();
            rows = [
                ['五梅 5.K.', 5000, 200000, null],
                ['同花大顺 R.S.', 2000, 100000, null],
                ['同花顺 S.F.', 500, 20000, null],
                ['四梅 4.K.', 200, 5000, null]
            ];
            if (isMhb) {
                $('#gcJpRule').html('ATT满花版 规则（服务端常量）：本机台累计押分每满 <b>3000</b> 分，6 个独立池各 +1 分；领取额 = 奖池 ×（本局押分 ÷ 1000），押分 ≥1000 领取 100%；领奖后奖池降至保底。方块彩金：五张全方块且无鬼的同花 / 同花顺 / 同花大顺；满花彩金：正宗满花（五张全 J/Q/K、无鬼）。满花另把牌型赔付 ×2（含鬼）/ ×3（正宗）。');
                rows.push(['方块彩金（无鬼全方块同花 / 同花顺 / 同花大顺）', 300, 10000, null]);
                rows.push(['满花彩金（正宗满花）', 2000, 100000, null]);
            }
        } else {
            $('#gcJpRule').html('NBA 规则（服务端常量，与 点石成金 不同）：每局按轮次轮流累计 4K→SF→RS→5K 各 +1 分（非押分节奏）；领取额 = 奖池 ×（本局押分 ÷ 80），押分 ≥80 领取 100%；中奖局含 3 张鬼牌时另按固定倍数加奖；领奖后奖池降至保底。');
            $('.gc-jp-nba').show();
            rows = [
                ['五梅 5.K.', 5000, '—（轮次累计无上限控制）', '押分 ×160'],
                ['同花大顺 R.S.', 2000, '—（轮次累计无上限控制）', '押分 ×80'],
                ['同花顺 S.F.', 500, '—（轮次累计无上限控制）', '押分 ×40'],
                ['四梅 4.K.', 200, '—（轮次累计无上限控制）', '押分 ×20']
            ];
        }
        var $tb = $('#gcJpTable tbody');
        $tb.empty();
        $.each(rows, function (i, r) {
            var html = '<tr>' +
                '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#36404a;">' + r[0] + '</td>' +
                '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="text" class="gc-input" value="' + r[1] + '" disabled /></td>' +
                '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="text" class="gc-input" value="' + r[2] + '" disabled /></td>';
            if (r[3] !== null) html += '<td style="padding:4px;border:1px solid #e5e9f0;" class="gc-jp-nba"><input type="text" class="gc-input" value="' + r[3] + '" disabled /></td>';
            html += '</tr>';
            $tb.append(html);
        });
        // 本机台奖池分回填：优先显示已下发待生效值(jpSet*)，其次游戏服导出的当前值(jp*)；
        // 原值记入 jpOrig，保存时未改动则不带 JP_* 字段（避免无关保存把运行中的奖池钉死在重启后）。
        // ATT满花版多两池(方块/满花)：JP_DIA/JP_AR 仅该游戏显示，未提交时服务端不覆盖该池。
        var jpCur = t ? [t.jp5K, t.jpRS, t.jpSF, t.jp4K, t.jpDia, t.jpAR] : [null, null, null, null, null, null];
        var jpSet = t ? [t.jpSet5K, t.jpSetRS, t.jpSetSF, t.jpSet4K, t.jpSetDia, t.jpSetAR] : [null, null, null, null, null, null];
        var jpUse = (jpSet[0] != null) ? jpSet : jpCur;
        var jpIds = ['#gcJp5K', '#gcJpRS', '#gcJpSF', '#gcJp4K', '#gcJpDIA', '#gcJpAR'];
        var jpOrig = [];
        for (var ji = 0; ji < 6; ji++) {
            var jv = (ji >= 4 && !isMhb) ? '' : (jpUse[ji] != null ? jpUse[ji] : '');
            $(jpIds[ji]).val(jv);
            jpOrig.push(jv);
        }
        $('#gcJpBox').data('jpOrig', jpOrig.join(','));
        $('#gcJpMhbRow').toggle(isMhb);
        var jpInfo = [];
        var jpShow = function (arr) { return (isMhb ? arr : arr.slice(0, 4)).map(function (v) { return v == null ? '-' : v; }).join(' / '); };
        jpInfo.push(jpCur[0] != null ? '当前 ' + jpShow(jpCur) : '当前值暂无（待游戏服导出快照）');
        if (t && t.jpStateTime) jpInfo[0] += '（快照 ' + t.jpStateTime + '）';
        if (jpSet[0] != null) jpInfo.push('待生效 ' + jpShow(jpSet));
        jpInfo.push(isMhb
            ? '六个独立奖池：五梅/同花大顺/同花顺/四梅/方块彩金/满花彩金；改后保存，游戏服重启时一次性应用'
            : '四个独立奖池：五梅/同花大顺/同花顺/四梅；改后保存，游戏服重启时一次性应用');
        $('#gcJpInfo').text(jpInfo.join('；'));
        $('#gcJpBox').show();
    }

    function gcSave() {
        var type = gcGetType();
        if (type != 0 && type != 1 && type != 2 && type != 3) {
            showToast('请先选择游戏类型与对应游戏的桌台！', 'warning');
            return;
        }
        if (parseInt($('#gcGameId').val(), 10) < 0) {
            showToast('请先选择需要配置的游戏！', 'warning');
            return;
        }
        var minBet = parseFloat($('#gcMinBet').val());
        var maxBet = parseFloat($('#gcMaxBet').val());
        if (isNaN(minBet) || isNaN(maxBet) || minBet < 0 || maxBet < 0) {
            showToast('下注值必须为不小于 0 的数字！', 'warning');
            return;
        }
        if (maxBet > 0 && minBet > maxBet) {
            showToast('最小值不能大于最大值！', 'warning');
            return;
        }
        // 三个拉霸（明星97/水果机/水浒传）最小/最大押分只能为整数
        if (gcLabaSubType() > 0 && (Math.floor(minBet) !== minBet || Math.floor(maxBet) !== maxBet)) {
            showToast('拉霸最小/最大押分只能设置整数！', 'warning');
            return;
        }
        if (type === 1 || type === 2 || type === 3) { // gcCardStepInvalid
            var gcSs = parseFloat($('#gcScoreSwitch').val());
            var gcSsBad = (type === 2) ? (isNaN(gcSs) || gcSs < 0.1) : (isNaN(gcSs) || gcSs < 1 || Math.floor(gcSs) !== gcSs);
            if (gcSsBad) {
                showToast((type === 2) ? '加芬幅度必须大于 0，鱼机最小 0.1!' : '加芬幅度必须为大于等于 1 的整数!', 'warning');
                return;
            }
        }
        gcSyncSwitch();
        gcCollectChips();
        if (gcGetType() === 0) gcCollectBetSpec();
        // 庄家抽水：页面以百分比显示，落库前换算为千分比（×10，服务端按 /1000 计算）
        if (gcGetType() === 0) {
            var bpDisp = parseFloat($('#gcBankerPer').val());
            if (isNaN(bpDisp) || bpDisp < 0) {
                showToast('庄家抽水比例不能为负数！', 'warning');
                return;
            }
            if (bpDisp > 9.9) {
                showToast('庄家抽水比例最大 9.9%（库内千分比 99）！', 'warning');
                return;
            }
            $('#gcBankerPerRaw').val(Math.round(bpDisp * 10));
        }
        var savedId = parseInt($('#gcId').val(), 10);
        var wasNew = isNaN(savedId) || savedId < 0;
        var para = $('#gcForm').serializeObject();
        // 彩金奖池：区块不可见、四个值与回填一致(未改动)、或全部留空时不带 JP_* 字段，
        // 后端跳过奖池登记；部分留空保留字段交后端校验报错。
        var jpNow = [$('#gcJp5K').val(), $('#gcJpRS').val(), $('#gcJpSF').val(), $('#gcJp4K').val(), $('#gcJpDIA').val(), $('#gcJpAR').val()].join(',');
        if (!$('#gcJpBox').is(':visible') || jpNow === ',,,,,' || jpNow === $('#gcJpBox').data('jpOrig')) {
            delete para.JP_5K; delete para.JP_RS; delete para.JP_SF; delete para.JP_4K; delete para.JP_DIA; delete para.JP_AR;
        } else if (!gcIsAttMhb()) {
            delete para.JP_DIA; delete para.JP_AR;
        }
        para.__RequestVerificationToken = $('#gcForm [name="__RequestVerificationToken"]').val();
        request(GC_URL.save, para, function (data) {
            gcMsg(data);
            if (data && (data.code == 1 || data.datas === true)) {
                gcLoadTables(function () {
                    if (wasNew) gcNewTable();
                    else gcSelectTableById(savedId);
                });
            }
        });
    }

    function gcDelete() {
        var savedId = parseInt($('#gcId').val(), 10);
        if (isNaN(savedId) || savedId < 0) {
            showToast('请先在左侧选择要删除的桌台！', 'warning');
            return;
        }
        confirm('确定要彻底删除该桌台吗？\n此操作将从数据库永久清除，不可恢复！', function () {
            var para = {
                ID: savedId,
                GAME_TYPE: gcGetType(),
                __RequestVerificationToken: $('#gcForm [name="__RequestVerificationToken"]').val()
            };
            request(GC_URL.delete, para, function (data) {
                var ok = data && (data.code == 1 || data.datas === true);
                if (ok) {
                    // 先本地移除已删除桌台并立即重渲染，保证 UI 即时响应，且不被任何提示异常阻断；
                    GC_TABLES = $.grep(GC_TABLES, function (t) { return parseInt(t.id, 10) !== savedId; });
                    gcRenderTableList();
                    // 再向服务端拉取最新列表做一次权威校正同步。
                    gcLoadTables();
                }
                gcMsg(data);
            });
        });
    }

    $(function () {
        pluginInit();
        gcLoadGames();
        gcSetParaVisible(false);
        $('#gcTypeSel').on('change', gcFillGameSel);
        $('#gcGameSel').on('change', function () { gcLoadTables(); });
        $('#gcRefresh').on('click', function () { gcLoadTables(); });
        $('#gcDelete').on('click', gcDelete);
        $('#gcReset').on('click', function () {
            // 恢复默认会把当前表单所有参数改为出厂默认（保存后即覆盖当前桌台配置），二次确认防止误触
            var isEditing = parseInt($('#gcId').val(), 10) >= 0;
            confirm(isEditing
                ? '确定将该桌台基础参数恢复为默认值吗？\n点击确认后表单将回填默认值，保存即覆盖当前桌台的基础参数；中奖权重保持不变。'
                : '确定将表单恢复为默认值吗？', function () { gcResetForm(); });
        });
        $('#gcSave').on('click', gcSave);
        $('#gcNewTable').on('click', gcNewTable);
        $('#gcEnabled').on('change', gcSyncSwitch);
        $('#gcPayoutOn').on('change', gcSyncSwitch);
        $('#gcJokerOn').on('change', gcSyncJoker);
        $('.gc-joker-p').on('input', gcSyncJoker);
        $('#gcGfOn').on('change', function () { gcSyncGoldFinger(); gcUpdatePayoutSum(); });
        $('#gcGf').on('input', function () { gcSyncGoldFinger(); gcUpdatePayoutSum(); });
        $('#gcDpOn,#gcArOn').on('change', gcSyncGoldFinger);
        $('#gcDp,#gcAr').on('input', gcSyncGoldFinger);
        $('#gcTableList').on('click', 'li', function () {
            $('#gcTableList li').removeClass('active');
            $(this).addClass('active');
            var idx = parseInt($(this).attr('data-idx'), 10);
            if (!isNaN(idx)) gcFill(GC_TABLES[idx]);
        });
    });
</script>
