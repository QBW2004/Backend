                                    <label>金拇指触发机会（杂牌局每 10000 次）</label>
                                    <input type="number" id="gcGf" name="gf" class="gc-input" min="0" max="10000" step="1" value="0" />
                                </div>
                            </div>
                            <div class="gc-hint" id="gcGfSum"></div>
                            <input type="hidden" id="gcDpOnVal" name="DiamondFlushOn" value="0" />
                            <input type="hidden" id="gcArOnVal" name="AllRoyalOn" value="0" />
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label><input type="checkbox" id="gcDpOn" /> 启用方块彩金出货权重（同花系无鬼局按权重染成方块领彩金）</label>
                                </div>
                            </div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label>方块彩金出货权重（满足条件的局每 10000 次）</label>
                                    <input type="number" id="gcDp" name="dp" class="gc-input" min="0" max="10000" step="1" value="0" />
                                </div>
                            </div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label><input type="checkbox" id="gcArOn" /> 启用满花彩金出货权重（可全高脸牌型无鬼局按权重改写正宗满花）</label>
                                </div>
                            </div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label>满花彩金出货权重（满足条件的局每 10000 次）</label>
                                    <input type="number" id="gcAr" name="ar" class="gc-input" min="0" max="10000" step="1" value="0" />
                                </div>
                            </div>
                            <div class="gc-hint" id="gcPoolWSum"></div>
                        </div>

                        <div id="gcJpBox" style="display:none;">
                            <div class="gc-section-title" style="margin-top:16px;">彩金奖池 · 当前值与设置</div>
                            <div class="gc-hint" id="gcJpRule" style="margin-bottom:8px;"></div>
                            <table style="width:100%;border-collapse:collapse;margin-bottom:14px;" id="gcJpTable">
                                <thead>
                                    <tr style="background:#f5f8ff;color:#5a6573;font-size:13px;">
                                        <th style="padding:8px;border:1px solid #e5e9f0;text-align:left;">独立奖池牌型</th>
                                        <th style="padding:8px;border:1px solid #e5e9f0;" id="gcJpCurrentTh">当前奖池分（只读）</th>
                                        <th style="padding:8px;border:1px solid #e5e9f0;">保底分（领奖后重置下限）</th>
                                        <th style="padding:8px;border:1px solid #e5e9f0;" id="gcJpTh3">奖池累计上限</th>
                                        <th style="padding:8px;border:1px solid #e5e9f0;" id="gcJpTh4" class="gc-jp-nba">三王额外奖（固定倍数×押分）</th>
                                        <th class="gc-jp-setting">设置奖池分<br /><small>保存后重启生效</small></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                            <div class="gc-hint" id="gcJpInfo"></div>
                        </div>
                        <div class="gc-section-title" style="margin-top:16px;display:none;">高级（旧版兼容）</div>
                        <div class="gc-form-row" style="display:none;">
                            <div class="gc-field">
                                <label>炒场类型</label>
                                <input type="number" id="gcHypeType" name="HYPE_TYPE" class="gc-input" min="0" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>牌机难度（16 位数字，停用上表时生效）</label>
                                <input type="text" id="gcCardDif" name="CardDIF" class="gc-input" maxlength="16" placeholder="16 位数字，如 0000000000000000" />
                            </div>
                        </div>
                    </div>

                    <div class="gc-only-2">
                        <div class="gc-section-title">机台设定（鱼的最高可获得倍率）</div>
                        <div class="gc-form-row">
                            <div class="gc-field">
                                <label>单条鱼最高奖励倍率</label>
                                <select id="gcFishDif" name="FishDIF" class="gc-select">
                                    <option value="0">0 级：不限制最高倍率</option>
                                    <option value="1">1 级：上限 1000</option>
                                    <option value="2">2 级：上限 300</option>
                                    <option value="3">3 级：上限 200</option>
                                    <option value="4">4 级：上限 100</option>
                                    <option value="5">5 级：上限 40</option>
                                    <option value="6">6 级：上限 30</option>
                                    <option value="7">7 级：上限 25</option>
                                    <option value="8">8 级：上限 20</option>
                                    <option value="9">9 级：上限 18</option>
                                </select>
                            </div>
                            <div class="gc-field" style="display:none;">
                                <label>场地类型</label>
                                <select id="gcFishSiteType" name="FishSITE_TYPE" class="gc-select">
                                    <option value="0">0 级：大场地</option>
                                    <option value="1" selected>1 级：中场地</option>
                                    <option value="2">2 级：小场地</option>
                                    <option value="3">3 级：标准场</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    @Html.Partial("_LabaWeights")
                    @Html.Partial("_MjhlWeights")
                    <div class="gc-common">
                    <div class="gc-section-title">玩法与闲置处理</div>
                    <div class="gc-form-row">
                        <div class="gc-field">
                            <label>连续不发炮多久后移出（分钟）</label>
                            <input type="number" id="gcIdleSec" name="IdleFireTimeoutSec" class="gc-input" min="0" value="0" />
                            <span class="gc-switch-label">默认开启：玩家长时间不发炮将被踢出，0 表示不踢出</span>
                            <input type="hidden" id="gcIdleKickVal" name="IdleFireKickEnabled" value="1" />
                        </div>
                    </div>
                    </div>
                    @Html.Partial("_RabbitConfig")
                </form>
            </div>
            <div class="gc-foot" id="gcParaFoot">
                <button type="button" id="gcReset" class="gc-btn gc-btn-default">恢复默认</button>
                <button type="button" id="gcSave" class="gc-btn gc-btn-primary">保存并热更新</button>
            </div>
        </div>
    </div>
</div>

<div id="gcNewTableWin" style="display:none;">
    <div class="gc-batch-create">
        <div class="gc-batch-create-row">
            <span>新建</span>
            <input id="gcNewTableCount" class="easyui-numberbox" value="1" data-options="min:1,max:1000,precision:0" />
            <span>张桌台</span>
        </div>
        <div class="gc-batch-create-tip">确认后会沿用当前页面的基础参数；点击“保存并热更新”后一次创建指定数量的桌台。</div>
        <div class="gc-batch-create-foot">
            <button type="button" id="gcNewTableCancel" class="gc-btn gc-btn-default">取消</button>
            <button type="button" id="gcNewTableConfirm" class="gc-btn gc-btn-primary">确定</button>
        </div>
    </div>
</div>

<script>
    var GC_URL = {
        gameList: '@Url.Action("GetGameList", "GameConfig", new { area = "Game" })',
        tableConfig: '@Url.Action("GetTableConfig", "GameConfig", new { area = "Game" })',
        save: '@Url.Action("SaveTableConfig", "GameConfig", new { area = "Game" })',
        delete: '@Url.Action("DeleteTableConfig", "GameConfig", new { area = "Game" })',
        lineOptions: '@Url.Action("GetLineOptions", "GameConfig", new { area = "Game" })',
        lineCopy: '@Url.Action("CopyPublicTablesToLine", "GameConfig", new { area = "Game" })',
        lineRecall: '@Url.Action("RecallLineTables", "GameConfig", new { area = "Game" })',
        mjhlAgentLines: '@Url.Action("GetMjhlAgentLines", "GameConfig", new { area = "Game" })',
        mjhlAgentGet: '@Url.Action("GetMjhlAgentConfig", "GameConfig", new { area = "Game" })',
        mjhlAgentSave: '@Url.Action("SaveMjhlAgentConfig", "GameConfig", new { area = "Game" })',
        mjhlAgentCopy: '@Url.Action("CopyMjhlDefaultConfig", "GameConfig", new { area = "Game" })',
        mjhlAgentRecall: '@Url.Action("RecallMjhlAgentConfig", "GameConfig", new { area = "Game" })'
    };
    var GC_GAMES = [];
    var GC_TABLES = [];
    var GC_NEW_TABLE_COUNT = 1;
    var GC_BATCH_SAVING = false;
    var GC_LABA_SAVING = false;
    var GC_NEW_TABLE_MAX = 1000;
    var GC_TYPE_META = [
        { v: 2, t: '鱼机类型' },
        { v: 0, t: '押注类型' },
        { v: 1, t: '牌机类型' },
        { v: 3, t: '拉霸类型' }
    ];

    function gcGetType() { return parseInt($('#gcGameType').val(), 10); }

    // 代理线隔离（2026-10-30）：“代理”下拉选公共桌台或超管的某个直属代理。选中某线时左侧只列该线的专属桌台，
    // 保存/删除仍走原接口和热更；该线还没有专属桌台时用「从公共桌台复制一套」生成，「收回专属桌台」让该线回到公共桌台。
    var GC_LINE_INFO = null;
    var GC_MJHL_AGENT = null;
    var GC_MJHL_AGENT_SAVED = null;
    var GC_MJHL_AGENT_CAN_EDIT = false;
    var GC_MJHL_NAMES = ['二条','二筒','五条','五筒','八万','白板','红中','发财','三筒','百搭牌','至尊牌'];
    function gcCurLine() { return $('#gcLineSel').val() || ''; }
    function gcLineCount(line) {
        var n = 0;
        $.each((GC_LINE_INFO && GC_LINE_INFO.Lines) || [], function (i, l) { if (l.id === line) n = l.count; });
        return n;
    }
    var GC_LINE_LOAD_SEQ = 0;
    function gcLoadLines(afterLoad) {
        var lineRequest = ++GC_LINE_LOAD_SEQ;
        var gameId = parseInt($('#gcGameSel').val(), 10);
        if (gameId === 54) {
            request(GC_URL.mjhlAgentLines, {}, function (data) {
                if (lineRequest !== GC_LINE_LOAD_SEQ || !gcIsMjhl()) return;
                var lines = data && data.code == 1 && data.datas ? (data.datas.Lines || []) : [];
                GC_LINE_INFO = { Ready: !!(data && data.code == 1), Lines: lines, Owned: 0, Recycled: 0 };
                var cur = gcCurLine(), $sel = $('#gcLineSel').empty();
                $.each(lines, function (i, l) { $sel.append($('<option></option>').attr('value', l.id).text(l.text || l.id)); });
                var keep = $sel.find('option').filter(function () { return $(this).val() === cur; }).length > 0;
                if (keep) $sel.val(cur); else if ($sel.find('option').length) $sel.prop('selectedIndex', 0);
                gcApplyLineUi();
                if (typeof afterLoad === 'function') afterLoad();
            });
            return;
        }
        request(GC_URL.lineOptions, { GAME_ID: isNaN(gameId) ? -1 : gameId }, function (data) {
            if (lineRequest !== GC_LINE_LOAD_SEQ || gcIsMjhl()) return;
            if (data && data.code == 1 && data.datas) {
                GC_LINE_INFO = data.datas;
                var cur = gcCurLine();
                var $sel = $('#gcLineSel').empty();
                $.each(GC_LINE_INFO.Lines || [], function (i, l) {
                    var label = l.id === '' ? ('公共桌台（' + l.count + ' 桌）')
                        : (l.text + (l.count > 0 ? '（专属 ' + l.count + ' 桌）' : '（用公共桌台）'));
                    $sel.append($('<option></option>').attr('value', l.id).text(label));
                });
                var keep = $sel.find('option').filter(function () { return $(this).val() === cur; }).length > 0;
                $sel.val(keep ? cur : '');
            }
            gcApplyLineUi();
            if (typeof afterLoad === 'function') afterLoad();
        });
    }
    function gcApplyLineUi() {
        var line = gcCurLine();
        var gameId = parseInt($('#gcGameSel').val(), 10);
        var hasGame = !isNaN(gameId) && gameId >= 0;
        var owned = line ? gcLineCount(line) : 0;
        var ready = !GC_LINE_INFO || GC_LINE_INFO.Ready !== false;
        $('#gcLine').val(line);
        $('#gcLineCopy').toggle(ready && hasGame && !!line && owned === 0);
        $('#gcLineRecall').toggle(ready && hasGame && !!line && owned > 0);
        $('#gcNewTable').toggle(!line);
        var tip = '';
        if (!ready) tip = '数据库还没有执行代理线补丁，暂不能分配专属桌台';
        else if (hasGame && line && owned === 0) tip = '该线目前使用公共桌台';
        else if (hasGame && line) tip = '以下为该线专属桌台，参数只对该线玩家生效（需新版客户端）';
        $('#gcLineTip').text(tip);
        gcMjhlInheritanceUi();
        if (gameId === 54) { $('#gcLineCopy,#gcLineRecall,#gcNewTable,#gcDelete,#gcRefresh').hide(); }
    }
    function gcLineToken() { return $('#gcForm [name="__RequestVerificationToken"]').val(); }
    function gcReloadLinesAndTables() { gcLoadLines(function () { gcLoadTables(); }); }
    function gcLineCopy() {
        var line = gcCurLine();
        var gameId = parseInt($('#gcGameSel').val(), 10);
        if (!line || isNaN(gameId) || gameId < 0) return;
        confirm('确定把本游戏全部公共桌台的参数复制一套给【' + line + '】吗？\n复制后该线玩家进入本游戏只看到这些专属桌台（需新版客户端），桌台参数可在左侧逐桌修改。', function () {
            request(GC_URL.lineCopy, { GAME_ID: gameId, GAME_TYPE: gcGetType(), LINE: line, __RequestVerificationToken: gcLineToken() }, function (data) {
                gcMsg(data);
                if (data && data.code == 1) gcReloadLinesAndTables();
            });
        });
    }
    function gcLineRecall() {
        var line = gcCurLine();
        var gameId = parseInt($('#gcGameSel').val(), 10);
        if (!line || isNaN(gameId) || gameId < 0) return;
        confirm('确定收回【' + line + '】在本游戏的专属桌台吗？\n收回后该线玩家重新进入游戏会回到公共桌台；专属桌号保留但谁都看不到，下次分配时优先复用。', function () {
            request(GC_URL.lineRecall, { GAME_ID: gameId, LINE: line, __RequestVerificationToken: gcLineToken() }, function (data) {
                gcMsg(data);
                if (data && data.code == 1) gcReloadLinesAndTables();
            });
        });
    }

    // 加分幅度归一化：鱼机(2) 和麻将胡了(54，参数类型3)支持一位小数，
    // 其它牌机/拉霸类型最小 1 且必须整数。
    function gcNormSs(val, type) {
        var v = parseFloat(val);
        if (type === 2 || (type === 3 && gcIsMjhl())) {
            if (isNaN(v) || v < 0.1) v = 0.1;
            return Math.round(v * 10) / 10;
        }
        v = Math.round(v);
        if (isNaN(v) || v < 1) v = 1;
        return v;
    }

    // 统一反馈：成功/失败/校验用顶部自动消失的 toast；登录超时(code=-1)仍保留模态以便重新登录
    function gcMsg(data) {
        if (data && data.code == -1) { loginTimeoutCallback(data); return; }
        var text = data ? (data.msg ? data.msg : data.content) : '操作失败！';
        showToast(text, (data && data.code == 1) ? 'success' : 'error');
    }

    function gcLoadGames() {
        request(GC_URL.gameList, {}, function (list) {
            GC_GAMES = list || [];
            gcBuildTypeSel();
            gcFillGameSel();
        });
    }

    function gcBuildTypeSel() {
        var $sel = $('#gcTypeSel');
        var cur = $sel.val();
        $sel.empty();
        $sel.append('<option value="-1">请选择类型</option>');
        $.each(GC_TYPE_META, function (i, m) {
            var has = $.grep(GC_GAMES, function (g) { return parseInt(g.gameType, 10) === m.v; }).length > 0;
            if (has) $sel.append('<option value="' + m.v + '">' + m.t + '</option>');
        });
        if (cur !== null && $sel.find('option[value="' + cur + '"]').length > 0) $sel.val(cur);
    }

    function gcFillGameSel() {
        if ($('#gcForm').hasClass('gc-mjhl-mode')) gcMjhlApplyMode(false);
        var type = parseInt($('#gcTypeSel').val(), 10);
        var $sel = $('#gcGameSel');
        $sel.empty();
        gcClearTables();
        if (isNaN(type) || type < 0) {
            $sel.append('<option value="-1">请先选择游戏类型</option>');
            return;
        }
        var games = $.grep(GC_GAMES, function (g) { return parseInt(g.gameType, 10) === type; });
        if (games.length < 1) {
            $sel.append('<option value="-1">该类型暂无已开启游戏</option>');
            return;
        }
        $sel.append('<option value="-1">请选择游戏</option>');
        $.each(games, function (i, g) {
            // 下拉按 gameType（展示口径）归类；data-type 取 paraType（参数配置口径，
            // 麻将胡了分类为牌机但参数走拉霸路径，后续 GetTableConfig/保存须下发 3）。
            var pt = (typeof g.paraType != 'undefined' && g.paraType !== null) ? g.paraType : g.gameType;
            $sel.append('<option value="' + g.id + '" data-type="' + pt + '">' + g.text + '</option>');
        });
    }

    function gcClearTables() {
        GC_TABLES = [];
        $('#gcTableList').empty();
        $('#gcTableEmpty').show().text('请选择上方游戏以加载桌台。');
        $('#gcCurTableName').text('');
        $('#gcId').val(-1);
        gcSetParaVisible(false);
    }

    function gcSetParaVisible(visible) {
        if (visible) {
            $('#gcParaEmpty').hide();
            $('#gcForm').show();
            $('#gcParaFoot').toggle(!gcIsMjhl());
        } else {
            $('#gcParaEmpty').show();
            $('#gcForm').hide();
            $('#gcParaFoot').hide();
            if (window.rabbitConfigClear) window.rabbitConfigClear();
            $('#gcCurTableName').text('');
        }
    }

    function gcLatestTable() {
        if (!GC_TABLES || GC_TABLES.length < 1) return null;
        var latest = GC_TABLES[0];
        $.each(GC_TABLES, function (i, t) {
            if (parseInt(t.id, 10) > parseInt(latest.id, 10)) latest = t;
        });
        return latest;
    }

    function gcRenderTableList() {
        var $list = $('#gcTableList');
        $list.empty();
        if (GC_TABLES.length < 1) {
            if (gcCurLine()) {
                $('#gcTableEmpty').show().text('该线目前使用公共桌台，点上方「从公共桌台复制一套」生成专属桌台。');
                return;
            }
            $('#gcTableEmpty').show().text('该游戏暂无桌台，填写参数后点击右上角“新建桌台”。');
            return;
        }
        $('#gcTableEmpty').hide();
        $.each(GC_TABLES, function (i, t) {
            var pill = t.enabled == 1
                ? '<span class="gc-pill gc-pill-on">启用</span>'
                : '<span class="gc-pill gc-pill-off">停用</span>';
            $list.append('<li data-idx="' + i + '" data-id="' + t.id + '"><span>' + t.tableName + '</span>' + pill + '</li>');
        });
    }

    function gcSelectTableById(id) {
        var found = -1;
        $.each(GC_TABLES, function (i, t) { if (parseInt(t.id, 10) === parseInt(id, 10)) found = i; });
        if (found < 0) { gcPrepareNewTableForm(1); return; }
        $('#gcTableList li').removeClass('active');
        $('#gcTableList li[data-idx="' + found + '"]').addClass('active');
        gcFill(GC_TABLES[found]);
    }

    // 拉霸子类型（与后端 GetLabaSubType 对齐）：53=水浒传 16=明星97 40=水果拉霸
    function gcLabaSubType() {
        var gameId = parseInt($('#gcGameSel').val(), 10);
        if (gameId === 53) return 3;
        if (gameId === 16) return 1;
        if (gameId === 40) return 2;
        return 0;
    }

    // 庄闲/和(幸运六狮)、皇冠(彩金单挑)限红：按游戏动态显示与改名；
    // 其余押注玩法无副玩法/和门，整行隐藏并禁用 input，避免 serializeObject 误提交覆盖库值
    function gcApplyViceDraw() {
        var gid = parseInt($('#gcGameSel').val(), 10);
        var lion = (gid === 10), crown = (gid === 2);
        var show = lion || crown;
        $('#gcViceDrawRow').toggle(show);
        $('#gcViceDrawHint').toggle(show);
        if (show) {
            $('#gcViceMaxLbl').text(crown ? '皇冠单次最高押分' : '庄/闲单门最高押分');
            $('#gcViceMinField').toggle(crown);
            $('#gcDrawMaxField').toggle(lion);
            // 幸运六狮的庄/闲、和不单独配最小押分：跟随上面的「最低压分」，这里只配单门最高押分
            $('#gcViceDrawHint').text(crown
                ? '皇冠代表副玩法押分区域；限额按桌保存，仅对彩金单挑生效。'
                : '庄/闲、和的最小押分跟随上面的「最低压分」（不单独配置），这里只配两者的单门最高押分；限额按桌保存，仅对幸运六狮生效。');
        }
        $('#gcViceDrawRow input').prop('disabled', !show);
    }

    function gcIsMjhl() { return parseInt($('#gcGameSel').val(), 10) === 54; }

    function gcMjhlApplyMode(on) {
        var $grid = $('.gc-grid');
        $('#gcConfigHeading').text(on ? '代理游戏参数' : '桌台参数');
        $('#gcMjhlAgentPanel').toggle(!!on);
        $('#gcForm').toggleClass('gc-mjhl-mode', !!on);
        $('body').toggleClass('gc-mjhl-page', !!on);
        $('.gc-wrap').toggleClass('gc-mjhl-desktop', !!on);
        $grid.toggleClass('gc-mjhl-grid', !!on);
        $('#gcParaFoot').toggle(!on);
        $('#gcNewTable,#gcDelete,#gcRefresh,#gcLineCopy,#gcLineRecall').toggle(!on && !gcCurLine());
        gcMjhlInheritanceUi();
        if (on) {
            $('#gcCurTableName').text('麻将胡了 · ' + (gcCurLine() === '*' ? '默认' : (gcCurLine() || '请选择代理线')));
            $('#gcMjhlAgentPanel .gc-weight-body').each(function () {
