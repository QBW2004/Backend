            $('#gcLabaTh3').text('倍率（客户端写死，不可改）');
            $('#gcLabaTh4').text('日库存（留空=不限，0=当天禁出）').show();
            $('#gcLabaPayoutBox').show();
            $.each(GC_LABA_WHEEL_META, function (idx, r) {
                $tb.append('<tr>' +
                    // 面板位前缀，区分同果多面板（如苹果 4/10/16/22 为不同面板；苹果·小=5 与苹果不同）
                    '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#36404a;">面板' + r.i + ' · ' + r.n + '</td>' +
                    '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" name="WheelProb' + r.i + '" id="gcLabaWp' + r.i + '" class="gc-input gc-laba-wp" min="0" max="10000" step="1" value="0" /></td>' +
                    '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#8a94a1;text-align:center;">' + r.v + '</td>' +
                    '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" name="WheelStock' + r.i + '" id="gcLabaWs' + r.i + '" class="gc-input gc-laba-ws" min="0" max="1000000" step="1" placeholder="不限" /></td>' +
                    '</tr>');
