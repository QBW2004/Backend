            (jpSet[0] != null ? '已有待生效的奖池设置。' : ''));
        $('#gcJpBox').show();
    }

    // 与后端 MjhlWeightProfile.CheckBetLadder、服务端 MjhlWeight::BuildBetLadder 同口径；合法返回空串
    function gcMjhlLadderError(minBet, maxBet, step) {
        if ([minBet, maxBet, step].some(function (v) { return !isFinite(v); }))
            return '麻将胡了的押注参数必须为有效数值！';
        if (minBet < 0.1 || maxBet < minBet || step < 0.1)
            return '麻将胡了的最小押注和每次增加的分值至少 0.1 分，且最大押注不能小于最小押注！';
        if (maxBet > 214748364.7 || step > 6553.5)
            return '麻将胡了的押注参数超出可保存范围！';
        if ([minBet, maxBet, step].some(function (v) { return Math.abs(v * 10 - Math.round(v * 10)) > 0.000001; }))
            return '麻将胡了的最小/最大押注和每次增加的分值最多保留一位小数！';
        var minUnits = Math.round(minBet * 10), maxUnits = Math.round(maxBet * 10), stepUnits = Math.round(step * 10);
        if (Math.floor((maxUnits - minUnits) / stepUnits) + 1 + ((maxUnits - minUnits) % stepUnits ? 1 : 0) > 200)
            return '麻将胡了押注档位不能超过 200 个，请加大每次增加的分值或缩小押注范围！';
        return '';
    }

    function gcReloadAfterNewTables() {
        gcLoadTables(function () {
            if (GC_TABLES.length > 0) gcSelectTableById(gcLatestTable().id);
            else gcPrepareNewTableForm(1);
        });
    }

    function gcRequestTableSave(para, callback) {
        if (para.LabaWeightsJson) { window.labaWeightsSubmit(GC_URL.save, para, callback); return; }
        if (para.PhenixConfigJson || para.RabbitConfigJson) {
            $.ajax({ url: GC_URL.save, type: 'POST', data: para, dataType: 'json' })
                .done(callback).fail(function () { callback({code:0,content:'保存请求失败，请重新载入确认后重试。'}); });
            return;
        }
        request(GC_URL.save, para, callback);
    }

    // 批量新建仍复用单桌保存接口，按顺序提交，确保 AllocTableId 每次都读取到上一张新桌。
    // 不在前端复制各游戏类型的落库规则，继续沿用原有事务、校验和热更新逻辑。
    function gcSaveNewTables(basePara, count) {
        var completed = 0;
        var batchGame = parseInt($('#gcGameId').val(), 10), batchLine = gcCurLine(), batchId = parseInt($('#gcId').val(), 10);
        GC_BATCH_SAVING = true;
        if (basePara.LabaWeightsJson && window.labaWeightsSetSaving) window.labaWeightsSetSaving(true);
        if (basePara.PhenixConfigJson && window.phenixConfigSetSaving) window.phenixConfigSetSaving(true);
        if (basePara.RabbitConfigJson && window.rabbitConfigSetSaving) window.rabbitConfigSetSaving(true);
        $('#gcSave').prop('disabled', true).text('正在新建 0/' + count + ' 张');

        function finish(data) {
            GC_BATCH_SAVING = false;
            if (basePara.LabaWeightsJson && window.labaWeightsSetSaving) window.labaWeightsSetSaving(false);
            if (basePara.PhenixConfigJson && window.phenixConfigSetSaving) window.phenixConfigSetSaving(false);
            if (basePara.RabbitConfigJson && window.rabbitConfigSetSaving) window.rabbitConfigSetSaving(false);
            if (basePara.RabbitConfigJson && completed > 0 && window.rabbitConfigSaved) window.rabbitConfigSaved(basePara.RabbitConfigJson, batchId);
            $('#gcSave').prop('disabled', false);
            gcUpdateSaveBtn();
            gcMsg(data || { code: 0, content: '批量新建失败！' });
            if ((basePara.LabaWeightsJson || basePara.PhenixConfigJson || basePara.RabbitConfigJson) && (batchGame !== parseInt($('#gcGameId').val(), 10) || batchLine !== gcCurLine() || batchId !== parseInt($('#gcId').val(), 10))) return;
            gcReloadAfterNewTables();
        }

        function saveNext() {
            var para = $.extend({}, basePara, { ID: -1 });
            gcRequestTableSave(para, function (data) {
                if (!data || !(data.code == 1 || data.datas === true)) {
                    var reason = data && (data.msg || data.content) ? (data.msg || data.content) : '服务器未返回成功结果';
                    finish({ code: 0, content: '已成功新建 ' + completed + '/' + count + ' 张桌台；第 ' + (completed + 1) + ' 张失败：' + reason });
                    return;
                }
                completed++;
                $('#gcSave').text('正在新建 ' + completed + '/' + count + ' 张');
                if (completed < count) {
                    saveNext();
                    return;
                }
                finish({ code: 1, content: '成功新建 ' + completed + ' 张桌台！' });
            });
        }

        saveNext();
    }

    function gcSave() {
        if (GC_BATCH_SAVING || GC_LABA_SAVING) return;
        var type = gcGetType();
        if (type != 0 && type != 1 && type != 2 && type != 3) {
            showToast('请先选择游戏类型与对应游戏的桌台！', 'warning');
            return;
        }
        if (parseInt($('#gcGameId').val(), 10) < 0) {
            showToast('请先选择需要配置的游戏！', 'warning');
            return;
        }
        var minBet = parseFloat($('#gcMinBet').val());
        var maxBet = parseFloat($('#gcMaxBet').val());
        if (isNaN(minBet) || isNaN(maxBet) || minBet < 0 || maxBet < 0) {
            showToast('下注值必须为不小于 0 的数字！', 'warning');
            return;
        }
        if (maxBet > 0 && minBet > maxBet) {
            showToast('最小值不能大于最大值！', 'warning');
            return;
        }
        // 三个拉霸（明星97/水果机/水浒传）最小/最大押分只能为整数
        if (gcLabaSubType() > 0 && (Math.floor(minBet) !== minBet || Math.floor(maxBet) !== maxBet)) {
            showToast('拉霸最小/最大押分只能设置整数！', 'warning');
            return;
        }
        if (gcIsMjhl()) {
            var mjStep = parseFloat($('#gcScoreSwitch').val());
            var mjMsg = gcMjhlLadderError(minBet, maxBet, mjStep);
            if (mjMsg) {
                showToast(mjMsg, 'warning');
                return;
            }
        }
        if (type === 1 || type === 2 || type === 3) { // gcCardStepInvalid
            var gcSs = parseFloat($('#gcScoreSwitch').val());
            var gcSsBad = (type === 2 || (type === 3 && gcIsMjhl()))
                ? (isNaN(gcSs) || gcSs < 0.1)
                : (isNaN(gcSs) || gcSs < 1 || Math.floor(gcSs) !== gcSs);
            if (gcSsBad) {
                showToast((type === 2 || (type === 3 && gcIsMjhl())) ? '加分幅度必须大于 0，最小 0.1!' : '加分幅度必须为大于等于 1 的整数!', 'warning');
                return;
            }
        }
        gcSyncSwitch();
        gcCollectChips();
        if (gcGetType() === 0) gcCollectBetSpec();
        // 庄家抽水：页面以百分比显示，落库前换算为千分比（×10，服务端按 /1000 计算）
        if (gcGetType() === 0) {
            var bpDisp = parseFloat($('#gcBankerPer').val());
            if (isNaN(bpDisp) || bpDisp < 0) {
                showToast('庄家抽水比例不能为负数！', 'warning');
                return;
            }
            if (bpDisp > 9.9) {
                showToast('庄家抽水比例最大 9.9%（库内千分比 99）！', 'warning');
                return;
            }
            $('#gcBankerPerRaw').val(Math.round(bpDisp * 10));
        }
        var savedId = parseInt($('#gcId').val(), 10);
        var wasNew = isNaN(savedId) || savedId < 0;
        // 已分配专属桌台后再新建公共桌台：新桌号排在专属桌台之后，旧版客户端按连续位置取配置，进不了这张桌，先确认
        if (wasNew && !gcCurLine() && GC_LINE_INFO && (GC_LINE_INFO.Owned > 0 || GC_LINE_INFO.Recycled > 0) && !gcSave.confirmedAppend) {
            confirm('本游戏已经分配过专属桌台，新建的公共桌台会排在专属桌台之后，旧版客户端进不了这张桌。\n确定继续新建 ' + GC_NEW_TABLE_COUNT + ' 张吗？', function () {
                gcSave.confirmedAppend = true;
                try { gcSave(); } finally { gcSave.confirmedAppend = false; }
            });
            return;
        }
        var para = $('#gcForm').serializeObject();
        // 彩金奖池：区块不可见、四个值与回填一致(未改动)、或全部留空时不带 JP_* 字段，
        // 后端跳过奖池登记；部分留空保留字段交后端校验报错。
        var jpNow = [$('#gcJp5K').val(), $('#gcJpRS').val(), $('#gcJpSF').val(), $('#gcJp4K').val(), $('#gcJpDIA').val(), $('#gcJpAR').val()].join(',');
        if (!$('#gcJpBox').is(':visible') || jpNow === ',,,,,' || jpNow === $('#gcJpBox').data('jpOrig')) {
            delete para.JP_5K; delete para.JP_RS; delete para.JP_SF; delete para.JP_4K; delete para.JP_DIA; delete para.JP_AR;
        } else if (!gcIsAttMhb()) {
            delete para.JP_DIA; delete para.JP_AR;
        }
        para.__RequestVerificationToken = $('#gcForm [name="__RequestVerificationToken"]').val();
        if (gcLabaSubType() > 0) {
            if (!window.labaWeightsCollect) { showToast('开奖权重组件尚未载入，请刷新页面后重试。', 'warning'); return; }
            try { $.extend(para, window.labaWeightsCollect()); }
            catch (labaError) { showToast(labaError.message, 'warning'); return; }
        }
        if (parseInt($('#gcGameId').val(), 10) === 5) {
            if (!window.phenixConfigCollect) { showToast('火凤凰规则组件尚未载入，请刷新后重试。', 'warning'); return; }
            try { $.extend(para, window.phenixConfigCollect()); }
            catch (pxError) { showToast(pxError.message, 'warning'); return; }
        }
        if (parseInt($('#gcGameId').val(), 10) === 55) {
            if (!window.rabbitConfigCollect) { showToast('大白兔规则组件尚未载入，请刷新后重试。', 'warning'); return; }
            try { $.extend(para, window.rabbitConfigCollect()); }
            catch (rabbitError) { showToast(rabbitError.message, 'warning'); return; }
        }
        if (wasNew && GC_NEW_TABLE_COUNT > 1) {
            gcSaveNewTables(para, GC_NEW_TABLE_COUNT);
            return;
        }
        var savingLaba = !!(para.LabaWeightsJson || para.PhenixConfigJson || para.RabbitConfigJson), saveGame = parseInt($('#gcGameId').val(), 10), saveLine = gcCurLine();
        if (savingLaba) {
            GC_LABA_SAVING = true; $('#gcSave').prop('disabled', true);
            if (window.labaWeightsSetSaving) window.labaWeightsSetSaving(true);
            if (para.PhenixConfigJson && window.phenixConfigSetSaving) window.phenixConfigSetSaving(true);
            if (para.RabbitConfigJson && window.rabbitConfigSetSaving) window.rabbitConfigSetSaving(true);
        }
        gcRequestTableSave(para, function (data) {
            if (savingLaba) {
                GC_LABA_SAVING = false; $('#gcSave').prop('disabled', false);
                if (window.labaWeightsSetSaving) window.labaWeightsSetSaving(false);
                if (para.PhenixConfigJson && window.phenixConfigSetSaving) window.phenixConfigSetSaving(false);
                if (para.RabbitConfigJson && window.rabbitConfigSetSaving) window.rabbitConfigSetSaving(false);
            }
            if (para.RabbitConfigJson && data && (data.code == 1 || data.datas === true) && window.rabbitConfigSaved) window.rabbitConfigSaved(para.RabbitConfigJson, savedId);
            gcMsg(data);
            if (data && (data.code == 1 || data.datas === true)) {
                if (savingLaba && (saveGame !== parseInt($('#gcGameId').val(), 10) || saveLine !== gcCurLine() || savedId !== parseInt($('#gcId').val(), 10))) return;
                gcLoadTables(function () {
                    if (wasNew) {
                        if (GC_TABLES.length > 0) gcSelectTableById(gcLatestTable().id);
                        else gcPrepareNewTableForm(1);
                    }
                    else gcSelectTableById(savedId);
                });
            }
        });
    }

    function gcDelete() {
        var savedId = parseInt($('#gcId').val(), 10);
        if (isNaN(savedId) || savedId < 0) {
            showToast('请先在左侧选择要删除的桌台！', 'warning');
            return;
        }
        confirm('确定要彻底删除该桌台吗？\n此操作将从数据库永久清除，不可恢复！', function () {
            var para = {
                ID: savedId,
                GAME_TYPE: gcGetType(),
                __RequestVerificationToken: $('#gcForm [name="__RequestVerificationToken"]').val()
            };
            request(GC_URL.delete, para, function (data) {
                var ok = data && (data.code == 1 || data.datas === true);
                if (ok) {
                    // 先本地移除已删除桌台并立即重渲染，保证 UI 即时响应，且不被任何提示异常阻断；
                    GC_TABLES = $.grep(GC_TABLES, function (t) { return parseInt(t.id, 10) !== savedId; });
                    gcRenderTableList();
                    // 再向服务端拉取最新列表做一次权威校正同步。
                    gcLoadTables();
                }
                gcMsg(data);
            });
        });
    }

    $(function () {
        pluginInit();
        gcLoadGames();
        gcSetParaVisible(false);
        gcLoadLines();
        $('#gcTypeSel').on('change', function () { gcMjhlCancelRtp(); GC_MJHL_LOAD_SEQ++; gcFillGameSel(); });
        $('#gcGameSel').on('change', function () { gcMjhlCancelRtp(); GC_MJHL_LOAD_SEQ++; if (!gcIsMjhl() && $('#gcForm').hasClass('gc-mjhl-mode')) gcMjhlApplyMode(false); gcReloadLinesAndTables(); });
        $('#gcLineSel').on('change', function () { gcMjhlCancelRtp(); GC_MJHL_LOAD_SEQ++; gcApplyLineUi(); gcLoadTables(); });
        $('#gcLineCopy').on('click', gcLineCopy);
        $('#gcLineRecall').on('click', gcLineRecall);
        $('#mjhlAgentCopy').on('click', function () { gcMjhlChangeInheritance(true); });
        $('#mjhlAgentRecall').on('click', function () { gcMjhlChangeInheritance(false); });
        $('#gcRefresh').on('click', function () {
            if ($('#gcGameId').val() === '55' && window.rabbitConfigReload) {
                var refreshGame = $('#gcGameSel').val(), refreshLine = gcCurLine();
                window.rabbitConfigReload();
                gcLoadLines(function () {
                    if ($('#gcGameSel').val() !== refreshGame || gcCurLine() !== refreshLine) return;
                    gcLoadTables(function () {
                        var currentId = parseInt($('#gcId').val(), 10);
                        if (currentId >= 0) gcSelectTableById(currentId); else gcPrepareNewTableForm(1);
                    });
                });
                return;
            }
            gcReloadLinesAndTables();
        });
        $('#gcDelete').on('click', gcDelete);
        $('#gcReset').on('click', function () {
            // 恢复默认会把当前表单所有参数改为出厂默认（保存后即覆盖当前桌台配置），二次确认防止误触
            var isEditing = parseInt($('#gcId').val(), 10) >= 0;
            if ($('#gcGameId').val() === '55') {
                confirm('确定恢复默认吗？当前桌台参数和玩法规则都会回填默认值，保存后仅对本桌生效。', function () { gcResetForm(); });
                return;
            }
            confirm(isEditing
                ? '确定将该桌台基础参数恢复为默认值吗？\n点击确认后表单将回填默认值，保存即覆盖当前桌台的基础参数；中奖权重保持不变。'
                : '确定将表单恢复为默认值吗？', function () { gcResetForm(); });
        });
        $('#gcSave').on('click', gcSave);
        $('#mjhlAgentSave').on('click', gcMjhlSave);
        $('#mjhlRtpCalibrate').on('click', gcMjhlCalibrate);
        $('#mjhlRtpVerify').on('click', gcMjhlVerify);
        $('#mjhlAgentReset').on('click', function () { if (GC_MJHL_AGENT_SAVED) gcMjhlFill(GC_MJHL_AGENT_SAVED, GC_MJHL_META); });
        $('#gcMjhlAgentPanel .gc-weight-body').on('input change', 'input', gcMjhlScheduleVerify);
        $('#mjhlScatterEnabled,#mjhlFreeRetrigger').on('change', function () { gcMjhlSwitchText(); gcMjhlScheduleVerify(); });
        $('#mjhlGoldChance').on('input change', gcMjhlScheduleVerify);
        $('#mjhlTargetRtp').on('change', gcMjhlCommitTarget).on('keydown', function (event) { if (event.key === 'Enter' || event.keyCode === 13) { event.preventDefault(); gcMjhlCommitTarget(); } });
        $('#gcNewTable').on('click', gcNewTable);
        $('#gcNewTableConfirm').on('click', gcConfirmNewTable);
        $('#gcNewTableCancel').on('click', function () { $('#gcNewTableWin').dialog('close'); });
        $('#gcEnabled').on('change', gcSyncSwitch);
        $('#gcPayoutOn').on('change', gcSyncSwitch);
        $('#gcJokerOn').on('change', gcSyncJoker);
        $('.gc-joker-p').on('input', gcSyncJoker);
        $('#gcGfOn').on('change', function () { gcSyncGoldFinger(); gcUpdatePayoutSum(); });
        $('#gcGf').on('input', function () { gcSyncGoldFinger(); gcUpdatePayoutSum(); });
        $('#gcDpOn,#gcArOn').on('change', function () { gcSyncGoldFinger(); gcUpdatePayoutSum(); });
        $('#gcDp,#gcAr').on('input', function () { gcSyncGoldFinger(); gcUpdatePayoutSum(); });
        $('#gcTableList').on('click', 'li', function () {
            $('#gcTableList li').removeClass('active');
            $(this).addClass('active');
            var idx = parseInt($(this).attr('data-idx'), 10);
            if (!isNaN(idx)) gcFill(GC_TABLES[idx]);
        });
    });
</script>

