    // 水果拉霸逐区等值实时核算（与后台 SaveFruitRtpConfig 同公式，设计文档 §2.3/§5.3）：
    // c_a = Σ_{i∈区a} 权重/10000 × 倍率；送灯率 g = p9×2 + p21×4.5；理论 RTP = mean(c)/(1-g)
    var FRUIT_RAT = [10, 20, 50, 120, 5, 3, 15, 20, 3, 0, 5, 3, 10, 20, 3, 40, 5, 3, 15, 3, 30, 0, 5, 3];
    var FRUIT_AREA = [6, 4, 0, 0, 7, 7, 5, 3, 3, -1, 7, 6, 6, 4, 1, 1, 7, 5, 5, 2, 2, -1, 7, 4];
    var FRUIT_AREA_NAME = ['BAR', '双7', '星', '西瓜', '铃铛', '柠檬', '橘子', '苹果'];
    // 水果拉霸默认面板权重（万分比，合计 10000）：8 押注区 Σ概率×倍率 均≈0.850（偏差 0.01%，
    // 满足逐区等值硬门槛 ≤5%），送灯位 9/21=50/100（g=0.055），理论 RTP≈89.94%；
    // 新建桌台预填 / 权重全 0 保存时兜底使用（与后端 FruitPanelDefaultProb 同值）
    var GC_LABA_WHEEL_DEFAULT = [395, 200, 50, 50, 347, 505, 197, 422, 20, 50, 350, 200, 395, 180, 2700, 10, 350, 433, 283, 2033, 80, 100, 350, 300];
    function fruitRtpPreview() {
        var c = [0, 0, 0, 0, 0, 0, 0, 0], sum = 0, p9 = 0, p21 = 0;
        for (var i = 0; i < 24; i++) {
            var w = parseInt($('[name=WheelProb' + i + ']').val()) || 0;
            sum += w;
            if (i === 9) p9 = w / 10000; else if (i === 21) p21 = w / 10000;
            else if (FRUIT_AREA[i] >= 0) c[FRUIT_AREA[i]] += w / 10000 * FRUIT_RAT[i];
        }
        var g = p9 * 2 + p21 * 4.5;
        var mean = 0;
        for (var a = 0; a < 8; a++) mean += c[a];
        mean /= 8;
        var rtp = (g < 1 && sum > 0) ? mean / (1 - g) : 0;
        var bad = [];
        for (var a2 = 0; a2 < 8; a2++)
            if (mean > 0 && Math.abs(c[a2] - mean) / mean > 0.05) bad.push(FRUIT_AREA_NAME[a2] + '=' + c[a2].toFixed(3));
        var html = '指向概率合计：' + sum + ' / 10000；送灯率：' + ((p9 + p21) * 100).toFixed(2) + '%；g=' + g.toFixed(4) +
            '；理论 RTP：<b>' + (rtp * 100).toFixed(2) + '%</b><br/>各区 c_a（Σ概率×倍率）：';
        for (var a3 = 0; a3 < 8; a3++)
            html += FRUIT_AREA_NAME[a3] + '=' + c[a3].toFixed(3) + '&nbsp;';
        if (sum === 0) html += '<br/>（权重全 0：保存时将自动使用内置默认 90% 面板表；新建桌台默认预填该表）';
        else if (bad.length > 0) html += '<br/><span style="color:#d33b3b;">逐区等值约束不满足：' + bad.join('，') + ' 偏差超过 5%，保存将被拒绝！</span>';
        else if (sum > 0) html += '<br/><span style="color:#2e9e5b;">逐区等值约束满足（偏差 ≤5%），可以保存。</span>';
        $('#gcFruitRtpPreview').html(html);
    }

    function gcBuildLabaPayoutTable(subType) {
