        // 本机台奖池分回填：优先显示已下发待生效值(jpSet*)，其次游戏服导出的当前值(jp*)；
        // 原值记入 jpOrig，保存时未改动则不带 JP_* 字段（避免无关保存把运行中的奖池钉死在重启后）。
        // ATT满花版多两池(方块/满花)：JP_DIA/JP_AR 仅该游戏显示，未提交时服务端不覆盖该池。
        var jpCur = t ? [t.jp5K, t.jpRS, t.jpSF, t.jp4K, t.jpDia, t.jpAR] : [null, null, null, null, null, null];
        $('#gcJpTable .gc-jp-current-value').each(function (i) { $(this).text(jpCur[i] != null ? String(jpCur[i]) : '未获取'); });
        $('#gcJpCurrentTh').attr('title', t && t.jpStateTime ? '游戏服快照：' + t.jpStateTime : '游戏服导出的奖池快照');
        var jpSet = t ? [t.jpSet5K, t.jpSetRS, t.jpSetSF, t.jpSet4K, t.jpSetDia, t.jpSetAR] : [null, null, null, null, null, null];
        var jpUse = (jpSet[0] != null) ? jpSet : jpCur;
