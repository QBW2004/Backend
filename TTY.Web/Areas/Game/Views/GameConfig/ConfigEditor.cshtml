                rows.push(['方块彩金（无鬼全方块同花 / 同花顺 / 同花大顺）', 300, 10000, null]);
                rows.push(['满花彩金（正宗满花）', 2000, 100000, null]);
            }
        } else {
            $('#gcJpRule').html('NBA 规则（服务端常量，与 点石成金 不同）：每局按轮次轮流累计 4K→SF→RS→5K 各 +1 分（非押分节奏）；领取额 = 奖池 ×（本局押分 ÷ 80），押分 ≥80 领取 100%；中奖局含 3 张鬼牌时另按固定倍数加奖；领奖后奖池降至保底。');
            $('.gc-jp-nba').show();
            rows = [
                ['五梅 5.K.', 5000, '—（轮次累计无上限控制）', '押分 ×160'],
                ['同花大顺 R.S.', 2000, '—（轮次累计无上限控制）', '押分 ×80'],
                ['同花顺 S.F.', 500, '—（轮次累计无上限控制）', '押分 ×40'],
                ['四梅 4.K.', 200, '—（轮次累计无上限控制）', '押分 ×20']
            ];
        }
        var $tb = $('#gcJpTable tbody');
        var jpFields = [['gcJp5K', 'JP_5K'], ['gcJpRS', 'JP_RS'], ['gcJpSF', 'JP_SF'], ['gcJp4K', 'JP_4K'], ['gcJpDIA', 'JP_DIA'], ['gcJpAR', 'JP_AR']];
        $tb.empty();
        $.each(rows, function (i, r) {
            var html = '<tr>' +
                '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#36404a;">' + r[0] + '</td>' +
                '<td class="gc-jp-current"><output class="gc-jp-current-value" data-pool-index="' + i + '">未获取</output></td>' +
                '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="text" class="gc-input" value="' + r[1] + '" disabled /></td>' +
                '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="text" class="gc-input" value="' + r[2] + '" disabled /></td>';
            if (r[3] !== null) html += '<td style="padding:4px;border:1px solid #e5e9f0;" class="gc-jp-nba"><input type="text" class="gc-input" value="' + r[3] + '" disabled /></td>';
            html += '<td class="gc-jp-setting"><input type="number" id="' + jpFields[i][0] + '" name="' + jpFields[i][1] + '" class="gc-input gc-jp-v" min="0" max="2000000000" step="1" aria-label="' + r[0] + '设置奖池分" /></td>';
            html += '</tr>';
