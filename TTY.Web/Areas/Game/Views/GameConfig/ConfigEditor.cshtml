@{
    Layout = "~/Views/Shared/Layout/_ContentLayout.cshtml";
    ViewBag.RouteMap = "游戏配置";
}
@section include_res{
    <style>
        .gc-wrap { padding: 16px; box-sizing: border-box; }
        .gc-tip { display: none; }
        .gc-grid { display: flex; gap: 16px; align-items: stretch; }
        .gc-card { background: #fff; border: 1px solid #e5e9f0; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.04); }
        .gc-left { width: 260px; flex: 0 0 260px; display: flex; flex-direction: column; }
        .gc-right { flex: 1 1 auto; min-width: 0; }
        .gc-card-hd { padding: 12px 16px; border-bottom: 1px solid #eef1f6; font-size: 14px; font-weight: 600; color: #1f2d3d; display: flex; align-items: center; justify-content: space-between; }
        .gc-card-hd .fa { color: #2f6fed; margin-right: 6px; }
        .gc-card-bd { padding: 16px; }
        .gc-field { margin-bottom: 14px; }
        .gc-field > label { display: block; font-size: 13px; color: #5a6573; margin-bottom: 6px; }
        .gc-input, .gc-select { width: 100%; height: 36px; line-height: 36px; padding: 0 12px; box-sizing: border-box; border: 1px solid #d4dae3; border-radius: 6px; font-size: 14px; color: #1f2d3d; background: #fff; transition: border-color .15s, box-shadow .15s; }
        .gc-input:focus, .gc-select:focus { border-color: #2f6fed; box-shadow: 0 0 0 3px rgba(47,111,237,.12); outline: none; }
        .gc-form-row { display: flex; gap: 16px; }
        .gc-form-row > .gc-field { flex: 1 1 0; }
        .gc-section-title { font-size: 13px; font-weight: 600; color: #2f6fed; margin: 4px 0 12px; padding-left: 8px; border-left: 3px solid #2f6fed; }
        .gc-switch { position: relative; display: inline-block; width: 46px; height: 24px; vertical-align: middle; }
        .gc-switch input { opacity: 0; width: 0; height: 0; }
        .gc-slider { position: absolute; cursor: pointer; inset: 0; background: #c7ced8; border-radius: 24px; transition: .2s; }
        .gc-slider:before { content: ""; position: absolute; height: 18px; width: 18px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: .2s; }
        .gc-switch input:checked + .gc-slider { background: #2f6fed; }
        .gc-switch input:checked + .gc-slider:before { transform: translateX(22px); }
        .gc-switch-label { margin-left: 10px; font-size: 13px; color: #5a6573; }
        .gc-tablelist { list-style: none; margin: 0; padding: 0; max-height: 540px; overflow-y: auto; }
        .gc-tablelist li { padding: 10px 14px; border-bottom: 1px solid #f0f2f6; cursor: pointer; font-size: 13px; color: #36404a; display: flex; align-items: center; justify-content: space-between; }
        .gc-tablelist li:hover { background: #f5f8ff; }
        .gc-tablelist li.active { background: #ecf2ff; color: #2f6fed; font-weight: 600; }
        .gc-pill { font-size: 11px; padding: 1px 8px; border-radius: 10px; }
        .gc-pill-on { background: #e6f7ed; color: #1a9d57; }
        .gc-pill-off { background: #fbe9e9; color: #d33b3b; }
        .gc-foot { padding: 14px 16px; border-top: 1px solid #eef1f6; text-align: right; }
        .gc-btn { height: 36px; padding: 0 20px; border-radius: 6px; border: 1px solid transparent; font-size: 14px; cursor: pointer; }
        .gc-btn-primary { background: #2f6fed; color: #fff; }
        .gc-btn-primary:hover { background: #2560d6; }
        .gc-btn-default { background: #fff; color: #5a6573; border-color: #d4dae3; margin-right: 10px; }
        .gc-btn-default:hover { border-color: #2f6fed; color: #2f6fed; }
        .gc-empty { padding: 40px 16px; text-align: center; color: #9aa4b1; font-size: 13px; }
        .gc-toolbar { display: flex; gap: 10px; margin-bottom: 12px; align-items: center; }
        .gc-toolbar .gc-lbl { font-size: 13px; color: #5a6573; }
        .gc-toolbar #gcTypeSel { width: 160px; }
        .gc-toolbar #gcGameSel { width: 220px; }
        .gc-hint { font-size: 12px; color: #9aa4b1; margin-top: 4px; line-height: 1.6; }
        .gc-guide { margin: 0 0 14px; padding: 10px 12px; border: 1px solid #dce8ff; border-radius: 6px; background: #f7faff; color: #526173; font-size: 12px; line-height: 1.7; }
        .gc-refresh { width: 30px; height: 30px; line-height: 30px; text-align: center; border-radius: 6px; color: #5a6573; cursor: pointer; transition: background .15s, color .15s; }
        .gc-refresh:hover { background: #ecf2ff; color: #2f6fed; }
        .gc-refresh .fa { margin: 0; color: inherit; }
        .gc-newbtn { font-size: 12px; font-weight: 500; color: #2f6fed; cursor: pointer; padding: 3px 10px; border: 1px solid #cdd9f7; border-radius: 14px; background: #f5f8ff; }
        .gc-newbtn:hover { background: #2f6fed; color: #fff; border-color: #2f6fed; }
        .gc-newbtn .fa { margin-right: 4px; color: inherit; }
        .gc-para-empty { display: none; padding: 72px 24px; text-align: center; }
        .gc-para-empty-icon { width: 88px; height: 88px; line-height: 88px; margin: 0 auto 20px; border-radius: 50%; background: linear-gradient(135deg, #eef3ff, #f7faff); color: #2f6fed; font-size: 42px; box-shadow: inset 0 0 0 1px #e2ebff; }
        .gc-para-empty-title { font-size: 16px; font-weight: 600; color: #5a6573; margin-bottom: 8px; }
        .gc-para-empty-text { font-size: 13px; color: #9aa4b1; max-width: 380px; margin: 0 auto; line-height: 1.7; }
        .gc-switch-inline { display: flex; align-items: center; height: 36px; gap: 12px; }
        .gc-switch-inline .gc-switch-label { margin-left: 0; }
    </style>
}
<div class="gc-wrap">
    <div id="gcEncodingNotice" class="gc-tip" data-encoding="UTF-8-BOM">本视图文件必须保存为 UTF-8 带签名(BOM) 编码，避免中文乱码与路由异常。</div>

    <div class="gc-toolbar">
        <span class="gc-lbl">游戏类型：</span>
        <select id="gcTypeSel" class="gc-select">
            <option value="-1">请选择类型</option>
        </select>
        <span class="gc-lbl">选择游戏：</span>
        <select id="gcGameSel" class="gc-select"></select>
    </div>

    <div class="gc-grid">
        <div class="gc-card gc-left">
            <div class="gc-card-hd">
                <span><i class="fa fa-th-list"></i>桌台列表</span>
                <a href="javascript:;" id="gcNewTable" class="gc-newbtn" title="新建桌台"><i class="fa fa-plus"></i>新建桌台</a>
            </div>
            <div class="gc-card-bd" style="padding:0;">
                <ul id="gcTableList" class="gc-tablelist"></ul>
                <div id="gcTableEmpty" class="gc-empty">请选择上方游戏以加载桌台。</div>
            </div>
        </div>

        <div class="gc-card gc-right">
            <div class="gc-card-hd">
                <span><i class="fa fa-sliders"></i>桌台参数</span>
                <span style="display:flex;align-items:center;gap:6px;">
                    <span id="gcCurTableName" style="font-size:13px;color:#9aa4b1;font-weight:400;"></span>
                    <a href="javascript:;" id="gcRefresh" class="gc-refresh" title="刷新桌台参数"><i class="fa fa-refresh"></i></a>
                    <a href="javascript:;" id="gcDelete" class="gc-refresh" title="彻底删除该桌台"><i class="fa fa-trash"></i></a>
                </span>
            </div>
            <div class="gc-card-bd">
                <div id="gcParaEmpty" class="gc-para-empty">
                    <div class="gc-para-empty-icon"><i class="fa fa-gamepad"></i></div>
                    <div class="gc-para-empty-title">尚未选择游戏</div>
                    <div class="gc-para-empty-text">请先在上方选择「游戏类型」与「游戏」，选定后即可配置该游戏的桌台参数。</div>
                </div>
                <form id="gcForm">
                    <div class="gc-guide"><strong>填写提示：</strong>押注/牌机类的“出现机会/权重”是相对值，不是百分比（例如 A=200、B=100，A 约是 B 的 2 倍机会）；<strong>拉霸中奖配置统一在“拉霸出货权重与理论 RTP”中独立保存</strong>。带“×100、×10000、万分比”的参数请按示例填写；留空、0 和默认值的含义以字段下方说明为准。</div>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="gcId" name="ID" value="-1" />
                    <input type="hidden" id="gcGameId" name="GAME_ID" value="-1" />
                    <input type="hidden" id="gcGameType" name="GAME_TYPE" value="-1" />

                    <div class="gc-common gc-base-info">
                    <div class="gc-section-title">基础信息</div>
                    <div class="gc-form-row">
                        <div class="gc-field">
                            <label>桌名</label>
                            <input type="text" id="gcTableName" name="TableName" class="gc-input" maxlength="64" placeholder="请输入桌名" />
                        </div>
                        <div class="gc-field">
                            <label>是否开放给玩家</label>
                            <div class="gc-switch-inline">
                                <label class="gc-switch">
                                    <input type="checkbox" id="gcEnabled" checked />
                                    <span class="gc-slider"></span>
                                </label>
                                <span class="gc-switch-label">关闭后该桌台不再展示给玩家</span>
                            </div>
                            <input type="hidden" id="gcEnabledVal" name="Enabled" value="1" />
                        </div>
                    </div>
                    </div>

                    <div class="gc-common gc-bet-exchange">
                    <div class="gc-section-title">下注金额与兑换规则</div>
                    <div class="gc-form-row">
                        <div class="gc-field">
                            <label id="gcMinBetLbl">单次最低下注</label>
                            <input type="number" id="gcMinBet" name="MinBet" class="gc-input" step="0.1" min="0" value="0" />
                        </div>
                        <div class="gc-field">
                            <label id="gcMaxBetLbl">单次最高下注</label>
                            <input type="number" id="gcMaxBet" name="MaxBet" class="gc-input" step="0.1" min="0" value="0" />
                        </div>
                    </div>
                    <div class="gc-form-row">
                        <!-- 兑换单位/兑换金币数：全类型(押注/牌机/鱼机/拉霸)隐藏，仅随表单提交保留（gcFill 仍按 base 行值回填，保存写回原值，功能保留） -->
                        <div class="gc-field" style="display:none">
                            <label>兑换单位</label>
                            <input type="number" id="gcExCoin" name="EX_COIN" class="gc-input" min="1" value="1" />
                        </div>
                        <div class="gc-field">
                            <label>每个游戏币对应的分值</label>
                            <input type="number" id="gcCoinSc" name="COIN_SC" class="gc-input" min="1" value="1" />
                        </div>
                        <div class="gc-field" style="display:none">
                            <label>兑换金币数</label>
                            <input type="number" id="gcGameMo" name="Game_Mo" class="gc-input" min="0" value="0" />
                        </div>
                        <div class="gc-field">
                            <label>进入房间所需金币</label>
                            <input type="number" id="gcCoinNeed" name="COIN_NEED" class="gc-input" min="0" value="0" />
                        </div>
                        <div class="gc-field gc-only-1 gc-only-2 gc-only-3">
                            <label id="gcScoreSwitchLbl">加炮幅度（0.1-0.9）</label>
                            <input type="number" id="gcScoreSwitch" name="scoreSwitch" class="gc-input" step="0.1" min="0" value="0" />
                        </div>
                    </div>
                    </div>

                    <div class="gc-only-0">
                        <div class="gc-section-title">押注规则与限额</div>
                        <div class="gc-hint">限红就是“这一局最多能押多少分”：单门限红限制某一个选项，全台总分限红限制所有选项合计。不同游戏可能使用不同的押分区域。</div>
                        <div class="gc-form-row">
                            <div class="gc-field">
                                <label>单局押分倒计时(秒)</label>
                                <input type="number" id="gcBetTime" name="BET_TIME" class="gc-input" min="1" step="1" value="10" />
                            </div>
                            <div class="gc-field">
                                <label>单门最大限红</label>
                                <input type="number" id="gcScLimitSing" name="SC_LIMIT_SING" class="gc-input" min="0" step="1" value="3000" />
                            </div>
                            <div class="gc-field">
                                <label>全台总分限红</label>
                                <input type="number" id="gcScLimitAll" name="SC_LIMIT_ALL" class="gc-input" min="0" step="1" value="10000" />
                            </div>
                        </div>
                        <div class="gc-form-row gc-bet-banker-row">
                            <div class="gc-field">
                                <label>申请当庄所需最低金币（0=关闭抢庄）</label>
                                <input type="number" id="gcBankerScNeed" name="BANKER_SC_NEED" class="gc-input" min="0" step="1" value="500000" />
                            </div>
                        </div>
                        <div class="gc-form-row gc-bet-banker-row">
                            <div class="gc-field">
                                <label>庄家抽水比例（%）</label>
                                <input type="number" id="gcBankerPer" class="gc-input" min="0" max="9.9" step="0.1" value="3" />
                                <input type="hidden" id="gcBankerPerRaw" name="BANKER_PER" value="30" />
                            </div>
                        </div>
                        <div class="gc-hint" id="gcBankerPerHint">庄家抽水是从庄家每局净赢利（玩家总投注 − 玩家总赔付）中提取的比例，不是额外向玩家扣款；仅抢庄玩法生效，0 表示不抽水。填 3 就是 3%。</div>
                        <div class="gc-form-row" id="gcViceDrawRow">
                            <div class="gc-field" id="gcViceMaxField">
                                <label id="gcViceMaxLbl">庄/闲单门最高押分</label>
                                <input type="number" id="gcBetMaxVice" name="BET_MAX_VICE" class="gc-input" min="0" step="1" value="1000" />
                            </div>
                            <div class="gc-field" id="gcViceMinField">
                                <label>皇冠单次最低押分</label>
                                <input type="number" id="gcBetMinVice" name="BET_MIN_VICE" class="gc-input" min="0" step="1" value="10" />
                            </div>
                            <div class="gc-field" id="gcDrawMaxField">
                                <label>和单门最高押分</label>
                                <input type="number" id="gcBetMaxDraw" name="BET_MAX_DRAW" class="gc-input" min="0" step="1" value="1000" />
                            </div>
                        </div>
                        <div class="gc-hint" id="gcViceDrawHint">庄/闲、和、皇冠分别代表不同押分区域；这些限额按桌保存，仅对幸运六狮、彩金单挑生效。</div>

                        <div class="gc-section-title">特殊结果与奖励出现机会</div>
                        <div id="gcBetSpecBox"></div>

                        <div class="gc-section-title">各下注选项的赔率与出现机会（用于返奖率估算）</div>
                        <div class="gc-hint">这张表帮助估算长期返奖率：赔率是中奖后返还倍数，出现机会是相对比例。当前服务端仍按内置倍率开奖，修改这里主要用于试算和保存预留，不代表一定会改变实际开奖。</div>
                        <div id="gcBetDoorBox"></div>
                        <div class="gc-hint" id="gcBetDoorHint"></div>
                        <input type="hidden" id="gcBetGameCfg" name="BetGameCfg" value="" />

                    </div>

                    @*快捷下注金额（1~5 级筹码）：押注类与拉霸类共用同一套输入与保存字段(隐藏域 BetScores)。
                      押注类按桌落 roomtableconfig_bet（彩金单挑等）；拉霸类同样按桌落 roomtableconfig_bet（复用同一管道）。*@
                    <div class="gc-only-0 gc-only-3">
                        <div class="gc-section-title">快捷下注金额（一到五级筹码）</div>
                        <div class="gc-hint">五档筹码为整数倍率/金额，按桌独立保存并随桌台参数下发客户端；留空或不填视为未配置（客户端回退房间级默认筹码）。</div>
                        <div class="gc-form-row">
                            <div class="gc-field">
                                <label>默认筹码</label>
                                <input type="number" id="gcChip0" class="gc-input gc-chip" min="0" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>二级筹码</label>
                                <input type="number" id="gcChip1" class="gc-input gc-chip" min="0" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>三级筹码</label>
                                <input type="number" id="gcChip2" class="gc-input gc-chip" min="0" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>四级筹码</label>
                                <input type="number" id="gcChip3" class="gc-input gc-chip" min="0" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>五级筹码</label>
                                <input type="number" id="gcChip4" class="gc-input gc-chip" min="0" value="0" />
                            </div>
                        </div>
                        <input type="hidden" id="gcBetScores" name="BetScores" value="" />
                    </div>

                        @*机台设定（系统/庄家难度）：按需求隐藏，字段保留在表单中以维持保存值不被重置*@
                        <div style="display:none;">
                        <div class="gc-section-title">机台设定（系统/庄家难度）</div>
                        <div class="gc-form-row">
                            <div class="gc-field">
                                <label>系统难度</label>
                                <input type="number" id="gcDif" name="DIF" class="gc-input" min="0" max="9" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>系统加难</label>
                                <input type="number" id="gcHar" name="HAR" class="gc-input" min="0" max="9" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>系统起伏</label>
                                <input type="number" id="gcSiteType" name="SITE_TYPE" class="gc-input" min="0" max="2" value="0" />
                            </div>
                        </div>
                        <div class="gc-form-row">
                            <div class="gc-field">
                                <label>庄家难度</label>
                                <input type="number" id="gcBankerDif" name="BANKER_DIF" class="gc-input" min="0" max="9" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>庄家加难</label>
                                <input type="number" id="gcBankerHar" name="BANKER_HAR" class="gc-input" min="0" max="9" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>庄家起伏</label>
                                <input type="number" id="gcBankerSiteType" name="BANKER_SITE_TYPE" class="gc-input" min="0" max="2" value="0" />
                            </div>
                        </div>
                        </div>

                    <div class="gc-only-1">
                        <div class="gc-section-title">机台设定（牌型出现机会与固定奖励倍数）</div>
                        <input type="hidden" id="gcPayoutOnVal" name="PayoutOn" value="1" />
                        <table style="width:100%;border-collapse:collapse;margin-bottom:14px;" id="gcPayoutTable">
                            <thead>
                                <tr style="background:#f5f8ff;color:#5a6573;font-size:13px;">
                                    <th style="padding:8px;border:1px solid #e5e9f0;text-align:left;">牌型</th>
                                    <th style="padding:8px;border:1px solid #e5e9f0;">出现机会（每 10000 次的相对单位）</th>
                                    <th style="padding:8px;border:1px solid #e5e9f0;">倍数（客户端写死 · 不可调；点石成金/ATT满花版 为小 / 中 / 大）</th>
                                    <th style="padding:8px;border:1px solid #e5e9f0;width:64px;">启用</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <div class="gc-hint" id="gcPayoutSum">倍数由程序固定，页面只展示不能调整；出现机会填 100，表示使用相对权重 100，并不等于固定 1%。</div>

                        <div class="gc-section-title" style="margin-top:16px;">机台设定（鬼牌数量出现机会）</div>
                        <input type="hidden" id="gcJokerOnVal" name="JokerOn" value="0" />
                        <div class="gc-form-row">
                            <div class="gc-field">
                                <label><input type="checkbox" id="gcJokerOn" /> 启用鬼牌数量出现机会（停用时按机台难度档位的原逻辑出鬼）</label>
                            </div>
                        </div>
                        <div class="gc-form-row">
                            <div class="gc-field">
                                <label>1 王出现机会（每 10000 次的相对单位）</label>
                                <input type="number" id="gcJk1" name="jk1" class="gc-input gc-joker-p" min="0" max="10000" step="1" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>2 王出现机会（每 10000 次的相对单位）</label>
                                <input type="number" id="gcJk2" name="jk2" class="gc-input gc-joker-p" min="0" max="10000" step="1" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>3 王出现机会（每 10000 次的相对单位）</label>
                                <input type="number" id="gcJk3" name="jk3" class="gc-input gc-joker-p" min="0" max="10000" step="1" value="0" />
                            </div>
                        </div>
                        <div class="gc-hint" id="gcJokerSum">说明：作用于可变分支的全局出鬼权重；各牌型硬约束不变（两对永远无鬼、五鬼固定 5 鬼、正宗大四梅无鬼、各牌型鬼数上下限自动限幅）。</div>

                        <div id="gcGfBox" style="display:none;">
                            <div class="gc-section-title" style="margin-top:16px;">机台设定（金拇指 / 彩金权重 · 仅 ATT满花版）</div>
                            <input type="hidden" id="gcGfOnVal" name="GoldFingerOn" value="0" />
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label><input type="checkbox" id="gcGfOn" /> 启用金拇指（杂牌局按机会触发，玩家五选一翻牌领奖）</label>
                                </div>
                            </div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label>金拇指触发机会（杂牌局每 10000 次）</label>
                                    <input type="number" id="gcGf" name="gf" class="gc-input" min="0" max="10000" step="1" value="0" />
                                </div>
                            </div>
                            <div class="gc-hint" id="gcGfSum"></div>
                            <input type="hidden" id="gcDpOnVal" name="DiamondFlushOn" value="0" />
                            <input type="hidden" id="gcArOnVal" name="AllRoyalOn" value="0" />
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label><input type="checkbox" id="gcDpOn" /> 启用方块彩金出货权重（同花系无鬼局按权重染成方块领彩金）</label>
                                </div>
                            </div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label>方块彩金出货权重（满足条件的局每 10000 次）</label>
                                    <input type="number" id="gcDp" name="dp" class="gc-input" min="0" max="10000" step="1" value="0" />
                                </div>
                            </div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label><input type="checkbox" id="gcArOn" /> 启用满花彩金出货权重（可全高脸牌型无鬼局按权重改写正宗满花）</label>
                                </div>
                            </div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label>满花彩金出货权重（满足条件的局每 10000 次）</label>
                                    <input type="number" id="gcAr" name="ar" class="gc-input" min="0" max="10000" step="1" value="0" />
                                </div>
                            </div>
                            <div class="gc-hint" id="gcPoolWSum"></div>
                        </div>

                        <div id="gcJpBox" style="display:none;">
                            <div class="gc-section-title" style="margin-top:16px;">彩金奖池（程序固定规则，仅供查看）</div>
                            <div class="gc-hint" id="gcJpRule" style="margin-bottom:8px;"></div>
                            <table style="width:100%;border-collapse:collapse;margin-bottom:14px;" id="gcJpTable">
                                <thead>
                                    <tr style="background:#f5f8ff;color:#5a6573;font-size:13px;">
                                        <th style="padding:8px;border:1px solid #e5e9f0;text-align:left;">独立奖池牌型</th>
                                        <th style="padding:8px;border:1px solid #e5e9f0;">保底分（领奖后重置下限）</th>
                                        <th style="padding:8px;border:1px solid #e5e9f0;" id="gcJpTh3">奖池累计上限</th>
                                        <th style="padding:8px;border:1px solid #e5e9f0;" id="gcJpTh4" class="gc-jp-nba">三王额外奖（固定倍数×押分）</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                            <div class="gc-section-title" style="margin-top:6px;">本机台奖池分数（可设置，游戏服重启后生效）</div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label>五梅 5.K. 奖池分</label>
                                    <input type="number" id="gcJp5K" name="JP_5K" class="gc-input gc-jp-v" min="0" max="2000000000" step="1" />
                                </div>
                                <div class="gc-field">
                                    <label>同花大顺 R.S. 奖池分</label>
                                    <input type="number" id="gcJpRS" name="JP_RS" class="gc-input gc-jp-v" min="0" max="2000000000" step="1" />
                                </div>
                            </div>
                            <div class="gc-form-row">
                                <div class="gc-field">
                                    <label>同花顺 S.F. 奖池分</label>
                                    <input type="number" id="gcJpSF" name="JP_SF" class="gc-input gc-jp-v" min="0" max="2000000000" step="1" />
                                </div>
                                <div class="gc-field">
                                    <label>四梅 4.K. 奖池分</label>
                                    <input type="number" id="gcJp4K" name="JP_4K" class="gc-input gc-jp-v" min="0" max="2000000000" step="1" />
                                </div>
                            </div>
                            <div class="gc-form-row" id="gcJpMhbRow" style="display:none;">
                                <div class="gc-field">
                                    <label>方块彩金 F.L. 奖池分</label>
                                    <input type="number" id="gcJpDIA" name="JP_DIA" class="gc-input gc-jp-v" min="0" max="2000000000" step="1" />
                                </div>
                                <div class="gc-field">
                                    <label>满花彩金 BONI 奖池分</label>
                                    <input type="number" id="gcJpAR" name="JP_AR" class="gc-input gc-jp-v" min="0" max="2000000000" step="1" />
                                </div>
                            </div>
                            <div class="gc-hint" id="gcJpInfo"></div>
                        </div>
                        <div class="gc-section-title" style="margin-top:16px;display:none;">高级（旧版兼容）</div>
                        <div class="gc-form-row" style="display:none;">
                            <div class="gc-field">
                                <label>炒场类型</label>
                                <input type="number" id="gcHypeType" name="HYPE_TYPE" class="gc-input" min="0" value="0" />
                            </div>
                            <div class="gc-field">
                                <label>牌机难度（16 位数字，停用上表时生效）</label>
                                <input type="text" id="gcCardDif" name="CardDIF" class="gc-input" maxlength="16" placeholder="16 位数字，如 0000000000000000" />
                            </div>
                        </div>
                    </div>

                    <div class="gc-only-2">
                        <div class="gc-section-title">机台设定（鱼的最高可获得倍率）</div>
                        <div class="gc-form-row">
                            <div class="gc-field">
                                <label>单条鱼最高奖励倍率</label>
                                <select id="gcFishDif" name="FishDIF" class="gc-select">
                                    <option value="0">0 级：不限制最高倍率</option>
                                    <option value="1">1 级：上限 1000</option>
                                    <option value="2">2 级：上限 300</option>
                                    <option value="3">3 级：上限 200</option>
                                    <option value="4">4 级：上限 100</option>
                                    <option value="5">5 级：上限 40</option>
                                    <option value="6">6 级：上限 30</option>
                                    <option value="7">7 级：上限 25</option>
                                    <option value="8">8 级：上限 20</option>
                                    <option value="9">9 级：上限 18</option>
                                </select>
                            </div>
                            <div class="gc-field" style="display:none;">
                                <label>场地类型</label>
                                <select id="gcFishSiteType" name="FishSITE_TYPE" class="gc-select">
                                    <option value="0">0 级：大场地</option>
                                    <option value="1" selected>1 级：中场地</option>
                                    <option value="2">2 级：小场地</option>
                                    <option value="3">3 级：标准场</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    @Html.Partial("_LabaWeights")
                    <div class="gc-common">
                    <div class="gc-section-title">玩法与闲置处理</div>
                    <div class="gc-form-row">
                        <div class="gc-field">
                            <label>连续不发炮多久后移出（分钟）</label>
                            <input type="number" id="gcIdleSec" name="IdleFireTimeoutSec" class="gc-input" min="0" value="0" />
                            <span class="gc-switch-label">默认开启：玩家长时间不发炮将被踢出，0 表示不踢出</span>
                            <input type="hidden" id="gcIdleKickVal" name="IdleFireKickEnabled" value="1" />
                        </div>
                    </div>
                    </div>
                </form>
            </div>
            <div class="gc-foot" id="gcParaFoot">
                <button type="button" id="gcReset" class="gc-btn gc-btn-default">恢复默认</button>
                <button type="button" id="gcSave" class="gc-btn gc-btn-primary">保存并热更新</button>
            </div>
        </div>
    </div>
</div>

<script>
    var GC_URL = {
        gameList: '@Url.Action("GetGameList", "GameConfig", new { area = "Game" })',
        tableConfig: '@Url.Action("GetTableConfig", "GameConfig", new { area = "Game" })',
        save: '@Url.Action("SaveTableConfig", "GameConfig", new { area = "Game" })',
        delete: '@Url.Action("DeleteTableConfig", "GameConfig", new { area = "Game" })'
    };
    var GC_GAMES = [];
    var GC_TABLES = [];
    var GC_TYPE_META = [
        { v: 2, t: '鱼机类型' },
        { v: 0, t: '押注类型' },
        { v: 1, t: '牌机类型' },
        { v: 3, t: '拉霸类型' }
    ];

    function gcGetType() { return parseInt($('#gcGameType').val(), 10); }

    // 加芬幅度归一化: 鱼机(2) 最小 0.1, 其它类型最小 1 且必须整数
    function gcNormSs(val, type) {
        var v = parseFloat(val);
        if (type === 2) {
            if (isNaN(v) || v < 0.1) v = 0.1;
            return Math.round(v * 10) / 10;
        }
        v = Math.round(v);
        if (isNaN(v) || v < 1) v = 1;
        return v;
    }

    // 统一反馈：成功/失败/校验用顶部自动消失的 toast；登录超时(code=-1)仍保留模态以便重新登录
    function gcMsg(data) {
        if (data && data.code == -1) { loginTimeoutCallback(data); return; }
        var text = data ? (data.msg ? data.msg : data.content) : '操作失败！';
        showToast(text, (data && data.code == 1) ? 'success' : 'error');
    }

    function gcLoadGames() {
        request(GC_URL.gameList, {}, function (list) {
            GC_GAMES = list || [];
            gcBuildTypeSel();
            gcFillGameSel();
        });
    }

    function gcBuildTypeSel() {
        var $sel = $('#gcTypeSel');
        var cur = $sel.val();
        $sel.empty();
        $sel.append('<option value="-1">请选择类型</option>');
        $.each(GC_TYPE_META, function (i, m) {
            var has = $.grep(GC_GAMES, function (g) { return parseInt(g.gameType, 10) === m.v; }).length > 0;
            if (has) $sel.append('<option value="' + m.v + '">' + m.t + '</option>');
        });
        if (cur !== null && $sel.find('option[value="' + cur + '"]').length > 0) $sel.val(cur);
    }

    function gcFillGameSel() {
        var type = parseInt($('#gcTypeSel').val(), 10);
        var $sel = $('#gcGameSel');
        $sel.empty();
        gcClearTables();
        if (isNaN(type) || type < 0) {
            $sel.append('<option value="-1">请先选择游戏类型</option>');
            return;
        }
        var games = $.grep(GC_GAMES, function (g) { return parseInt(g.gameType, 10) === type; });
        if (games.length < 1) {
            $sel.append('<option value="-1">该类型暂无已开启游戏</option>');
            return;
        }
        $sel.append('<option value="-1">请选择游戏</option>');
        $.each(games, function (i, g) {
            // 下拉按 gameType（展示口径）归类；data-type 取 paraType（参数配置口径，
            // 麻将胡了分类为牌机但参数走拉霸路径，后续 GetTableConfig/保存须下发 3）。
            var pt = (typeof g.paraType != 'undefined' && g.paraType !== null) ? g.paraType : g.gameType;
            $sel.append('<option value="' + g.id + '" data-type="' + pt + '">' + g.text + '</option>');
        });
    }

    function gcClearTables() {
        GC_TABLES = [];
        $('#gcTableList').empty();
        $('#gcTableEmpty').show().text('请选择上方游戏以加载桌台。');
        $('#gcCurTableName').text('');
        $('#gcId').val(-1);
        gcSetParaVisible(false);
    }

    function gcSetParaVisible(visible) {
        if (visible) {
            $('#gcParaEmpty').hide();
            $('#gcForm').show();
            $('#gcParaFoot').show();
        } else {
            $('#gcParaEmpty').show();
            $('#gcForm').hide();
            $('#gcParaFoot').hide();
            $('#gcCurTableName').text('');
        }
    }

    function gcLatestTable() {
        if (!GC_TABLES || GC_TABLES.length < 1) return null;
        var latest = GC_TABLES[0];
        $.each(GC_TABLES, function (i, t) {
            if (parseInt(t.id, 10) > parseInt(latest.id, 10)) latest = t;
        });
        return latest;
    }

    function gcRenderTableList() {
        var $list = $('#gcTableList');
        $list.empty();
        if (GC_TABLES.length < 1) {
            $('#gcTableEmpty').show().text('该游戏暂无桌台，填写参数后点击右上角“新建桌台”。');
            return;
        }
        $('#gcTableEmpty').hide();
        $.each(GC_TABLES, function (i, t) {
            var pill = t.enabled == 1
                ? '<span class="gc-pill gc-pill-on">启用</span>'
                : '<span class="gc-pill gc-pill-off">停用</span>';
            $list.append('<li data-idx="' + i + '" data-id="' + t.id + '"><span>' + t.tableName + '</span>' + pill + '</li>');
        });
    }

    function gcSelectTableById(id) {
        var found = -1;
        $.each(GC_TABLES, function (i, t) { if (parseInt(t.id, 10) === parseInt(id, 10)) found = i; });
        if (found < 0) { gcNewTable(); return; }
        $('#gcTableList li').removeClass('active');
        $('#gcTableList li[data-idx="' + found + '"]').addClass('active');
        gcFill(GC_TABLES[found]);
    }

    // 拉霸子类型（与后端 GetLabaSubType 对齐）：53=水浒传 16=明星97 40=水果拉霸
    function gcLabaSubType() {
        var gameId = parseInt($('#gcGameSel').val(), 10);
        if (gameId === 53) return 3;
        if (gameId === 16) return 1;
        if (gameId === 40) return 2;
        return 0;
    }

    // 庄闲/和(幸运六狮)、皇冠(彩金单挑)限红：按游戏动态显示与改名；
    // 其余押注玩法无副玩法/和门，整行隐藏并禁用 input，避免 serializeObject 误提交覆盖库值
    function gcApplyViceDraw() {
        var gid = parseInt($('#gcGameSel').val(), 10);
        var lion = (gid === 10), crown = (gid === 2);
        var show = lion || crown;
        $('#gcViceDrawRow').toggle(show);
        $('#gcViceDrawHint').toggle(show);
        if (show) {
            $('#gcViceMaxLbl').text(crown ? '皇冠单次最高押分' : '庄/闲单门最高押分');
            $('#gcViceMinField').toggle(crown);
            $('#gcDrawMaxField').toggle(lion);
            // 幸运六狮的庄/闲、和不单独配最小押分：跟随上面的「最低压分」，这里只配单门最高押分
            $('#gcViceDrawHint').text(crown
                ? '皇冠代表副玩法押分区域；限额按桌保存，仅对彩金单挑生效。'
                : '庄/闲、和的最小押分跟随上面的「最低压分」（不单独配置），这里只配两者的单门最高押分；限额按桌保存，仅对幸运六狮生效。');
        }
        $('#gcViceDrawRow input').prop('disabled', !show);
    }

    function gcApplyType() {
        if (window.labaWeightsClear) window.labaWeightsClear();
        var type = gcGetType();
        $('.gc-only-0,.gc-only-1,.gc-only-2,.gc-only-3').hide();
        $('.gc-common').show();
        $('.gc-base-info').show();
        if (type >= 0 && type <= 3) {
            $('.gc-only-' + type).show();
            if (type === 0) {
                $('#gcMinBetLbl').text('最低压分');
                $('#gcMaxBetLbl').text('最高压分');
            } else {
                $('#gcMinBetLbl').text('最小押分');
                $('#gcMaxBetLbl').text('最大押分');
            }
            $('#gcScoreSwitchLbl').text((type === 1 || type === 3) ? '每次增加的分值' : '每次提升的炮值（0.1-0.9）');
            var gcSsMin = (type === 2) ? 0.1 : 1;
            $('#gcScoreSwitch').attr('step', (type === 2) ? '0.1' : '1');
            $('#gcScoreSwitch').attr('min', (type === 2) ? '0.1' : '1');
            $('#gcScoreSwitch').val(gcNormSs($('#gcScoreSwitch').val(), type));
            if (type === 1 && $('#gcPayoutTable tbody tr').length === 0) gcBuildPayoutTable();
            if (type === 1) gcUpdateJpBox(); else $('#gcJpBox').hide();
            gcSyncGoldFinger();
            if (type === 0) gcBuildBetSpec();
        }
        // 三个拉霸（明星97/水果机/水浒传）最小/最大押分只能为整数（步进 1；保存时另有整数校验）
        $('#gcMinBet').attr('step', gcLabaSubType() > 0 ? '1' : '0.1');
        $('#gcMaxBet').attr('step', gcLabaSubType() > 0 ? '1' : '0.1');
        gcApplyViceDraw();
        $('#gcNewTable').toggle(true);
    }

    function gcUpdateSaveBtn() {
        var isNew = parseInt($('#gcId').val(), 10) < 0;
        $('#gcSave').text(isNew ? '新建桌台' : '更新桌台');
    }

    function gcLoadTables(afterLoad) {
        var requestSeq = (gcLoadTables.requestSeq || 0) + 1;
        gcLoadTables.requestSeq = requestSeq;
        var gameId = parseInt($('#gcGameSel').val(), 10);
        var gameType = parseInt($('#gcGameSel').find('option:selected').attr('data-type'), 10);
        $('#gcGameId').val(isNaN(gameId) ? -1 : gameId);
        $('#gcGameType').val(isNaN(gameType) ? -1 : gameType);
        gcApplyType();
        $('#gcTableList').empty();
        GC_TABLES = [];
        if (isNaN(gameId) || gameId < 0) {
            $('#gcTableEmpty').show().text('请选择上方游戏以加载桌台。');
            $('#gcCurTableName').text('');
            $('#gcId').val(-1);
            gcSetParaVisible(false);
            gcUpdateSaveBtn();
            return;
        }
        request(GC_URL.tableConfig, { GAME_ID: gameId, GAME_TYPE: gameType }, function (data) {
            var currentGameId = parseInt($('#gcGameSel').val(), 10);
            var currentGameType = parseInt($('#gcGameSel').find('option:selected').attr('data-type'), 10);
            if (requestSeq !== gcLoadTables.requestSeq || currentGameId !== gameId || currentGameType !== gameType) {
                return;
            }
            if (!data || data.code != 1) {
                gcMsg(data);
                return;
            }
            GC_TABLES = data.datas || [];
            gcRenderTableList();
            gcSetParaVisible(true);
            if (typeof afterLoad === 'function') afterLoad();
            else if (gameType === 3) {
                if (GC_TABLES.length > 0) gcSelectTableById(GC_TABLES[0].id);
            }
            else gcNewTable();
        });
    }

    function gcFill(t) {
        if (!t) return;
        var type = gcGetType();
        $('#gcId').val(t.id);
        $('#gcTableName').val(t.tableName);
        $('#gcMinBet').val(t.minBet);
        $('#gcMaxBet').val(t.maxBet);
        $('#gcCoinSc').val(t.coinSc);
        $('#gcExCoin').val(t.exCoin);
        $('#gcCoinNeed').val(t.coinNeed);
        $('#gcGameMo').val(t.gameMo);
        var gcFillSs = (t.scoreSwitch !== undefined && t.scoreSwitch !== null) ? t.scoreSwitch : 0;
        gcFillSs = gcNormSs(gcFillSs, type);
        $('#gcScoreSwitch').val(gcFillSs);
        $('#gcIdleSec').val(t.idleFireTimeoutSec);
        $('#gcEnabled').prop('checked', t.enabled == 1);
        if (type === 0) {
            gcFillBetSpec(t);
            $('#gcBetTime').val(t.betTime !== undefined ? t.betTime : 10);
            $('#gcScLimitSing').val(t.scLimitSing !== undefined ? t.scLimitSing : 3000);
            $('#gcScLimitAll').val(t.scLimitAll !== undefined ? t.scLimitAll : 10000);
            $('#gcBankerScNeed').val(t.bankerScNeed !== undefined ? t.bankerScNeed : 500000);
            $('#gcBetMaxVice').val(t.betMaxVice !== undefined ? t.betMaxVice : 1000);
            $('#gcBetMaxDraw').val(t.betMaxDraw !== undefined ? t.betMaxDraw : 1000);
            $('#gcBetMinVice').val(t.betMinVice !== undefined ? t.betMinVice : 10);
            $('#gcDif').val(t.dif);
            $('#gcHar').val(t.har);
            $('#gcSiteType').val(t.siteType);
            $('#gcBankerDif').val(t.bankerDif);
            $('#gcBankerHar').val(t.bankerHar);
            $('#gcBankerSiteType').val(t.bankerSiteType);
            // 庄家抽水：库内千分比 → 页面百分比显示（30 = 3%）
            var bpVal = (t.bankerPer !== undefined && t.bankerPer !== null) ? t.bankerPer : 30;
            $('#gcBankerPer').val(bpVal / 10);
            $('#gcBankerPerRaw').val(bpVal);
            gcFillChips(t.betScores);
        } else if (type === 1) {
            $('#gcHypeType').val(t.hypeType);
            $('#gcCardDif').val(t.cardDif);
            gcFillPayout(t);
        } else if (type === 2) {
            $('#gcFishDif').val(t.fishDif);
            $('#gcFishSiteType').val(1); // 场地类型已隐藏，固定中场地(1)
        } else if (type === 3) {
            // 拉霸按桌筹码档位(1~5级)：与押注类同管道(roomtableconfig_bet)，回填五个输入框
            gcFillChips(t.betScores);
        }
        if (window.labaWeightsLoad) window.labaWeightsLoad();
        $('#gcCurTableName').text('当前编辑：' + t.tableName);
        gcSyncSwitch();
        gcUpdateSaveBtn();
    }

    function gcFillChips(scores) {
        var arr = (scores || '').split(',');
        for (var i = 0; i < 5; i++) {
            var v = (i < arr.length && arr[i] !== '') ? arr[i] : 0;
            $('#gcChip' + i).val(v);
        }
    }

    function gcCollectChips() {
        var arr = [];
        for (var i = 0; i < 5; i++) {
            var v = parseInt($('#gcChip' + i).val(), 10);
