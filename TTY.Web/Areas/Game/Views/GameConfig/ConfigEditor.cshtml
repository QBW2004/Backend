    // 拉霸子类型（与后端 GetLabaSubType 对齐）：53=水浒传 16=明星97 40=水果拉霸
    function gcLabaSubType() {
        var gameId = parseInt($('#gcGameSel').val(), 10);
        if (gameId === 53) return 3;
        if (gameId === 16) return 1;
        if (gameId === 40) return 2;
        return 0;
    }

    // 服务端默认出现率(p, 百万分比) → 每 10000 相对单位占位文案（保留有效精度；p=0 时≈0）
    function gcDefRateText(p) {
        if (!p) return '≈0';
        var perWan = p / 100;
        if (perWan >= 100) return '' + Math.round(perWan);
        if (perWan >= 10) return perWan.toFixed(1);
        return perWan.toFixed(2);
    }

    // 结果类表"不中奖（余量）"计算（类似牌机的杂牌行）：
    // 绝对出现率语义：出现机会=每 10000 次实际出现次数，未命中任何奖励的余量即为"不中奖"，
    // 故 不中奖 = 10000 − Σ出现机会。留空行使用服务端内置默认出现率(p÷100)参与估算
    // （占位符即该值）；结果>10000 时无"不中奖"余量（全部为奖励），仅红字提示不拦截。
    function gcUpdateNoWinRow(sel, $cell) {
        var sum = 0;
        $(sel).each(function () {
            var v = parseFloat($(this).val());
            if (isNaN(v) || v <= 0) v = parseFloat($(this).attr('placeholder')) || 0;
            sum += v;
        });
        var remain = Math.round(10000 - sum);
        $cell.text(remain >= 0 ? remain : '奖励合计 ' + Math.round(sum) + ' 已超 10000（相对权重合法）');
        $cell.css('color', remain < 0 ? '#d33b3b' : (remain < 1000 ? '#c98f2b' : '#2e9e5b'));
        return sum;
    }

    // 刷新两张结果类表的"不中奖（余量）"行（清空/重置等不触发 input 事件时调用）
    function gcRefreshNoWinRows() {
