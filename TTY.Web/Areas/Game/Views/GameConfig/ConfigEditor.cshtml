@{
    Layout = "~/Views/Shared/Layout/_ContentLayout.cshtml";
    ViewBag.RouteMap = "游戏配置";
}
@section include_res{
    <style>
        .gc-wrap { padding: 16px; box-sizing: border-box; }
        .gc-tip { display: none; }
        .gc-grid { display: flex; gap: 16px; align-items: stretch; }
        .gc-card { background: #fff; border: 1px solid #e5e9f0; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.04); }
        .gc-left { width: 260px; flex: 0 0 260px; display: flex; flex-direction: column; }
        .gc-right { flex: 1 1 auto; min-width: 0; }
        .gc-card-hd { padding: 12px 16px; border-bottom: 1px solid #eef1f6; font-size: 14px; font-weight: 600; color: #1f2d3d; display: flex; align-items: center; justify-content: space-between; }
        .gc-card-hd .fa { color: #2f6fed; margin-right: 6px; }
        .gc-card-bd { padding: 16px; }
        .gc-field { margin-bottom: 14px; }
        .gc-field > label { display: block; font-size: 13px; color: #5a6573; margin-bottom: 6px; }
        .gc-input, .gc-select { width: 100%; height: 36px; line-height: 36px; padding: 0 12px; box-sizing: border-box; border: 1px solid #d4dae3; border-radius: 6px; font-size: 14px; color: #1f2d3d; background: #fff; transition: border-color .15s, box-shadow .15s; }
        .gc-input:focus, .gc-select:focus { border-color: #2f6fed; box-shadow: 0 0 0 3px rgba(47,111,237,.12); outline: none; }
        .gc-form-row { display: flex; gap: 16px; }
        .gc-form-row > .gc-field { flex: 1 1 0; }
        .gc-section-title { font-size: 13px; font-weight: 600; color: #2f6fed; margin: 4px 0 12px; padding-left: 8px; border-left: 3px solid #2f6fed; }
        .gc-switch { position: relative; display: inline-block; width: 46px; height: 24px; vertical-align: middle; }
        .gc-switch input { opacity: 0; width: 0; height: 0; }
        .gc-slider { position: absolute; cursor: pointer; inset: 0; background: #c7ced8; border-radius: 24px; transition: .2s; }
        .gc-slider:before { content: ""; position: absolute; height: 18px; width: 18px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: .2s; }
        .gc-switch input:checked + .gc-slider { background: #2f6fed; }
        .gc-switch input:checked + .gc-slider:before { transform: translateX(22px); }
        .gc-switch-label { margin-left: 10px; font-size: 13px; color: #5a6573; }
        .gc-tablelist { list-style: none; margin: 0; padding: 0; max-height: 540px; overflow-y: auto; }
        .gc-tablelist li { padding: 10px 14px; border-bottom: 1px solid #f0f2f6; cursor: pointer; font-size: 13px; color: #36404a; display: flex; align-items: center; justify-content: space-between; }
        .gc-tablelist li:hover { background: #f5f8ff; }
        .gc-tablelist li.active { background: #ecf2ff; color: #2f6fed; font-weight: 600; }
        .gc-pill { font-size: 11px; padding: 1px 8px; border-radius: 10px; }
        .gc-pill-on { background: #e6f7ed; color: #1a9d57; }
        .gc-pill-off { background: #fbe9e9; color: #d33b3b; }
        .gc-foot { padding: 14px 16px; border-top: 1px solid #eef1f6; text-align: right; }
        .gc-btn { height: 36px; padding: 0 20px; border-radius: 6px; border: 1px solid transparent; font-size: 14px; cursor: pointer; }
        .gc-btn:disabled { background: #e5e9f0 !important; color: #9aa5b1; border-color: #d4dae3; cursor: not-allowed; }
        .gc-btn-primary { background: #2f6fed; color: #fff; }
        .gc-btn-primary:hover { background: #2560d6; }
        .gc-btn-default { background: #fff; color: #5a6573; border-color: #d4dae3; margin-right: 10px; }
        .gc-btn-default:hover { border-color: #2f6fed; color: #2f6fed; }
        .gc-empty { padding: 40px 16px; text-align: center; color: #9aa4b1; font-size: 13px; }
        .gc-toolbar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; align-items: center; }
        .gc-toolbar .gc-lbl { font-size: 13px; color: #5a6573; }
        .gc-toolbar #gcTypeSel { width: 160px; }
        .gc-toolbar #gcGameSel { width: 220px; }
        .gc-toolbar #gcLineSel { width: 200px; }
        .gc-line-tip { font-size: 12px; color: #d97a00; }
        .gc-hint { font-size: 12px; color: #9aa4b1; margin-top: 4px; line-height: 1.6; }
        .gc-jp-current { padding:6px 8px; border:1px solid #e5e9f0; background:#f7f9fc; text-align:right; color:#52637b; font-variant-numeric:tabular-nums; }
        .gc-jp-current output { display:block; font-size:13px; white-space:nowrap; }
        .gc-jp-setting { padding:4px 8px; border:1px solid #e5e9f0; }
        #gcJpTable .gc-jp-setting { width:140px; }
        #gcJpTable .gc-input { height:28px; line-height:28px; padding:0 7px; font-size:12px; text-align:right; }
        .gc-guide { margin: 0 0 14px; padding: 10px 12px; border: 1px solid #dce8ff; border-radius: 6px; background: #f7faff; color: #526173; font-size: 12px; line-height: 1.7; }
        .gc-refresh { width: 30px; height: 30px; line-height: 30px; text-align: center; border-radius: 6px; color: #5a6573; cursor: pointer; transition: background .15s, color .15s; }
        .gc-refresh:hover { background: #ecf2ff; color: #2f6fed; }
        .gc-refresh .fa { margin: 0; color: inherit; }
        .gc-newbtn { font-size: 12px; font-weight: 500; color: #2f6fed; cursor: pointer; padding: 3px 10px; border: 1px solid #cdd9f7; border-radius: 14px; background: #f5f8ff; }
        .gc-newbtn:hover { background: #2f6fed; color: #fff; border-color: #2f6fed; }
        .gc-newbtn:disabled { color: #9aa5b1; background: #eef1f6; border-color: #d4dae3; cursor: not-allowed; }
        .gc-newbtn .fa { margin-right: 4px; color: inherit; }
        .gc-para-empty { display: none; padding: 72px 24px; text-align: center; }
        .gc-para-empty-icon { width: 88px; height: 88px; line-height: 88px; margin: 0 auto 20px; border-radius: 50%; background: linear-gradient(135deg, #eef3ff, #f7faff); color: #2f6fed; font-size: 42px; box-shadow: inset 0 0 0 1px #e2ebff; }
        .gc-para-empty-title { font-size: 16px; font-weight: 600; color: #5a6573; margin-bottom: 8px; }
        .gc-para-empty-text { font-size: 13px; color: #9aa4b1; max-width: 380px; margin: 0 auto; line-height: 1.7; }
        .gc-switch-inline { display: flex; align-items: center; height: 36px; gap: 12px; }
        .gc-switch-inline .gc-switch-label { margin-left: 0; }
        .gc-batch-create { padding: 22px 24px 18px; color: #36404a; font-size: 13px; }
        .gc-batch-create-row { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 15px; }
        .gc-batch-create-row .textbox { width: 90px !important; }
        .gc-batch-create-tip { margin-top: 14px; color: #8a94a3; line-height: 1.7; text-align: center; }
        .gc-batch-create-foot { margin-top: 18px; text-align: center; }
        .gc-mjhl-agent-panel { display:none; }
        .gc-mjhl-agent-panel .gc-weight-scroll { overflow-x:auto; }
        .gc-mjhl-agent-panel .gc-weight-table { width:100%; min-width:460px; border-collapse:collapse; table-layout:fixed; }
        .gc-mjhl-agent-panel .gc-weight-table th, .gc-mjhl-agent-panel .gc-weight-table td { border:1px solid #e5e9f0; padding:1px 4px; text-align:center; font-size:12px; line-height:18px; }
        .gc-mjhl-agent-panel .gc-weight-table th { background:#f5f8ff; color:#5a6573; }
        .gc-mjhl-agent-panel .gc-weight-table td:first-child, .gc-mjhl-agent-panel .gc-weight-table th:first-child { width:48px; text-align:center; }
        .gc-mjhl-agent-panel .gc-weight-table .gc-weight-odds { width:88px; white-space:nowrap; color:#58677a; font-variant-numeric:tabular-nums; }
        .gc-mjhl-agent-panel .gc-weight-table .gc-weight-axis-summary { display:block; font-size:11px; font-weight:400; line-height:16px; white-space:nowrap; color:#6c7a8d; letter-spacing:-.2px; }
        .gc-mjhl-agent-panel .gc-weight-table .gc-weight-invalid { color:#c92c32; background:#fff1f0; border-radius:3px; }
        .gc-mjhl-agent-panel .gc-weight-cell { width:100%; height:20px; line-height:18px; padding:0 2px; box-sizing:border-box; border:1px solid #d4dae3; border-radius:4px; text-align:center; font-size:12px; font-variant-numeric:tabular-nums; }
        .gc-mjhl-agent-panel .gc-weight-cell[readonly] { color:#8a94a3; background:#f0f2f5; cursor:default; }
        .gc-mjhl-agent-panel .gc-weight-blank { background:#f5f6f8; color:#667488; }
        .gc-mjhl-agent-panel .gc-weight-blank output { display:block; text-align:center; font-variant-numeric:tabular-nums; }
        .gc-mjhl-agent-panel .gc-weight-panels { display:flex; flex-wrap:wrap; gap:12px; }
        .gc-mjhl-agent-panel .gc-weight-card { flex:1 1 480px; min-width:0; border:1px solid #dce5f3; border-radius:8px; overflow:hidden; }
        .gc-mjhl-agent-panel .gc-weight-card-head { margin:0; padding:5px 10px; background:#edf4ff; color:#2f6fed; font-size:13px; line-height:18px; font-weight:600; }
        .gc-mjhl-agent-panel .gc-weight-card-free { border-color:#d6e9df; }
        .gc-mjhl-agent-panel .gc-weight-card-free .gc-weight-card-head { background:#eff8f3; color:#28805a; }
        .gc-mjhl-agent-panel .gc-weight-card-free th { background:#f6faf7; }
        .gc-mjhl-agent-panel .gc-weight-card .gc-weight-scroll { padding:2px; }
        .gc-mjhl-agent-panel .gc-weight-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:4px 12px; margin-bottom:6px; }
        .gc-mjhl-agent-panel .gc-weight-heading .gc-section-title { margin-bottom:0; }
        .gc-mjhl-agent-panel .gc-weight-heading-note, .gc-mjhl-agent-panel .gc-weight-help { font-size:12px; color:#6c7a8d; line-height:18px; }
        .gc-mjhl-agent-panel .gc-weight-help { margin-top:4px; }
        .gc-mjhl-agent-panel .gc-rules-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; }
        .gc-mjhl-agent-panel .gc-rules-heading .gc-section-title { margin-bottom:0; }
        .gc-mjhl-agent-panel .gc-rule-detail { position:relative; font-size:12px; font-weight:400; }
        .gc-mjhl-agent-panel .gc-rule-detail summary { cursor:pointer; color:#2f6fed; line-height:18px; }
        .gc-mjhl-agent-panel .gc-rule-detail summary:focus-visible { outline:2px solid #2f6fed; outline-offset:2px; }
        .gc-mjhl-agent-panel .gc-rule-copy { position:absolute; z-index:20; right:0; bottom:26px; width:360px; max-width:70vw; padding:12px 14px; color:#36404a; background:#fff; border:1px solid #cdd9f7; border-radius:6px; box-shadow:0 4px 18px rgba(31,45,61,.16); line-height:1.7; box-sizing:border-box; }
        .gc-mjhl-agent-panel .gc-rule-copy p { margin:0 0 6px; }
        .gc-mjhl-agent-panel .gc-rule-copy p:last-child { margin-bottom:0; }
        .gc-mjhl-agent-panel .gc-weight-cell { -moz-appearance:textfield; appearance:textfield; }
        .gc-mjhl-agent-panel .gc-weight-cell::-webkit-inner-spin-button, .gc-mjhl-agent-panel .gc-weight-cell::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
        .gc-mjhl-agent-panel .gc-weight-cell:focus { border-color:#2f6fed; outline:2px solid rgba(47,111,237,.12); }
        .gc-mjhl-agent-panel .gc-weight-meta { display:flex; flex-wrap:wrap; gap:2px 14px; margin:5px 0 8px; line-height:18px; }
        .gc-mjhl-agent-panel .gc-weight-meta .gc-agent-status { margin-left:0; }
        .gc-mjhl-agent-panel .gc-agent-status { margin-left:12px; color:#8a94a3; font-size:12px; }
        .gc-mjhl-agent-panel .gc-agent-actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:8px; margin-top:8px; text-align:right; }
        .gc-mjhl-agent-panel .gc-agent-actions .gc-btn-default { margin-right:0; }
        .gc-mjhl-agent-panel .gc-action-note { margin-right:auto; color:#8a94a3; font-size:12px; }
        .gc-mjhl-agent-panel .gc-agent-readonly { color:#d97a00; font-size:12px; margin-left:10px; }
        .gc-mjhl-mode > .gc-guide, .gc-mjhl-mode > div:not(.gc-mjhl-agent-panel) { display:none !important; }
        .gc-grid.gc-mjhl-grid .gc-left { display:none; }
        .gc-grid.gc-mjhl-grid .gc-right { width:100%; }
        .gc-mjhl-grid #gcCurTableName { display:none; }
        /* 仅麻将胡了使用紧凑布局，切换其他游戏时移除，不改变公共页面样式。 */
        body.gc-mjhl-page > .title-map { display:none; }
        .gc-wrap.gc-mjhl-desktop { padding:8px 12px; }
        .gc-mjhl-desktop .gc-toolbar { margin-bottom:8px; gap:8px; }
        .gc-mjhl-desktop .gc-toolbar .gc-select { height:30px; line-height:30px; }
        .gc-mjhl-grid .gc-card-hd { padding:6px 12px; }
        .gc-mjhl-grid .gc-right > .gc-card-hd { display:none; }
        .gc-mjhl-grid .gc-card-bd { padding:8px 12px; }
        .gc-mjhl-agent-panel .gc-section-title { margin:0 0 6px; line-height:18px; }
        .gc-mjhl-agent-panel .gc-options { display:flex; flex-wrap:wrap; gap:12px; }
        .gc-mjhl-agent-panel .gc-option-card { flex:1 1 430px; min-width:0; padding:8px 10px 0; border:1px solid #e5e9f0; border-radius:6px; box-sizing:border-box; }
        .gc-mjhl-agent-panel .gc-form-row { gap:10px; }
        .gc-mjhl-agent-panel .gc-field { min-width:0; margin-bottom:6px; }
        .gc-mjhl-agent-panel .gc-field > label { font-size:12px; line-height:16px; margin-bottom:3px; }
        .gc-mjhl-agent-panel .gc-input { height:28px; line-height:28px; padding:0 8px; font-size:13px; }
        .gc-mjhl-agent-panel .gc-switch-inline { height:28px; gap:8px; }
        .gc-mjhl-agent-panel .gc-switch { flex-shrink:0; }
        .gc-mjhl-agent-panel .gc-switch-label { font-size:12px; line-height:16px; }
        .gc-mjhl-agent-panel .gc-btn { height:30px; padding:0 14px; font-size:13px; }
        @@media (min-width:960px) and (max-height:660px) {
            .gc-wrap.gc-mjhl-desktop { padding-top:6px; padding-bottom:6px; }
            .gc-mjhl-desktop .gc-toolbar { margin-bottom:6px; }
            .gc-mjhl-grid .gc-card-bd { padding-top:6px; padding-bottom:6px; }
            .gc-mjhl-agent-panel .gc-weight-cell { height:20px; line-height:18px; }
            .gc-mjhl-agent-panel .gc-weight-card-head { padding-top:4px; padding-bottom:4px; }
            .gc-mjhl-agent-panel .gc-field { margin-bottom:4px; }
            .gc-mjhl-agent-panel .gc-section-title { margin-bottom:4px; }
            .gc-mjhl-agent-panel .gc-option-card { padding-top:6px; }
            .gc-mjhl-agent-panel .gc-option-card > .gc-form-row:nth-child(2) > .gc-field { display:flex; align-items:center; gap:6px; }
            .gc-mjhl-agent-panel .gc-option-card > .gc-form-row:nth-child(2) > .gc-field > label { max-width:100px; margin-bottom:0; line-height:14px; flex:0 1 auto; }
            .gc-mjhl-agent-panel .gc-option-card > .gc-form-row:nth-child(2) .gc-input { width:0; min-width:48px; flex:1 1 0; }
            .gc-mjhl-agent-panel .gc-agent-actions { margin-top:4px; }
            .gc-mjhl-agent-panel .gc-weight-help { margin-top:2px; }
        }
    </style>
}
<div class="gc-wrap">
    <div id="gcEncodingNotice" class="gc-tip" data-encoding="UTF-8-BOM">本视图文件必须保存为 UTF-8 带签名(BOM) 编码，避免中文乱码与路由异常。</div>

    <div class="gc-toolbar">
        <span class="gc-lbl">游戏类型：</span>
        <select id="gcTypeSel" class="gc-select">
            <option value="-1">请选择类型</option>
        </select>
        <span class="gc-lbl">选择游戏：</span>
        <select id="gcGameSel" class="gc-select"></select>
        <span class="gc-lbl" title="不同直属代理的整条线可以用各自的一套桌台参数；整条线的玩家按所属直属代理取桌台">代理：</span>
        <select id="gcLineSel" class="gc-select"><option value="">公共桌台</option></select>
        <a href="javascript:;" id="gcLineCopy" class="gc-newbtn" style="display:none;" title="把本游戏全部公共桌台的参数复制一套，作为该线的专属桌台">从公共桌台复制一套</a>
        <a href="javascript:;" id="gcLineRecall" class="gc-newbtn" style="display:none;" title="收回该线的专属桌台，该线玩家回到公共桌台">收回专属桌台</a>
        <button type="button" id="mjhlAgentCopy" class="gc-newbtn" style="display:none;" title="复制当前已保存的默认参数和权重，作为该代理线的独立配置">复制默认配置</button>
        <button type="button" id="mjhlAgentRecall" class="gc-newbtn" style="display:none;" title="收回独立配置，后续跟随默认参数和权重更新">恢复使用默认配置</button>
        <span id="gcLineTip" class="gc-line-tip"></span>
    </div>

    <div class="gc-grid">
        <div class="gc-card gc-left">
            <div class="gc-card-hd">
                <span><i class="fa fa-th-list"></i>桌台列表</span>
                <a href="javascript:;" id="gcNewTable" class="gc-newbtn" title="新建桌台"><i class="fa fa-plus"></i>新建桌台</a>
            </div>
            <div class="gc-card-bd" style="padding:0;">
                <ul id="gcTableList" class="gc-tablelist"></ul>
                <div id="gcTableEmpty" class="gc-empty">请选择上方游戏以加载桌台。</div>
            </div>
        </div>

        <div class="gc-card gc-right">
            <div class="gc-card-hd">
                <span><i class="fa fa-sliders"></i><span id="gcConfigHeading">桌台参数</span></span>
                <span style="display:flex;align-items:center;gap:6px;">
                    <span id="gcCurTableName" style="font-size:13px;color:#9aa4b1;font-weight:400;"></span>
                    <a href="javascript:;" id="gcRefresh" class="gc-refresh" title="刷新桌台参数"><i class="fa fa-refresh"></i></a>
                    <a href="javascript:;" id="gcDelete" class="gc-refresh" title="彻底删除该桌台"><i class="fa fa-trash"></i></a>
                </span>
            </div>
            <div class="gc-card-bd">
                <div id="gcParaEmpty" class="gc-para-empty">
                    <div class="gc-para-empty-icon"><i class="fa fa-gamepad"></i></div>
                    <div class="gc-para-empty-title">尚未选择游戏</div>
                    <div class="gc-para-empty-text">请先在上方选择「游戏类型」与「游戏」，选定后即可配置该游戏的桌台参数。</div>
                </div>
                <form id="gcForm">
                    <div class="gc-guide"><strong>填写提示：</strong>押注/牌机类的“出现机会/权重”是相对值，不是百分比（例如 A=200、B=100，A 约是 B 的 2 倍机会）；<strong>拉霸中奖权重在下方“机台设定”中填写，与基础参数统一保存</strong>。带“×100、×10000、万分比”的参数请按示例填写；留空、0 和默认值的含义以字段下方说明为准。</div>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="gcId" name="ID" value="-1" />
                    <input type="hidden" id="gcGameId" name="GAME_ID" value="-1" />
                    <input type="hidden" id="gcGameType" name="GAME_TYPE" value="-1" />
                    <input type="hidden" id="gcLine" name="LINE" value="" />

                    <div id="gcMjhlAgentPanel" class="gc-mjhl-agent-panel">
                        <div class="gc-weight-heading"><div class="gc-section-title">牌型权重（每轴合计 0～10000）</div><span class="gc-weight-heading-note">每格填整数；表头小字：已填 / 10000；补牌随权重及开关自动计算</span></div>
                        <div class="gc-weight-panels">
                            <section class="gc-weight-card" aria-labelledby="mjhlNormalWeightsTitle">
                                <h3 id="mjhlNormalWeightsTitle" class="gc-weight-card-head">普通局</h3>
                                <div class="gc-weight-scroll"><table class="gc-weight-table" aria-label="普通局牌型权重"><thead><tr><th scope="col">牌型</th><th scope="col" class="gc-weight-odds">赔率<span class="gc-weight-axis-summary">3 / 4 / 5轴</span></th><th scope="col">第1轴<span id="mjhlAxis_n_0" class="gc-weight-axis-summary">—</span></th><th scope="col">第2轴<span id="mjhlAxis_n_1" class="gc-weight-axis-summary">—</span></th><th scope="col">第3轴<span id="mjhlAxis_n_2" class="gc-weight-axis-summary">—</span></th><th scope="col">第4轴<span id="mjhlAxis_n_3" class="gc-weight-axis-summary">—</span></th><th scope="col">第5轴<span id="mjhlAxis_n_4" class="gc-weight-axis-summary">—</span></th></tr></thead><tbody id="mjhlWeightBody" class="gc-weight-body" data-mode="n"></tbody></table></div>
                            </section>
                            <section class="gc-weight-card gc-weight-card-free" aria-labelledby="mjhlFreeWeightsTitle">
                                <h3 id="mjhlFreeWeightsTitle" class="gc-weight-card-head">免费局</h3>
