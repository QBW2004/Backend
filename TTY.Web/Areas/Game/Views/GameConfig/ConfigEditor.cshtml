    // 水果拉霸：把转盘权重恢复为内置默认 90% 面板表（满足逐区等值约束，理论 RTP≈90%）
    function gcApplyFruitDefaultProb() {
        if (gcGetType() === 3 && gcLabaSubType() === 2) {
            if ($('#gcLabaWp0').length === 0) gcBuildLabaPayoutTable(2);
            $.each(GC_LABA_WHEEL_META, function (idx, r) { $('#gcLabaWp' + r.i).val(GC_LABA_WHEEL_DEFAULT[r.i]); });
            gcUpdateLabaWheelSum();
