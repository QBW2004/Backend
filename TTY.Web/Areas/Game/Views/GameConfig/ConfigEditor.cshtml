    // 渲染「押注门赔率权重配置」表（RTP 实时核算，服务端当前内置倍率仅展示预留）
    function gcBuildBetDoorTable() {
        var dm = gcGetBetDoorMeta();
        var $box = $('#gcBetDoorBox');
        $box.empty();
        if (!dm) {
            $('#gcBetDoorHint').text('');
            return;
        }
        var fixed = !!dm.fixedOdd;
        var hasMinW = dm.doors[0] && dm.doors[0].minW !== undefined;
        // 展示按倍率从低到高排序（仅调整行显示顺序；data-idx 仍为真实门索引，
        // RTP 核算与保存收集按索引取数，不破坏服务端按位置消费权重的语义）
        var sortedDoors = dm.doors.map(function (d, i) { return { d: d, i: i }; }).sort(function (a, b) {
            var ka = a.d.minOdd !== undefined ? a.d.minOdd : (a.d.odd || 0);
            var kb = b.d.minOdd !== undefined ? b.d.minOdd : (b.d.odd || 0);
            if (ka !== kb) return ka - kb;
            var ma = a.d.maxOdd !== undefined ? a.d.maxOdd : ka;
            var mb = b.d.maxOdd !== undefined ? b.d.maxOdd : kb;
            if (ma !== mb) return ma - mb;
            return a.i - b.i;
        });
        var html = '<table style="width:100%;border-collapse:collapse;margin-bottom:8px;">';
        html += '<thead><tr style="background:#f5f8ff;color:#5a6573;font-size:13px;">' +
            '<th style="padding:8px;border:1px solid #e5e9f0;text-align:left;">押注门</th>' +
            (fixed
                ? '<th style="padding:8px;border:1px solid #e5e9f0;">固定倍率</th>'
                : '<th style="padding:8px;border:1px solid #e5e9f0;">最小赔率</th><th style="padding:8px;border:1px solid #e5e9f0;">最大赔率</th>') +
            (hasMinW
                ? '<th style="padding:8px;border:1px solid #e5e9f0;">权重最小(万)</th><th style="padding:8px;border:1px solid #e5e9f0;">权重最大(万)</th>'
                : '<th style="padding:8px;border:1px solid #e5e9f0;">权重(万分)</th>') +
            '<th style="padding:8px;border:1px solid #e5e9f0;">单门RTP(%)</th></tr></thead><tbody>';
        $.each(sortedDoors, function (_, s) {
            var i = s.i, d = s.d;
            html += '<tr>' +
                '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#36404a;">' + d.n + '</td>';
            // 赔率（min/max/固定）只读展示：服务端当前使用内置倍率，仅作 RTP 核算参考，不可调整
            var roStyle = 'readonly style="background:#f7f9fc;color:#8a94a1;"';
            if (fixed) {
                html += '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-odd" data-idx="' + i + '" min="0" step="0.1" value="' + d.odd + '" ' + roStyle + ' /></td>';
            } else {
                html += '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-minodd" data-idx="' + i + '" min="0" step="0.1" value="' + d.minOdd + '" ' + roStyle + ' /></td>' +
                    '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-maxodd" data-idx="' + i + '" min="0" step="0.1" value="' + d.maxOdd + '" ' + roStyle + ' /></td>';
            }
            if (hasMinW) {
                html += '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-minw" data-idx="' + i + '" min="0" step="1" value="' + d.minW + '" /></td>' +
                    '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-maxw" data-idx="' + i + '" min="0" step="1" value="' + d.maxW + '" /></td>';
            } else {
                html += '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" class="gc-input gc-betdoor gc-betdoor-w" data-idx="' + i + '" min="0" step="1" value="' + d.w + '" /></td>';
            }
            html += '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:12px;color:#009944;text-align:center;" class="gc-betdoor-rtp" data-idx="' + i + '">-</td></tr>';
        });
        html += '<tr style="background:#d6eaf8;font-weight:600;">' +
            '<td style="padding:6px 8px;border:1px solid #e5e9f0;">全局合计</td>' +
            (fixed ? '<td style="padding:6px 8px;border:1px solid #e5e9f0;">-</td>' : '<td style="padding:6px 8px;border:1px solid #e5e9f0;">-</td><td style="padding:6px 8px;border:1px solid #e5e9f0;">-</td>') +
            (hasMinW
                ? '<td style="padding:6px 8px;border:1px solid #e5e9f0;" id="gcBetDoorSumMinW">-</td><td style="padding:6px 8px;border:1px solid #e5e9f0;" id="gcBetDoorSumMaxW">-</td>'
                : '<td style="padding:6px 8px;border:1px solid #e5e9f0;" id="gcBetDoorSumW">-</td>') +
            '<td style="padding:6px 8px;border:1px solid #e5e9f0;" id="gcBetDoorRtp">-</td></tr>';
