    // 水果拉霸：把转盘权重恢复为内置默认 90% 面板表（8 区高度均衡，理论 RTP≈90%）
    function gcApplyFruitDefaultProb() {
        if (gcGetType() === 3 && gcLabaSubType() === 2) {
            if ($('#gcLabaWpCat0').length === 0) gcBuildLabaPayoutTable(2);
            $.each(LABA_FRUIT_CATS, function (i, c) {
                var pSum = 0;
                $.each(c.panels, function (j, p) { pSum += GC_LABA_WHEEL_DEFAULT[p]; });
                $('#gcLabaWpCat' + i).val(pSum);
            });
            gcSyncWheelPanels();
            gcUpdateLabaWheelSum();
            fruitRtpPreview();
        }
    }

    // 恢复默认：对拉霸三个子游戏回填可见的内置默认值（RTP 闭环参数 / 水果转盘默认 90% 权重 / 明星97 组合默认赔率），
    // 使用户能直接看到"默认是多少"再决定是否调整；保存时按所见值显式写库，与内置默认等价。
    // 组合"出现率/每日次数"默认=服务端内置分布/不限，无单一数值可显示 → 保持留空(placeholder 已注明)，
    // 绝不填 0（0 是合法显式值，语义为"当天禁出/不出现"，会错误覆盖"不限"）。
    // 隐藏字段（兑换单位 EX_COIN / 兑换金币数 Game_Mo 等）保持 0 = 保存时走服务端兜底默认，不回填 1。
    // 其它游戏类型维持原语义：清空表单（留空/0 = 服务端兜底默认）。
    function gcResetForm() {
        gcZeroForm();
        if (gcGetType() !== 3) return;          // 非拉霸维持原"清空=默认"
        // 拉霸可见的押分/兑换默认（最小/最大押分 1、每个游戏币分值 1、进房金币 1、加炮分值 1；与新建桌台一致）
        $('#gcMinBet').val(1);
        $('#gcMaxBet').val(1);
        $('#gcCoinSc').val(1);
        $('#gcCoinNeed').val(1);
        $('#gcScoreSwitch').val(1);
        var st = gcLabaSubType();
        if (st === 1) {                          // 明星97：RTP 闭环默认 + 组合默认赔率
            $('#gcRtpTargetX100').val(GC_MX97_RTP_DEFAULT.targetX100);
            $('#gcRtpKp').val(GC_MX97_RTP_DEFAULT.kp);
            $('#gcRtpDeadband').val(GC_MX97_RTP_DEFAULT.deadband);
            $('#gcRtpDeltaMax').val(GC_MX97_RTP_DEFAULT.deltaMax);
            $('#gcRtpStockThreshold').val(GC_MX97_RTP_DEFAULT.stockThreshold);
            $('#gcRtpWindow').val(GC_MX97_RTP_DEFAULT.window);
            if ($('#gcMx97ComboTable tbody tr').length === 0) gcBuildMx97ComboTable();
            $.each(GC_MX97_COMBO_META, function (i, r) {
                $('#gcMxCombo' + r.code).val(r.v);   // 组合默认赔率（出现率留空=服务端内置）
            });
        } else if (st === 2) {                   // 水果拉霸：RTP 闭环默认 + 默认 90% 转盘权重
            $('#gcFruitRtpTargetX100').val(GC_FRUIT_RTP_DEFAULT.targetX100);
            $('#gcFruitRtpKp').val(GC_FRUIT_RTP_DEFAULT.kp);
            $('#gcFruitRtpDeadband').val(GC_FRUIT_RTP_DEFAULT.deadband);
            $('#gcFruitRtpDeltaMax').val(GC_FRUIT_RTP_DEFAULT.deltaMax);
            $('#gcFruitRtpStockThreshold').val(GC_FRUIT_RTP_DEFAULT.stockThreshold);
            $('#gcFruitRtpWindow').val(GC_FRUIT_RTP_DEFAULT.window);
            gcApplyFruitDefaultProb();
        } else if (st === 3) {                   // 水浒传：RTP 闭环默认（结果类出现率服务端内置，保持留空）
            $('#gcRtpTargetX100').val(GC_SHZ_RTP_DEFAULT.targetX100);
            $('#gcRtpKp').val(GC_SHZ_RTP_DEFAULT.kp);
            $('#gcRtpDeadband').val(GC_SHZ_RTP_DEFAULT.deadband);
            $('#gcRtpDeltaMax').val(GC_SHZ_RTP_DEFAULT.deltaMax);
            $('#gcRtpStockThreshold').val(GC_SHZ_RTP_DEFAULT.stockThreshold);
            $('#gcRtpWindow').val(GC_SHZ_RTP_DEFAULT.window);
        }
        // 回填后展开高级区，让用户直接看到默认值
        gcRefreshNoWinRows();
        gcToggleAdv(true);
    }

    function gcNewTable() {
        var type = gcGetType();
        if (type != 0 && type != 1 && type != 2 && type != 3) {
            showToast('请先选择游戏类型与游戏！', 'warning');
            return;
        }
        var gameId = parseInt($('#gcGameSel').val(), 10);
        $('#gcTableList li').removeClass('active');
        var src = gcLatestTable();
        if (src) {
            gcFill(src);
        } else {
            gcZeroForm();
            $('#gcEnabled').prop('checked', true);
            if (type === 1 || type === 3) gcApplyCardDefaults();
        }
        $('#gcId').val(-1);
        $('#gcGameId').val(isNaN(gameId) ? -1 : gameId);
        $('#gcGameType').val(type);
        $('#gcTableName').val('');
        gcApplyType();
        // 水果拉霸：权重固定为默认面板表（8 区高度均衡，理论 RTP≈90%），不复用最近桌台的权重
        gcApplyFruitDefaultProb();
        // 新建桌台：RTP/组合等高级项保持"留空=系统默认"（不显式写库），让游戏服内置默认跟随版本演进；
        // 需要看到并落库内置默认数值时，点"恢复默认"按钮即可
        $('#gcCurTableName').text(src ? '新建桌台（已套用最近桌台参数，拉霸权重使用默认 90% 面板表，填写桌名即可保存）' : '新建桌台（RTP 等高级项保持系统默认，可点“恢复默认”查看默认值）');
        gcSyncSwitch();
        gcUpdateSaveBtn();
    }

