        GC_MJHL_LOADED_LINE = gcCurLine();
        GC_MJHL_AGENT_CAN_EDIT = !!(meta && meta.canEdit);
        GC_MJHL_AGENT = $.extend(true, {}, config || {});
        GC_MJHL_AGENT_SAVED = $.extend(true, {}, GC_MJHL_AGENT);
        $('#mjhlTargetRtp').val(GC_MJHL_AGENT.targetRtp);
        GC_MJHL_TARGET_COMMITTED = String(Number(GC_MJHL_AGENT.targetRtp));
        $('#mjhlGoldChance').val(GC_MJHL_AGENT.goldChance);
        $('#mjhlScatterEnabled').prop('checked', !!GC_MJHL_AGENT.scatterEnabled);
        $('#mjhlFreeRetrigger').prop('checked', !!GC_MJHL_AGENT.freeRetrigger);
        gcMjhlSwitchText();
        var b = GC_MJHL_AGENT.bets || {};
        $('#mjhlBetMin').val(b.min); $('#mjhlBetMax').val(b.max); $('#mjhlBetEntry').val(b.entry);
        $('#mjhlBetChips').val((b.chips || []).join(',')); $('#mjhlScorePerCoin').val(b.scorePerCoin);
        gcMjhlRenderWeights(); gcMjhlSavedRtp(meta); gcMjhlActualRtp();
        $('#mjhlAgentStatus').text(meta ? ((meta.inherited ? '使用默认配置 · 默认版本 ' : '版本 ') + (meta.sourceRevision || meta.revision || '0') + (meta.updatedAt ? ' · ' + meta.updatedAt : '')) : '').data('revision', meta && meta.revision ? String(meta.revision) : '0');
        var canEdit = !!(meta && meta.canEdit); GC_MJHL_AGENT_CAN_EDIT = canEdit; $('#mjhlAgentReadonly').text(canEdit ? '' : '当前账号只读'); gcMjhlControls();
    }
    function gcMjhlReadWeights() {
        if (!GC_MJHL_AGENT || !GC_MJHL_AGENT.weights) return;
        // 两张表各自绑定普通/免费矩阵，保存和RTP计算同时读取，避免切换模式遗漏修改。
        $('#gcMjhlAgentPanel .gc-weight-body').each(function () {
            var body = $(this), rows = GC_MJHL_AGENT.weights[body.attr('data-mode')];
            if (!rows) return;
            body.find('input').each(function () { var r = parseInt($(this).attr('data-row'), 10), c = parseInt($(this).attr('data-col'), 10), v = $.trim($(this).val()) === '' ? NaN : Number($(this).val()); if (rows[r]) rows[r][c] = v; });
        });
    }
    function gcMjhlCollect() {
        gcMjhlReadWeights();
        var chips = [], raw = ($('#mjhlBetChips').val() || '').split(',');
        $.each(raw, function (i, x) { x = $.trim(x); if (x !== '') chips.push(Number(x)); });
        var cfg = $.extend(true, {}, GC_MJHL_AGENT || {});
        cfg.gameId = 54; cfg.targetRtp = Number($('#mjhlTargetRtp').val()); cfg.goldChance = Number($('#mjhlGoldChance').val());
        cfg.scatterEnabled = $('#mjhlScatterEnabled').prop('checked'); cfg.freeRetrigger = $('#mjhlFreeRetrigger').prop('checked');
        cfg.bets = { min:Number($('#mjhlBetMin').val()), max:Number($('#mjhlBetMax').val()), entry:Number($('#mjhlBetEntry').val()), chips:chips, scorePerCoin:Number($('#mjhlScorePerCoin').val()) };
        return cfg;
    }
    function gcMjhlLoadConfig() {
        gcMjhlCancelRtp();
        var line = gcCurLine(), seq = ++GC_MJHL_LOAD_SEQ;
        GC_MJHL_AGENT = null; GC_MJHL_AGENT_SAVED = null; GC_MJHL_META = null; GC_MJHL_AGENT_CAN_EDIT = false; GC_MJHL_LOADED_LINE = ''; gcMjhlControls();
        $('#mjhlAgentStatus').text(line ? '正在读取…' : '请选择代理线');
        $('#mjhlActualRtp').text('');
        if (!line) return;
        request(GC_URL.mjhlAgentGet, { lineAgent: line }, function (data) {
            if (seq !== GC_MJHL_LOAD_SEQ || line !== gcCurLine() || !gcIsMjhl()) return;
            if (!data || data.code != 1) { gcMsg(data); return; }
            gcMjhlFill(data.config || {}, data); gcSetParaVisible(true);
        });
    }
    function gcMjhlSave() {
        if (GC_MJHL_WRITING) return;
        if (!GC_MJHL_AGENT || !GC_MJHL_AGENT_CAN_EDIT || GC_MJHL_LOADED_LINE !== gcCurLine()) { showToast('请先载入该代理线参数。', 'warning'); return; }
        if (GC_MJHL_CALIBRATING) { showToast(GC_MJHL_RTP_JOB === 'calibrate' ? '正在调校并复核 RTP，完成后才能保存。' : '正在复核 RTP，完成后才能保存。', 'warning'); return; }
        var cfg = gcMjhlCollect(), line = gcCurLine(), seq = GC_MJHL_LOAD_SEQ;
        if ($.trim($('#mjhlTargetRtp').val()) === '' || !isFinite(cfg.targetRtp) || cfg.targetRtp < 0 || cfg.targetRtp > 1000) { showToast('目标 RTP 必须在 0～1000%。', 'warning'); return; }
        if (!isFinite(cfg.goldChance) || cfg.goldChance < 0 || cfg.goldChance > 100) { showToast('金色牌概率必须在 0～100%。', 'warning'); return; }
        if (!isFinite(cfg.bets.scorePerCoin) || cfg.bets.scorePerCoin < 1 || Math.floor(cfg.bets.scorePerCoin) !== cfg.bets.scorePerCoin) { showToast('兑换比例必须是正整数。', 'warning'); return; }
        var profile = gcMjhlEngineProfile();
        if (!GC_MJHL_RTP_RESULT || GC_MJHL_RTP_KEY !== gcMjhlRtpMathKey(profile) || !gcMjhlRtpReusable(GC_MJHL_RTP_RESULT, profile)) { showToast('请等待当前权重 RTP 复核完成，误差不超过±1个百分点后保存。', 'warning'); return; }
        gcMjhlWrite(GC_URL.mjhlAgentSave, { lineAgent:line, expectedRevision:$('#mjhlAgentStatus').data('revision') || '0', configJson:JSON.stringify(cfg), simulated:JSON.stringify(GC_MJHL_RTP_RESULT), __RequestVerificationToken:gcLineToken() }, function (data) {
            if (seq !== GC_MJHL_LOAD_SEQ || line !== gcCurLine() || !gcIsMjhl()) return;
            gcMsg(data); gcMjhlControls(); if (data && data.code == 1) gcMjhlLoadConfig();
        });
    }

    function gcMjhlWrite(url, para, callback) {
        if (GC_MJHL_WRITING) return;
        GC_MJHL_WRITING = true; gcMjhlControls();
        $.ajax({ url:url, type:'POST', dataType:'json', data:para, timeout:15000 })
            .done(callback)
            .fail(function () { callback({code:0, content:'请求失败或超时，请刷新确认配置状态后再操作。'}); })
            .always(function () { GC_MJHL_WRITING = false; gcMjhlControls(); });
    }
    function gcMjhlChangeInheritance(copy) {
        var line = gcCurLine(), meta = GC_MJHL_META, seq = GC_MJHL_LOAD_SEQ;
        if (!gcIsMjhl() || !line || line === '*' || !GC_MJHL_AGENT_CAN_EDIT || GC_MJHL_LOADED_LINE !== line || !meta || meta.lineAgent !== line || GC_MJHL_WRITING) return;
        if (!meta.defaultAvailable) { showToast('请先保存默认配置。', 'warning'); return; }
        if (copy === !!meta.configured) return;
        var question = copy ? '确定把当前已保存的默认参数和权重复制给【' + line + '】吗？复制后本线可独立调参，不再跟随默认配置。'
            : '确定收回【' + line + '】的独立配置吗？本线将改用默认参数和权重，并跟随后续默认配置更新。';
        confirm(question + '\n本页未保存的修改将放弃。', function () {
            if (GC_MJHL_WRITING || seq !== GC_MJHL_LOAD_SEQ || line !== gcCurLine() || !gcIsMjhl()) return;
            gcMjhlCancelRtp();
            gcMjhlWrite(copy ? GC_URL.mjhlAgentCopy : GC_URL.mjhlAgentRecall, {lineAgent:line, expectedRevision:meta.revision, expectedDefaultRevision:meta.defaultRevision, __RequestVerificationToken:gcLineToken()}, function (data) {
                if (seq !== GC_MJHL_LOAD_SEQ || line !== gcCurLine() || !gcIsMjhl()) return;
                gcMsg(data);
                if (data && data.code == 1) { GC_MJHL_AGENT_CAN_EDIT = false; delete GC_MJHL_RTP_CACHE[line]; gcReloadLinesAndTables(); }
            });
        });
    }

    function gcApplyType() {
        if (window.labaWeightsClear) window.labaWeightsClear();
        if (window.mjhlWeightsClear) window.mjhlWeightsClear();
        if (window.phenixConfigClear) window.phenixConfigClear();
        if (window.rabbitPayoutClear) window.rabbitPayoutClear();
        if (window.rabbitConfigClear) window.rabbitConfigClear();
        if (window.attMhbClear) window.attMhbClear();
        var type = gcGetType();
        $('#gcForm').toggleClass('gc-laba-mode', gcLabaSubType() > 0);
        $('.gc-only-0,.gc-only-1,.gc-only-2,.gc-only-3').hide();
        $('.gc-common').show();
        $('.gc-base-info').show();
        if (type >= 0 && type <= 3) {
            $('.gc-only-' + type).show();
            if (type === 0) {
                $('#gcMinBetLbl').text('最低压分');
                $('#gcMaxBetLbl').text('最高压分');
            } else {
                $('#gcMinBetLbl').text('最小押分');
                $('#gcMaxBetLbl').text('最大押分');
            }
            $('#gcScoreSwitchLbl').text((type === 1 || type === 3) ? '每次增加的分值' : '每次提升的炮值（0.1-0.9）');
            var gcSsDecimal = (type === 2 || (type === 3 && gcIsMjhl()));
            $('#gcScoreSwitch').attr('step', gcSsDecimal ? '0.1' : '1');
            $('#gcScoreSwitch').attr('min', gcSsDecimal ? '0.1' : '1');
            $('#gcScoreSwitch').val(gcNormSs($('#gcScoreSwitch').val(), type));
            if (type === 1 && $('#gcPayoutTable tbody tr').length === 0) gcBuildPayoutTable();
            if (type === 1) gcUpdateJpBox(); else $('#gcJpBox').hide();
            gcSyncGoldFinger();
            if (type === 0) gcBuildBetSpec();
        }
        // 三个拉霸（明星97/水果机/水浒传）最小/最大押分只能为整数（步进 1；保存时另有整数校验）
        $('#gcMinBet').attr('step', gcLabaSubType() > 0 ? '1' : '0.1');
        $('#gcMaxBet').attr('step', gcLabaSubType() > 0 ? '1' : '0.1');
        // 麻将胡了(54)：0.1分精度押注，游戏内精确结算小数分
        var mjhl = gcIsMjhl();
        $('#gcMjhlBetHint').toggle(mjhl);
        if (mjhl) {
            $('#gcMinBetLbl').text('最小押注（分）');
            $('#gcMaxBetLbl').text('最大押注（分）');
            $('#gcScoreSwitchLbl').text('点击加减幅度（每次增加的分值）');
            $('#gcMinBet,#gcMaxBet,#gcScoreSwitch').attr('step', '0.1').attr('min', '0.1');
        } else {
            $('#gcMinBet,#gcMaxBet').attr('min', '0');
        }
        gcApplyViceDraw();
        $('#gcNewTable').toggle(!gcCurLine());
        gcMjhlApplyMode(gcIsMjhl());
    }

    function gcUpdateSaveBtn() {
        var isNew = parseInt($('#gcId').val(), 10) < 0;
        if ($('#gcGameId').val() === '55') { $('#gcSave').text(isNew ? '新建当前桌台' : '保存并热更新'); return; }
        $('#gcSave').text((gcLabaSubType() > 0 || $('#gcGameId').val() === '5' || $('#gcGameId').val() === '25') ? '保存并热更新' : (isNew ? '新建桌台' : '更新桌台'));
    }

    function gcLoadTables(afterLoad) {
        var requestSeq = (gcLoadTables.requestSeq || 0) + 1;
        gcLoadTables.requestSeq = requestSeq;
        var gameId = parseInt($('#gcGameSel').val(), 10);
        if (gameId === 54) {
            $('#gcGameId').val(54); $('#gcGameType').val(3); gcApplyType();
            gcMjhlLoadConfig();
            return;
        }
        var gameType = parseInt($('#gcGameSel').find('option:selected').attr('data-type'), 10);
        $('#gcGameId').val(isNaN(gameId) ? -1 : gameId);
        $('#gcGameType').val(isNaN(gameType) ? -1 : gameType);
        gcApplyType();
        $('#gcTableList').empty();
        GC_TABLES = [];
        if (isNaN(gameId) || gameId < 0) {
            $('#gcTableEmpty').show().text('请选择上方游戏以加载桌台。');
            $('#gcCurTableName').text('');
            $('#gcId').val(-1);
            gcSetParaVisible(false);
            gcUpdateSaveBtn();
            return;
        }
        var requestLine = gcCurLine();
        request(GC_URL.tableConfig, { GAME_ID: gameId, GAME_TYPE: gameType, LINE: requestLine }, function (data) {
            var currentGameId = parseInt($('#gcGameSel').val(), 10);
            var currentGameType = parseInt($('#gcGameSel').find('option:selected').attr('data-type'), 10);
            if (requestSeq !== gcLoadTables.requestSeq || currentGameId !== gameId || currentGameType !== gameType || gcCurLine() !== requestLine) {
                return;
            }
            if (!data || data.code != 1) {
                gcMsg(data);
                return;
            }
            GC_TABLES = data.datas || [];
            gcRenderTableList();
            gcSetParaVisible(true);
            if (typeof afterLoad === 'function') afterLoad();
            else if (gcCurLine()) {
                if (GC_TABLES.length > 0) gcSelectTableById(GC_TABLES[0].id);
                else gcSetParaVisible(false);
            }
            else if (gameType === 3) {
                if (GC_TABLES.length > 0) gcSelectTableById(GC_TABLES[0].id);
                else gcPrepareNewTableForm(1);
            }
            else gcPrepareNewTableForm(1);
        });
    }

    function gcFill(t) {
        if (!t) return;
        var type = gcGetType();
        $('#gcId').val(t.id);
        $('#gcTableName').val(t.tableName);
        $('#gcMinBet').val(t.minBet);
        $('#gcMaxBet').val(t.maxBet);
        $('#gcCoinSc').val(t.coinSc);
        $('#gcExCoin').val(t.exCoin);
        $('#gcCoinNeed').val(t.coinNeed);
        $('#gcGameMo').val(t.gameMo);
        var gcFillSs = (t.scoreSwitch !== undefined && t.scoreSwitch !== null) ? t.scoreSwitch : 0;
        gcFillSs = gcNormSs(gcFillSs, type);
        $('#gcScoreSwitch').val(gcFillSs);
        $('#gcIdleSec').val(t.idleFireTimeoutSec);
        $('#gcEnabled').prop('checked', t.enabled == 1);
        if (type === 0) {
            gcFillBetSpec(t);
            $('#gcBetTime').val(t.betTime !== undefined ? t.betTime : 10);
            $('#gcScLimitSing').val(t.scLimitSing !== undefined ? t.scLimitSing : 3000);
            $('#gcScLimitAll').val(t.scLimitAll !== undefined ? t.scLimitAll : 10000);
            $('#gcBankerScNeed').val(t.bankerScNeed !== undefined ? t.bankerScNeed : 500000);
            $('#gcBetMaxVice').val(t.betMaxVice !== undefined ? t.betMaxVice : 1000);
            $('#gcBetMaxDraw').val(t.betMaxDraw !== undefined ? t.betMaxDraw : 1000);
            $('#gcBetMinVice').val(t.betMinVice !== undefined ? t.betMinVice : 10);
            $('#gcDif').val(t.dif);
            $('#gcHar').val(t.har);
            $('#gcSiteType').val(t.siteType);
            $('#gcBankerDif').val(t.bankerDif);
            $('#gcBankerHar').val(t.bankerHar);
            $('#gcBankerSiteType').val(t.bankerSiteType);
            // 庄家抽水：库内千分比 → 页面百分比显示（30 = 3%）
            var bpVal = (t.bankerPer !== undefined && t.bankerPer !== null) ? t.bankerPer : 30;
            $('#gcBankerPer').val(bpVal / 10);
            $('#gcBankerPerRaw').val(bpVal);
            gcFillChips(t.betScores);
        } else if (type === 1) {
            $('#gcHypeType').val(t.hypeType);
            $('#gcCardDif').val(t.cardDif);
            gcFillPayout(t);
        } else if (type === 2) {
            $('#gcFishDif').val(t.fishDif);
            $('#gcFishSiteType').val(1); // 场地类型已隐藏，固定中场地(1)
        } else if (type === 3) {
            // 拉霸按桌筹码档位(1~5级)：与押注类同管道(roomtableconfig_bet)，回填五个输入框
            gcFillChips(t.betScores);
        }
        if (window.labaWeightsLoad) window.labaWeightsLoad();
        if (window.mjhlWeightsLoad) window.mjhlWeightsLoad();
        if (window.phenixConfigLoad) window.phenixConfigLoad();
        if (window.rabbitPayoutLoad) window.rabbitPayoutLoad();
        if (window.rabbitConfigLoad) window.rabbitConfigLoad();
        if (window.attMhbLoad) window.attMhbLoad();
        $('#gcCurTableName').text('当前编辑：' + t.tableName);
        gcSyncSwitch();
        gcUpdateSaveBtn();
    }

    function gcFillChips(scores) {
        var arr = (scores || '').split(',');
        for (var i = 0; i < 5; i++) {
            var v = (i < arr.length && arr[i] !== '') ? arr[i] : 0;
            $('#gcChip' + i).val(v);
        }
    }

    function gcCollectChips() {
        // 拉霸类不再提供一到五级筹码：提交空串，后端清除按桌筹码（客户端回退房间级默认）
        if (gcGetType() === 3) { $('#gcBetScores').val(''); return; }
        var arr = [];
        for (var i = 0; i < 5; i++) {
            var v = parseInt($('#gcChip' + i).val(), 10);
            arr.push(isNaN(v) ? 0 : v);
        }
        $('#gcBetScores').val(arr.join(','));
    }

