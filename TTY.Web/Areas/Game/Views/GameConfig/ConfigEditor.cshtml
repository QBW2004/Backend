        { n: '西瓜·大',       v: 20,  panels: [7] },
        { n: '西瓜·小',       v: 3,   panels: [8] },
        { n: '星星·大',       v: 30,  panels: [20] },
        { n: '星星·小',       v: 3,   panels: [19] },
        { n: '双7·大',        v: 40,  panels: [15] },
        { n: '双7·小',        v: 3,   panels: [14] },
        { n: 'BAR·大',        v: 120, panels: [3] },
        { n: 'BAR·小',        v: 50,  panels: [2] },
        { n: '送灯位·免费局 1~3 次', v: 0, panels: [9] },
        { n: '送灯位·免费局 3~6 次', v: 0, panels: [21] }
    ];
    function fruitRtpPreview() {
        var c = [0, 0, 0, 0, 0, 0, 0, 0], sum = 0, p9 = 0, p21 = 0;
        for (var i = 0; i < 24; i++) {
            var w = parseInt($('[name=WheelProb' + i + ']').val()) || 0;
            sum += w;
            if (i === 9) p9 = w / 10000; else if (i === 21) p21 = w / 10000;
            else if (FRUIT_AREA[i] >= 0) c[FRUIT_AREA[i]] += w / 10000 * FRUIT_RAT[i];
        }
        var g = p9 * 2 + p21 * 4.5;
        var mean = 0;
        for (var a = 0; a < 8; a++) mean += c[a];
        mean /= 8;
        var rtp = (g < 1 && sum > 0) ? mean / (1 - g) : 0;
        var maxDev = 0, maxA = -1;
        for (var a2 = 0; a2 < 8; a2++) {
            var dev = (mean > 0) ? Math.abs(c[a2] - mean) / mean : 0;
            if (dev > maxDev) { maxDev = dev; maxA = a2; }
        }
        var html = '指向概率合计：' + sum + ' / 10000；送灯率：' + ((p9 + p21) * 100).toFixed(2) + '%；g=' + g.toFixed(4) +
            '；理论 RTP：<b>' + (rtp * 100).toFixed(2) + '%</b><br/>各区 c_a（Σ概率×倍率）：';
        for (var a3 = 0; a3 < 8; a3++)
            html += FRUIT_AREA_NAME[a3] + '=' + c[a3].toFixed(3) + '&nbsp;';
        if (sum === 0) html += '<br/>（权重全 0：保存时将自动使用内置默认 90% 面板表；新建桌台默认预填该表）';
        else if (mean > 0 && maxDev > 0.05) html += '<br/><span style="color:#c78a00;">提示：' + FRUIT_AREA_NAME[maxA] +
            ' 区与其它区差异约 ' + (maxDev * 100).toFixed(1) + '%（无拦截，可自由配置）。</span>';
        else if (sum > 0) html += '<br/><span style="color:#2e9e5b;">各区返奖接近（差异 ≤5%），配置均衡。</span>';
        $('#gcFruitRtpPreview').html(html);
    }

    function gcBuildLabaPayoutTable(subType) {
        var st = parseInt(subType, 10);
        var $tb = $('#gcLabaPayoutTable tbody');
        $tb.empty();
        if (st === 2) {
            // 水果拉霸：机台设定=大转盘指向概率（倍率客户端写死，仅展示）+ 每日次数
            // 按图标归类每类一行（类值=该类各面板位合计）；隐藏逐面板位输入维持后端 24 面板位契约
            $('#gcLabaPayoutTitle').text('转盘结果出现机会与每日次数限制');
            $('#gcLabaTh1').text('符号');
            $('#gcLabaTh2').text('结果出现机会（每 10000 次的相对单位）');
            $('#gcLabaTh3').text('奖励倍数（程序固定，只展示）');
            $('#gcLabaTh4').text('每天最多出现次数（留空不限，0=当天不出现）').show();
            $('#gcLabaPayoutBox').show();
            $.each(LABA_FRUIT_CATS, function (i, c) {
                var hidden = '';
                $.each(c.panels, function (j, p) {
                    hidden += '<input type="hidden" name="WheelProb' + p + '" id="gcLabaWp' + p + '" class="gc-laba-wp" value="0" />'
                        + '<input type="hidden" name="WheelStock' + p + '" id="gcLabaWs' + p + '" class="gc-laba-ws" value="" />';
                });
                $tb.append('<tr>' +
                    '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#36404a;">' + c.n + '</td>' +
                    '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" name="WheelProbCat' + i + '" id="gcLabaWpCat' + i + '" class="gc-input gc-laba-wp-cat" min="0" max="10000" step="1" value="0" /></td>' +
                    '<td style="padding:6px 8px;border:1px solid #e5e9f0;font-size:13px;color:#8a94a1;text-align:center;">' + c.v + '</td>' +
                    '<td style="padding:4px;border:1px solid #e5e9f0;"><input type="number" name="WheelStockCat' + i + '" id="gcLabaWsCat' + i + '" class="gc-input gc-laba-ws-cat" min="0" max="1000000" step="1" placeholder="不限" />' + hidden + '</td>' +
                    '</tr>');
            });
            $tb.find('.gc-laba-wp-cat, .gc-laba-ws-cat').on('input', function () {
                gcSyncWheelPanels();
                gcUpdateLabaWheelSum();
                fruitRtpPreview();
            });
            gcSyncWheelPanels();
            gcUpdateLabaWheelSum();
            fruitRtpPreview();
            return;
        }
        // 水浒传/明星97：赔付表由服务端权威（水浒双端硬编码、明星97 走「奖项配置」结果类表），
        // 无机台设定项；仅水果拉霸有大转盘面板配置
        $('#gcLabaPayoutBox').hide();
    }

    // 把每类"结果出现机会/每日次数"均分到该类各面板位（隐藏输入，维持后端 24 面板位契约）：
    // 每日次数留空=不限→各面板位留空；非空→均分（余数加到前几个面板位）
    function gcSyncWheelPanels() {
        $.each(LABA_FRUIT_CATS, function (i, c) {
            var n = c.panels.length;
            var total = parseInt($('#gcLabaWpCat' + i).val(), 10);
            if (isNaN(total) || total < 0) total = 0;
            var base = Math.floor(total / n), rem = total % n;
            $.each(c.panels, function (j, p) {
                $('#gcLabaWp' + p).val(base + (j < rem ? 1 : 0));
            });
            var sv = $('#gcLabaWsCat' + i).val();
            if (sv === '' || sv === null || sv === undefined) {
                $.each(c.panels, function (j, p) { $('#gcLabaWs' + p).val(''); });
            } else {
                var st = parseInt(sv, 10);
                if (isNaN(st) || st < 0) st = 0;
                var sBase = Math.floor(st / n), sRem = st % n;
                $.each(c.panels, function (j, p) {
                    $('#gcLabaWs' + p).val(sBase + (j < sRem ? 1 : 0));
                });
            }
        });
    }

    function gcUpdateLabaWheelSum() {
        var sum = 0;
        $.each(LABA_FRUIT_CATS, function (i, c) {
            sum += parseFloat($('#gcLabaWpCat' + i).val()) || 0;
        });
        var $el = $('#gcLabaPayoutSum');
        $el.text('结果出现机会合计：' + sum + ' / 10000（全部为 0 时保存会自动使用系统默认 90% 面板表；两个送灯位可分别设置，送灯位=中奖后赠送免费局，9 送 1~3 次、21 送 3~6 次）');
        $el.css('color', sum > 10000 ? '#d33b3b' : '#9aa4b1');
    }

    function gcFillLabaPayout(t) {
        gcBuildLabaPayoutTable(t.labaSubType);
        var st = parseInt(t.labaSubType, 10);
        if (st === 2) {
            // 每类回显：结果出现机会=该类各面板位权重之和；每日次数=该类之和（全空=不限）
            $.each(LABA_FRUIT_CATS, function (i, c) {
                var pSum = 0, sSum = 0, sAllBlank = true;
                $.each(c.panels, function (j, p) {
                    var wv = t['wheelProb' + p];
                    if (wv !== undefined && wv !== null && wv > 0) pSum += wv;
                    var sv = t['wheelStock' + p];
                    if (sv !== undefined && sv !== null && sv >= 0) { sSum += sv; sAllBlank = false; }
                });
                $('#gcLabaWpCat' + i).val(pSum);
                $('#gcLabaWsCat' + i).val(sAllBlank ? '' : sSum);
            });
            gcSyncWheelPanels();
            gcUpdateLabaWheelSum();
            fruitRtpPreview();
            return;
        }
        // 水浒传/明星97：赔付表由服务端权威（水浒双端硬编码、明星97 走「奖项配置」结果类表），无机台设定项
    }

    // 庄闲/和(幸运六狮)、皇冠(彩金单挑)限红：按游戏动态显示与改名；
    // 其余押注玩法无副玩法/和门，整行隐藏并禁用 input，避免 serializeObject 误提交覆盖库值
    function gcApplyViceDraw() {
        var gid = parseInt($('#gcGameSel').val(), 10);
        var lion = (gid === 10), crown = (gid === 2);
        var show = lion || crown;
        $('#gcViceDrawRow').toggle(show);
        $('#gcViceDrawHint').toggle(show);
        if (show) {
            $('#gcViceMaxLbl').text(crown ? '皇冠单次最高押分' : '庄/闲单门最高押分');
            $('#gcViceMinField').toggle(crown);
            $('#gcDrawMaxField').toggle(lion);
        }
        $('#gcViceDrawRow input').prop('disabled', !show);
    }

    function gcApplyType() {
        var type = gcGetType();
        $('.gc-only-0,.gc-only-1,.gc-only-2,.gc-only-3').hide();
        $('.gc-common').show();
        $('.gc-base-info').show();
        if (type >= 0 && type <= 3) {
            $('.gc-only-' + type).show();
            if (type === 0) {
                $('#gcMinBetLbl').text('最低压分');
                $('#gcMaxBetLbl').text('最高压分');
            } else {
                $('#gcMinBetLbl').text('最小押分');
                $('#gcMaxBetLbl').text('最大押分');
            }
            $('#gcScoreSwitchLbl').text((type === 1 || type === 3) ? '每次增加的分值' : '每次提升的炮值（0.1-0.9）');
            var gcSsMin = (type === 2) ? 0.1 : 1;
            $('#gcScoreSwitch').attr('step', (type === 2) ? '0.1' : '1');
            $('#gcScoreSwitch').attr('min', (type === 2) ? '0.1' : '1');
            $('#gcScoreSwitch').val(gcNormSs($('#gcScoreSwitch').val(), type));
            if (type === 1 && $('#gcPayoutTable tbody tr').length === 0) gcBuildPayoutTable();
            if (type === 1) gcUpdateJpBox(); else $('#gcJpBox').hide();
            if (type === 0) gcBuildBetSpec();
        }
        // 明星97/水浒传 RTP 控制区：共用同一闭环参数面板（结果类表按游戏切换），
        // 仅拉霸 subType==1/3 显示；与水果拉霸区互斥，不可见一方的 input 置 disabled，
        // 避免 serializeObject 把另一套同 name 字段误带上
        var isMx97Rtp = (type === 3 && gcLabaSubType() === 1);
        var isShzRtp = (type === 3 && gcLabaSubType() === 3);
        var isRtpGame = isMx97Rtp || isShzRtp;
        $('#gcRtpBox').toggle(isRtpGame);
        if (isRtpGame) {
            $('#gcRtpTitle').text('长期返奖率控制（' + (isMx97Rtp ? '明星97' : '水浒传') + ' · 优先按控制结果生成）');
            if (isMx97Rtp) {
                $('#gcShzComboTable').hide();
                $('#gcMx97ComboTable').show();
                if ($('#gcMx97ComboTable tbody tr').length === 0) gcBuildMx97ComboTable();
                $('#gcRtpComboHint').text('奖励倍数和出现机会留空=使用系统默认；每天最多出现次数留空=不限、0=当天不出现（每天 0 点重置）。出现机会=每 10000 次实际出现次数（填 500=实际出现 5%，填多少就出现多少）；表中"不中奖（余量）"=10000−Σ出现机会（留空行按内置默认出现率计算），未命中奖励即按此比例不中奖。返奖率由出现机会与固定赔率直接决定；目标RTP闭环默认关闭，需要自动微调返奖率时设置"偏差纠正速度">0 启用（仅微调）。全盘七（348）按全盘七 9 个（329）结算，无需单独配置。');
            } else {
                $('#gcMx97ComboTable').hide();
                $('#gcShzComboTable').show();
                if ($('#gcShzComboTable tbody tr').length === 0) gcBuildShzComboTable();
                $('#gcRtpComboHint').text('奖励倍数由程序固定，不能调整；只需设置结果出现机会。出现机会=每 10000 次实际出现次数（填 500=实际出现 5%，填多少就出现多少）；表中"不中奖（余量）"=10000−Σ出现机会（留空行按内置默认出现率计算），未命中奖励即按此比例不中奖。返奖率由出现机会与固定赔率直接决定；目标RTP闭环默认关闭，需要自动微调返奖率时设置"偏差纠正速度">0 启用（仅微调）。每天最多出现次数仅对整盘/混合大奖（440-451）生效，留空=不限、0=当天不出现（每天 0 点重置）。纯万能线（430-432）出现机会很低是正常现象。');
            }
        }
        $('#gcRtpBox input, #gcRtpBox select').prop('disabled', !isRtpGame);
        // 水果拉霸 RTP 控制区：仅拉霸 subType==2（GameId=40）显示
        var isFruitRtp = (type === 3 && gcLabaSubType() === 2);
        $('#gcFruitRtpBox').toggle(isFruitRtp);
        $('#gcFruitRtpBox input, #gcFruitRtpBox select').prop('disabled', !isFruitRtp);
        // 三个拉霸（明星97/水果机/水浒传）最小/最大押分只能为整数（步进 1；保存时另有整数校验）
        $('#gcMinBet').attr('step', gcLabaSubType() > 0 ? '1' : '0.1');
        $('#gcMaxBet').attr('step', gcLabaSubType() > 0 ? '1' : '0.1');
        gcApplyViceDraw();
        $('#gcNewTable').toggle(true);
        // 高级参数折叠区联动：非拉霸类型隐藏引导条与容器；拉霸类型显示引导条且默认收起，
        // 用户点"展开设置"后才展示 RTP/转盘/每日次数（简化日常操作路径）
        var isLabaType = type === 3;
        $('#gcAdvHead').toggle(isLabaType);
        if (!isLabaType) $('#gcAdvBody').hide();
    }

    // 拉霸高级参数（RTP/转盘概率/每日次数）折叠开关：仅对拉霸类型显示引导条
    function gcToggleAdv(expand) {
        var isLaba = gcGetType() === 3;
        if (!isLaba) { $('#gcAdvHead').hide(); $('#gcAdvBody').hide(); return; }
        $('#gcAdvHead').show();
        if (typeof expand === 'boolean') {
            $('#gcAdvBody').toggle(expand);
        } else {
            // 不传参 = 切换
            $('#gcAdvBody').toggle();
        }
        $('#gcAdvToggle').text($('#gcAdvBody').is(':visible') ? '收起设置' : '展开设置');
    }

    function gcUpdateSaveBtn() {
        var isNew = parseInt($('#gcId').val(), 10) < 0;
        $('#gcSave').text(isNew ? '新建桌台' : '更新桌台');
    }

    function gcLoadTables(afterLoad) {
        var requestSeq = (gcLoadTables.requestSeq || 0) + 1;
        gcLoadTables.requestSeq = requestSeq;
        var gameId = parseInt($('#gcGameSel').val(), 10);
        var gameType = parseInt($('#gcGameSel').find('option:selected').attr('data-type'), 10);
        $('#gcGameId').val(isNaN(gameId) ? -1 : gameId);
        $('#gcGameType').val(isNaN(gameType) ? -1 : gameType);
        gcApplyType();
        $('#gcTableList').empty();
        GC_TABLES = [];
        if (isNaN(gameId) || gameId < 0) {
            $('#gcTableEmpty').show().text('请选择上方游戏以加载桌台。');
            $('#gcCurTableName').text('');
            $('#gcId').val(-1);
            gcSetParaVisible(false);
            gcUpdateSaveBtn();
            return;
        }
        request(GC_URL.tableConfig, { GAME_ID: gameId, GAME_TYPE: gameType }, function (data) {
            var currentGameId = parseInt($('#gcGameSel').val(), 10);
            var currentGameType = parseInt($('#gcGameSel').find('option:selected').attr('data-type'), 10);
            if (requestSeq !== gcLoadTables.requestSeq || currentGameId !== gameId || currentGameType !== gameType) {
                return;
            }
            if (!data || data.code != 1) {
                gcMsg(data);
                return;
            }
            GC_TABLES = data.datas || [];
            gcRenderTableList();
            gcSetParaVisible(true);
            if (typeof afterLoad === 'function') afterLoad();
            else if (gameType === 3) {
                if (GC_TABLES.length > 0) gcSelectTableById(GC_TABLES[0].id);
            }
            else gcNewTable();
        });
    }

    function gcFill(t) {
        if (!t) return;
        var type = gcGetType();
        $('#gcId').val(t.id);
        $('#gcTableName').val(t.tableName);
        $('#gcMinBet').val(t.minBet);
        $('#gcMaxBet').val(t.maxBet);
        $('#gcCoinSc').val(t.coinSc);
        $('#gcExCoin').val(t.exCoin);
        $('#gcCoinNeed').val(t.coinNeed);
        $('#gcGameMo').val(t.gameMo);
        var gcFillSs = (t.scoreSwitch !== undefined && t.scoreSwitch !== null) ? t.scoreSwitch : 0;
        gcFillSs = gcNormSs(gcFillSs, type);
        $('#gcScoreSwitch').val(gcFillSs);
        $('#gcIdleSec').val(t.idleFireTimeoutSec);
        $('#gcEnabled').prop('checked', t.enabled == 1);
        if (type === 0) {
            gcFillBetSpec(t);
            $('#gcBetTime').val(t.betTime !== undefined ? t.betTime : 10);
            $('#gcScLimitSing').val(t.scLimitSing !== undefined ? t.scLimitSing : 3000);
            $('#gcScLimitAll').val(t.scLimitAll !== undefined ? t.scLimitAll : 10000);
            $('#gcBankerScNeed').val(t.bankerScNeed !== undefined ? t.bankerScNeed : 500000);
            $('#gcBetMaxVice').val(t.betMaxVice !== undefined ? t.betMaxVice : 1000);
            $('#gcBetMaxDraw').val(t.betMaxDraw !== undefined ? t.betMaxDraw : 1000);
            $('#gcBetMinVice').val(t.betMinVice !== undefined ? t.betMinVice : 10);
            $('#gcDif').val(t.dif);
            $('#gcHar').val(t.har);
            $('#gcSiteType').val(t.siteType);
            $('#gcBankerDif').val(t.bankerDif);
            $('#gcBankerHar').val(t.bankerHar);
            $('#gcBankerSiteType').val(t.bankerSiteType);
            // 庄家抽水：库内千分比 → 页面百分比显示（30 = 3%）
            var bpVal = (t.bankerPer !== undefined && t.bankerPer !== null) ? t.bankerPer : 30;
            $('#gcBankerPer').val(bpVal / 10);
            $('#gcBankerPerRaw').val(bpVal);
            gcFillChips(t.betScores);
        } else if (type === 1) {
            $('#gcHypeType').val(t.hypeType);
            $('#gcCardDif').val(t.cardDif);
            gcFillPayout(t);
        } else if (type === 2) {
            $('#gcFishDif').val(t.fishDif);
            $('#gcFishSiteType').val(1); // 场地类型已隐藏，固定中场地(1)
        } else if (type === 3) {
            gcFillLabaPayout(t);
            // 拉霸按桌筹码档位(1~5级)：与押注类同管道(roomtableconfig_bet)，回填五个输入框
            gcFillChips(t.betScores);
            if (gcLabaSubType() === 1) gcFillMx97(t);
            else if (gcLabaSubType() === 2) gcFillFruitRtp(t);
            else if (gcLabaSubType() === 3) gcFillShz(t);
        }
        $('#gcCurTableName').text('当前编辑：' + t.tableName);
        gcSyncSwitch();
        gcUpdateSaveBtn();
    }

    function gcFillChips(scores) {
        var arr = (scores || '').split(',');
        for (var i = 0; i < 5; i++) {
            var v = (i < arr.length && arr[i] !== '') ? arr[i] : 0;
            $('#gcChip' + i).val(v);
        }
    }

    function gcCollectChips() {
        var arr = [];
        for (var i = 0; i < 5; i++) {
            var v = parseInt($('#gcChip' + i).val(), 10);
            arr.push(isNaN(v) ? 0 : v);
        }
        $('#gcBetScores').val(arr.join(','));
    }

