<section id="mjhlWeights" style="display:none;">
    <style>
        #mjhlWeights{--mw-blue:#2165d6;--mw-dark:#174d8e;--mw-ink:#243449;--mw-muted:#718096;--mw-line:#d7e1ed;--mw-good:#168052;--mw-warn:#80551a;--mw-bad:#a33d3d;margin:20px 0;padding:14px;border:1px solid #cbd7e8;border-radius:8px;background:#f3f6fa;color:var(--mw-ink);font-size:12px;line-height:1.45}
