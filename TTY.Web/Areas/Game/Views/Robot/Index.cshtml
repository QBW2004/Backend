@{
    Layout = "~/Views/Shared/Layout/_ContentLayout.cshtml";

    ViewBag.RouteMap = "机器人管理";
    M_LoginUser loginUser = WebHelper.GetLoginInfo();
}
<script src="~/Scripts/jquery.form.js"></script>
@section include_res{
    <script>
        $(function () {
            // 加载指定的模块
            easyloader.load(['textbox', 'numberbox', 'combobox', 'linkbutton', 'datagrid', 'timespinner', 'dialog'], function () {
                //适应窗口大小变化
                $(window).resize(setGridSize);
                //初始化插件
                pluginInit();
                //初始化查询
                initRobotWorkspace();
                //根据游戏类型查询所有游戏
                robotInputsReady = true;
                configureRobotInputs();
                //列表“代理线”筛选
                request('/Game/Robot/GetRobotLineFilter', {}, function (data) {
                    $('#srchLine').combobox('loadData', data || []);
                    $('#seatFilterLine').combobox('loadData', data || []);
                });
                loadRobotSeatGameFilter();
            });
        })
        var robotActiveTab = 'live';
        function initRobotWorkspace() {
            $('.robot-tab').on('click', function () { selectRobotTab($(this).attr('data-tab')); });
            $('.robot-tab').on('keydown', function (event) {
                var tabs = $('.robot-tab'), index = tabs.index(this), next = index;
                if (event.which === 37) next = (index + tabs.length - 1) % tabs.length;
                else if (event.which === 39) next = (index + 1) % tabs.length;
                else if (event.which === 36) next = 0;
                else if (event.which === 35) next = tabs.length - 1;
                else return;
                event.preventDefault();
                tabs.eq(next).focus().click();
            });
            selectRobotTab('live');
        }
        function selectRobotTab(name) {
            robotActiveTab = name;
            $('.robot-more').removeAttr('open');
            $('.robot-tab').each(function () {
                var selected = $(this).attr('data-tab') === name;
                $(this).toggleClass('is-active', selected).attr('aria-selected', String(selected)).attr('tabindex', selected ? 0 : -1);
            });
            $('.robot-panel').hide().attr('aria-hidden', 'true');
            $('#robot-' + name).show().attr('aria-hidden', 'false');
            if (name === 'live') queryRobotSeats();
            else if (name === 'quota') queryData();
            else if (name === 'accounts') queryRobotAccounts();
            else if (name === 'schedule') { loadRobotShuffleSchedule(); loadRobotPlayTime(); }
            setGridSize();
        }
        //重置表格大小
        function setGridSize(param) {
            var ids = { live: 'tb_RobotSeat', quota: 'tb_Robot', accounts: 'tb_RobotAccount' };
            var grid = $('#' + ids[robotActiveTab]);
            if (!grid.length || !grid.data('datagrid')) return;
            var panel = grid.datagrid('getPanel');
            var height = Math.max(300, $(window).height() - panel.offset().top - 16);
            resizeGrid(ids[robotActiveTab], $('#robot-' + robotActiveTab).width(), height);
        }
        //查询数据
        function queryData() {
            var para = $("#frm_srch").serializeObject();
            bindGridData(para);
        }

        function updateRobotOverview(summary) {
            $.each(['Total', 'Online', 'Seated', 'Idle'], function (_, key) {
                $('#robotStat' + key).text(summary && summary[key] !== undefined ? summary[key] : '—');
            });
            $('#robotSnapshot').text(summary ? '全局状态 · 更新于 ' + new Date().toLocaleTimeString() : '状态暂不可用，请刷新重试');
        }
        function robotListLoaded(data) {
            hideLoading();
            updateRobotOverview(data && data.summary);
            setGridSize();
        }
        function robotListFilter(data) {
            if (!data || !$.isArray(data.rows)) {
                updateRobotOverview(null);
                showMsg(data || { code: 0, content: '机器人状态暂不可用。' });
                return { total: 0, rows: [] };
            }
            return data;
        }
        function robotListError() {
            hideLoading();
            updateRobotOverview(null);
            showMsg({ code: 0, content: '机器人状态读取失败，请刷新重试。' });
        }

        // 当前实际入座的机器人明细（与 robot_seat 配额列表分开，便于逐个移除/调座）
        function getRobotSeatFilterParams() {
            var table = $('#seatFilterTable').textbox('getValue') || '';
            var account = $('#seatFilterAccount').textbox('getValue') || '';
            return {
                SeatGameId: $('#seatFilterGame').combobox('getValue') || -1,
                SeatLine: $('#seatFilterLine').combobox('getValue') || '*',
                SeatTable: table,
                SeatAccount: account,
                SeatStatus: $('#seatFilterStatus').combobox('getValue') || 'all',
                page: 1,
                rows: $('#tb_RobotSeat').data('datagrid') ? $('#tb_RobotSeat').datagrid('options').pageSize : 20
            };
        }
        function queryRobotSeats() {
            var para = getRobotSeatFilterParams();
            if ($('#tb_RobotSeat').data('datagrid')) $('#tb_RobotSeat').datagrid('load', para);
            else bindRobotSeatData(para);
        }
        function filterRobotSeats() {
            queryRobotSeats();
        }
        function resetRobotSeatFilter() {
            $('#seatFilterGame').combobox('setValue', -1);
            $('#seatFilterLine').combobox('setValue', '*');
            $('#seatFilterTable').textbox('clear');
            $('#seatFilterAccount').textbox('clear');
            $('#seatFilterStatus').combobox('setValue', 'all');
            queryRobotSeats();
        }
        function loadRobotSeatGameFilter() {
            request('/Game/Robot/GetGamesTreeData', { GameType: -1 }, function (datas) {
                var games = [{ id: -1, text: '全部游戏', selected: true }];
                for (var i = 0; i < (datas || []).length; i++) {
                    games = games.concat(datas[i].children || []);
                }
                $('#seatFilterGame').combobox('loadData', games).combobox('setValue', -1);
                $('#quotaFilterGame').combobox('loadData', $.extend(true, [], games)).combobox('setValue', -1);
            });
        }
        function bindRobotSeatData(para) {
            $('#tb_RobotSeat').datagrid({
                url: '/Game/Robot/GetRobotSeats',
                queryParams: $.extend({}, para),
                // Pass columns explicitly so EasyUI always resolves the action formatter.
                columns: [[
                    { field: 'UserName', width: 110, title: '账户' },
                    { field: 'UserNick', width: 110, title: '昵称' },
                    { field: 'GAME_NAME', width: 120, title: '游戏' },
                    { field: 'LINE_AGENT', width: 100, title: '代理线', formatter: fmtLine },
                    { field: 'TABLE_NAME', width: 140, title: '机台' },
                    { field: 'SeatIndex', width: 80, title: '座位', formatter: fmtSeat },
                    { field: 'Status', width: 90, title: '状态', formatter: fmtRobotStatus },
                    { field: 'SeatActions', width: 170, title: '操作', formatter: window.fmtSeatAction }
                ]],
                pagination: true,
                fitColumns: true,
                singleSelect: true,
                striped: true,
                rownumbers: true,
                height: 360,
                pageSize: 20,
                pageList: [10, 20, 50],
                idField: 'RobotId',
                onBeforeLoad: setGridSize,
                loadFilter: robotListFilter,
                onLoadSuccess: robotListLoaded,
                onLoadError: robotListError
            });
        }
        function queryRobotAccounts() {
            var para = { SeatAccount: $('#accountFilter').textbox('getValue') || '', page: 1 };
            var grid = $('#tb_RobotAccount');
            if (grid.data('datagrid')) { grid.datagrid('load', para); return; }
            grid.datagrid({
                url: '/Game/Robot/GetRobotSeats', queryParams: para,
                columns: [[
                    { field: 'ck', checkbox: true },
                    { field: 'RobotId', width: 80, title: '编号' },
                    { field: 'UserName', width: 130, title: '账户' },
                    { field: 'UserNick', width: 130, title: '昵称' },
                    { field: 'Gold', width: 110, title: '钻' },
                    { field: 'Lev', width: 65, title: '等级' },
                    { field: 'Sex', width: 65, title: '性别', formatter: function (value) { return Number(value) === 1 ? '女' : '男'; } },
                    { field: 'AccountActions', width: 160, title: '操作', formatter: fmtAccountAction }
                ]],
                pagination: true, fitColumns: true, singleSelect: false,
                checkOnSelect: false, selectOnCheck: false, striped: true, rownumbers: true,
                height: 360, pageSize: 20, pageList: [10, 20, 50], idField: 'RobotId',
                onBeforeLoad: function () { grid.datagrid('clearChecked'); updateAccountSelection(); setGridSize(); },
                loadFilter: robotListFilter, onLoadSuccess: robotListLoaded, onLoadError: robotListError,
                onCheck: updateAccountSelection, onUncheck: updateAccountSelection,
                onCheckAll: updateAccountSelection, onUncheckAll: updateAccountSelection
            });
        }
        function updateAccountSelection() {
            var count = getCheckedRobotAccounts().length;
            $('#robotSelectedCount').text('已选 ' + count + ' 个');
            $('#deleteSelectedAccounts').prop('disabled', count === 0);
        }
        function fmtAccountAction(value, row) {
            window.robotAccountCache = window.robotAccountCache || {};
            window.robotAccountCache[String(row.RobotId)] = row;
            var id = String(row.RobotId).replace(/'/g, "\\'");
            return '<a href="javascript:void(0)" class="blue Lpd5" onclick="showRobotAccountWin(\'' + id + '\')">编辑</a> ' +
                '<a href="javascript:void(0)" class="robot-danger Lpd5" onclick="deleteRobotAccount(\'' + id + '\')">删除账户</a>';
        }
        function fmtRobotStatus(value, row) {
            var state = row.Sitting ? 'seated' : (row.Connected ? 'idle' : 'offline');
            var label = row.Sitting ? '已入座' : (row.Connected ? '在线空闲' : '未上线');
            return '<span class="robot-status robot-status-' + state + '">' + label + '</span>';
        }
        function reloadRobotViews() {
            if ($('#tb_Robot').data('datagrid')) queryData();
            queryRobotSeats();
            if ($('#tb_RobotAccount').data('datagrid')) queryRobotAccounts();
        }
        function seatText(value) {
            return value === null || typeof value === 'undefined' || value === '' ? '未入座' : $('<span/>').text(value).prop('outerHTML');
        }
        function fmtSeatAction(value, rowData) {
            // EasyUI may call a formatter with only the cell value while it is
            // parsing a dynamically loaded grid. Keep the action cell usable in
            // both paths instead of falling back to the raw robot id.
            rowData = rowData || {};
            var id = rowData.RobotId || rowData.robotId || rowData.ID || rowData.UserId || rowData.USER_ID || value || '';
            if (!id) return '<span style="color:#999;">等待入座</span>';
            window.robotAccountCache = window.robotAccountCache || {};
            window.robotAccountCache[String(id)] = rowData;
            var safe = String(id).replace(/'/g, "\\'");
            var actions = [];
            if (rowData.Connected === false && (rowData.Status === '未上线' || rowData.Sitting === false))
                actions.push('<a href="javascript:void(0)" class="blue Lpd5" onclick="showAssignWin(\'' + safe + '\', true)">上线入座</a>');
            else
                actions.push('<a href="javascript:void(0)" class="blue Lpd5" onclick="showAssignWin(\'' + safe + '\', false)">指定座位</a>');
            if (rowData.Sitting) actions.push('<a href="javascript:void(0)" class="blue Lpd5" onclick="removeRobotSeat(\'' + safe + '\')">移除座位</a>');
            return actions.join(' ');
        }
        // The EasyUI markup parser resolves formatter names with eval(). Make
        // the intended formatter explicit on window so the action column never
        // degrades to displaying RobotId when the page is loaded in an iframe.
        window.fmtSeatAction = fmtSeatAction;
        function fmtSeat(value) {
            if (value === null || typeof value === 'undefined' || value === '' || value < 0) return '未入座';
            return '座位' + (Number(value) + 1);
        }
        function removeRobotSeat(id) {
            confirm('确认让该机器人离开当前座位？', function () {
                request('/Game/Robot/RemoveRobotSeat', { RobotId: id, ID: id }, function (data) {
                    showMsg(data);
                    if (data && data.code == 1) reloadRobotViews();
                });
            });
        }
        function shuffleRobots() {
            var min = Number($('#shuffleMinSeconds').numberbox('getValue') || 1);
            var max = Number($('#shuffleMaxSeconds').numberbox('getValue') || 5);
            if (!isFinite(min) || !isFinite(max) || min < 1 || max < min || min > 5 || max > 5) {
                showMsg({ code: 0, content: '离开间隔须为 1~5 秒，且最小值不能大于最大值！' });
                return;
            }
            confirm('确认打乱全部机器人？机器人会按每个' + min + '~' + max + '秒的随机间隔离开当前座位。', function () {
                request('/Game/Robot/ShuffleRobots', { MinDelaySeconds: min, MaxDelaySeconds: max, MinDelayMs: min * 1000, MaxDelayMs: max * 1000 }, function (data) {
                    showMsg(data);
                    if (data && data.code == 1) queryRobotSeats();
                });
            });
        }
        function loadRobotShuffleSchedule() {
            $('#saveRobotSchedule').prop('disabled', true);
            $('#scheduleStatus').text('正在读取…');
            $.ajax({ url: '/Game/Robot/GetRobotShuffleSchedule', type: 'POST', dataType: 'json' }).done(function (data) {
                data = data || {};
                if (data.Enabled === undefined && data.enabled === undefined) {
                    $('#scheduleStatus').text('读取失败，请重新读取');
                    showMsg(data);
                    return;
                }
                $('#shuffleEnabled').prop('checked', data.Enabled === true || data.Enabled === 1 || data.enabled === true || data.enabled === 1);
                var start = data.StartTime || data.startTime || minuteToTime(data.StartMinute !== undefined ? data.StartMinute : data.startMinute) || '02:00';
                var end = data.EndTime || data.endTime || minuteToTime(data.EndMinute !== undefined ? data.EndMinute : data.endMinute) || '05:00';
                $('#shuffleStart').timespinner('setValue', start);
                $('#shuffleEnd').timespinner('setValue', end);
                $('#scheduleStatus').text($('#shuffleEnabled').prop('checked') ? '已启用 · 每日 ' + start + '–' + end : '未启用');
                $('#saveRobotSchedule').prop('disabled', false);
            }).fail(function () {
                $('#scheduleStatus').text('读取失败，请重新读取');
            });
        }
        function loadRobotPlayTime() {
            $('#saveRobotPlayTime').prop('disabled', true);
            $('#playTimeStatus').text('正在读取…');
            $.ajax({ url: '/Game/Robot/GetRobotPlayTime', type: 'POST', dataType: 'json' }).done(function (data) {
                if (!data || data.code != 1 || data.Enabled === undefined) {
                    $('#playTimeStatus').text('读取失败，请重新读取');
                    showMsg(data);
                    return;
                }
                $('#playTimeEnabled').prop('checked', data.Enabled === true);
                $('#playTimeMinHours').numberbox('setValue', data.MinHours);
                $('#playTimeMaxHours').numberbox('setValue', data.MaxHours);
                $('#playTimeStatus').text(data.Enabled ? '已启用 · ' + data.MinHours + '～' + data.MaxHours + ' 小时' : '未启用');
                $('#saveRobotPlayTime').prop('disabled', false);
            }).fail(function () { $('#playTimeStatus').text('读取失败，请重新读取'); });
        }
        function saveRobotPlayTime() {
            if ($('#saveRobotPlayTime').prop('disabled')) return;
            var min = Number($('#playTimeMinHours').numberbox('getValue'));
            var max = Number($('#playTimeMaxHours').numberbox('getValue'));
            if (!isFinite(min) || !isFinite(max) || min < 0.1 || max > 720 || min > max ||
                Math.abs(min * 10 - Math.round(min * 10)) > 0.000001 || Math.abs(max * 10 - Math.round(max * 10)) > 0.000001) {
                showMsg({ code: 0, content: '游玩时长须为0.1～720小时，最多一位小数，且最小值不能大于最大值。' });
                return;
            }
            $('#saveRobotPlayTime').prop('disabled', true);
            request('/Game/Robot/SaveRobotPlayTime', {
                Enabled: $('#playTimeEnabled').prop('checked') ? 1 : 0, MinHours: min, MaxHours: max
            }, function (data) { showMsg(data); loadRobotPlayTime(); });
        }
        function minuteToTime(value) {
            var n = Number(value);
            if (!isFinite(n) || n < 0 || n > 1439) return '';
            return ('0' + Math.floor(n / 60)).slice(-2) + ':' + ('0' + (n % 60)).slice(-2);
        }
        function saveRobotShuffleSchedule() {
            if ($('#saveRobotSchedule').prop('disabled')) return;
            var start = $('#shuffleStart').timespinner('getValue');
            var end = $('#shuffleEnd').timespinner('getValue');
            if (!/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/.test(start) || !/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/.test(end)) {
                showMsg({ code: 0, content: '请输入有效的每日时间（HH:mm）。' });
                return;
            }
            request('/Game/Robot/SaveRobotShuffleSchedule', {
                Enabled: $('#shuffleEnabled').prop('checked') ? 1 : 0,
                StartTime: start, EndTime: end, StartMinute: timeToMinute(start), EndMinute: timeToMinute(end),
                minDelayMs: 1000, maxDelayMs: 5000
            }, function (data) { showMsg(data); if (data && data.code == 1) loadRobotShuffleSchedule(); });
        }
        function timeToMinute(value) {
            var p = String(value || '').split(':');
            return p.length === 2 ? Number(p[0]) * 60 + Number(p[1]) : -1;
        }
        function showShuffleWin() {
            openWin({ winId: '#shuffleWin', title: '【打乱机器人】', height: 280, width: 430, iconCls: 'icon-reload' });
        }
        function showScheduleWin() {
            selectRobotTab('schedule');
        }
        function showAssignWin(robotId, onlineMode) {
            $('#assignRobotId').val(robotId);
            $('#assignOnlineMode').val(onlineMode ? '1' : '0');
            $('#assignGameId').combobox('clear').combobox('loadData', []);
            $('#assignLine').combobox('clear').combobox('loadData', publicLineData());
            $('#assignTable').combobox('clear').combobox('loadData', []);
            request('/Game/Robot/GetRobotSeatOptions', { RobotId: robotId, ID: robotId }, function (data) {
                data = data || {};
                var current = data.current || data.Current || data;
                var gameId = current.GameId || current.gameId;
                var line = current.Line || current.line || '_public';
                if (gameId !== undefined && gameId !== null && gameId !== '' && Number(gameId) >= 0) {
                    loadAssignGames(gameId, data.games || data.Games);
                    var tableOptions = data.tables || data.Tables || [];
                    if (tableOptions.length) {
                        $('#assignLine').combobox('loadData', data.lines || data.Lines || publicLineData());
                        $('#assignLine').combobox('setValue', line);
                        $('#assignTable').combobox('loadData', tableOptions);
                        if (current.TableId !== undefined || current.tableId !== undefined) $('#assignTable').combobox('setValue', current.TableId !== undefined ? current.TableId : current.tableId);
                    } else {
                        loadAssignLines(gameId, line, current.TableId || current.tableId);
                    }
                }
                else {
                    // 离线账号没有 live 当前座位，仍要能从同一页选择目标游戏/机台。
                    loadAssignGames(-1, data.games || data.Games);
                }
                if (current.SeatIndex !== undefined || current.seatIndex !== undefined) $('#assignSeat').numberbox('setValue', Number(current.SeatIndex !== undefined ? current.SeatIndex : current.seatIndex) + 1);
            });
            openWin({ winId: '#assignWin', title: '【指定机器人座位】', height: 390, width: 500, iconCls: 'icon-user_add' });
        }
        function loadAssignGames(selectedGame, presetGames) {
            if (presetGames && presetGames.length) {
                $('#assignGameId').combobox('loadData', presetGames);
                if (selectedGame !== undefined && selectedGame !== null && Number(selectedGame) >= 0)
                    $('#assignGameId').combobox('setValue', selectedGame);
                return;
            }
            request('/Game/Robot/GetGamesTreeData', { GameType: -1 }, function (datas) {
                var arr = [];
                for (var i = 0; i < (datas || []).length; i++) arr = arr.concat(datas[i].children || []);
                $('#assignGameId').combobox('loadData', arr);
                if (selectedGame !== undefined && selectedGame !== null && Number(selectedGame) >= 0)
                    $('#assignGameId').combobox('setValue', selectedGame);
            });
        }
        function assignGameChanged(newValue, oldValue) {
            if (newValue === undefined || newValue === null || newValue === '') return;
            $('#assignLine').combobox('loadData', publicLineData());
            $('#assignTable').combobox('clear').combobox('loadData', []);
            loadAssignLines(newValue, '_public');
        }
        function assignLineChanged(newValue, oldValue) {
            var gameId = $('#assignGameId').combobox('getValue');
            if (gameId !== undefined && gameId !== null && gameId !== '') loadAssignTables(gameId, newValue || '_public');
        }
        function loadAssignLines(gameId, selectedLine, selectedTable) {
            request('/Game/Robot/GetRobotLineOptions', { GameId: gameId }, function (data) {
                $('#assignLine').combobox('loadData', (data && data.length) ? data : publicLineData());
                $('#assignLine').combobox('setValue', selectedLine || '_public');
                loadAssignTables(gameId, selectedLine || '_public', selectedTable);
            });
        }
        function loadAssignTables(gameId, line, selectedTable) {
            request('/Game/Robot/GetRobotTableList', { GameId: gameId, Line: line || '_public' }, function (data) {
                $('#assignTable').combobox('loadData', data || []);
                if (selectedTable !== undefined && selectedTable !== null) $('#assignTable').combobox('setValue', selectedTable);
            });
        }
        function saveRobotSeat() {
            var seat = Number($('#assignSeat').numberbox('getValue'));
            if (!/^[1-9][0-9]*$/.test(String(seat)) || seat > 99) { showMsg({ code: 0, content: '请输入有效的座位号（从1开始）。' }); return; }
            var gameId = $('#assignGameId').combobox('getValue');
            var tableId = $('#assignTable').combobox('getValue');
            if (gameId === '' || tableId === '') { showMsg({ code: 0, content: '请选择游戏和机台。' }); return; }
            var endpoint = $('#assignOnlineMode').val() === '1' ? '/Game/Robot/OnlineRobot' : '/Game/Robot/SetRobotSeat';
            request(endpoint, {
                RobotId: $('#assignRobotId').val(), ID: $('#assignRobotId').val(), GameId: gameId,
                TableId: tableId, TableIndex: tableId, SeatIndex: seat - 1, SeatId: seat - 1, SeatNo: seat,
                Line: $('#assignLine').combobox('getValue') || '_public'
            }, function (data) { showMsg(data); if (data && data.code == 1) { $('#assignWin').dialog('close'); reloadRobotViews(); } });
        }

        function showRobotAccountWin(id) {
            var row = (window.robotAccountCache || {})[String(id)] || {};
            $('#accountId').val(id || '');
            $('#accountUserName').textbox('setValue', row.UserName || '');
            $('#accountUserNick').textbox('setValue', row.UserNick || '');
            $('#accountIco').numberbox('setValue', row.Ico || 0);
            $('#accountLev').numberbox('setValue', row.Lev || 1);
            $('#accountSex').combobox('setValue', row.Sex || 0);
            $('#accountGold').numberbox('setValue', row.Gold || 100000);
            openWin({ winId: '#accountWin', title: id ? '【编辑机器人账户】' : '【新增机器人账户】', height: 360, width: 480, iconCls: 'icon-user_add' });
        }
        function saveRobotAccount() {
            var id = $('#accountId').val();
            var isEdit = !!id;
            var payload = isEdit ? {
                ID1: id,
                UserName1: $('#accountUserName').textbox('getValue'),
                UserNick1: $('#accountUserNick').textbox('getValue'),
                Ico1: $('#accountIco').numberbox('getValue'),
                Lev1: $('#accountLev').numberbox('getValue'),
                Sex1: $('#accountSex').combobox('getValue'),
                Gold1: $('#accountGold').numberbox('getValue')
            } : {
                UserName: $('#accountUserName').textbox('getValue'),
                UserNick: $('#accountUserNick').textbox('getValue'),
                Ico: $('#accountIco').numberbox('getValue'),
                Lev: $('#accountLev').numberbox('getValue'),
                Sex: $('#accountSex').combobox('getValue'),
                Gold: $('#accountGold').numberbox('getValue')
            };
            request(isEdit ? '/Game/UserRobot/UpdateRobot' : '/Game/UserRobot/SaveRobot', payload, function (data) {
                showMsg(data);
                if (data && data.code == 1) {
                    request('/Game/Robot/ReloadRobotAccounts', {}, function (reload) {
                        showMsg(reload);
                        if (reload && reload.code == 1) {
                            $('#accountWin').dialog('close');
                            reloadRobotViews();
                        }
                    });
                }
            });
        }
        function deleteRobotAccount(id) {
            confirm('确认删除该机器人账户？删除后将无法继续上线入座。', function () {
                request('/Game/UserRobot/DelRobot', { ID: id }, function (data) {
                    showMsg(data);
                    if (data && data.code == 1) {
                        request('/Game/Robot/ReloadRobotAccounts', {}, function (reload) {
                            showMsg(reload);
                            if (reload && reload.code == 1) reloadRobotViews();
                        });
                    }
                });
            });
        }
        function showBatchRobotAccountWin() {
            $('#batchRobotNum').numberbox('setValue', 10);
            $('#batchRobotIco').numberbox('setValue', 0);
            $('#batchRobotLev').numberbox('setValue', 1);
            $('#batchRobotSex').combobox('setValue', 0);
            $('#batchRobotGold').numberbox('setValue', 100000);
            $('#batchRobotNames').text('创建后将在这里显示本次生成的昵称。');
            openWin({ winId: '#batchAccountWin', title: '【批量创建机器人账户】', height: 410, width: 520, iconCls: 'icon-user_add' });
        }
        function saveBatchRobotAccounts() {
            var num = Number($('#batchRobotNum').numberbox('getValue'));
            if (!/^[1-9][0-9]*$/.test(String(num)) || num > 1000) {
                showMsg({ code: 0, content: '批量创建数量须为 1~1000。' });
                return;
            }
            var payload = {
                Num: num,
                Ico: Number($('#batchRobotIco').numberbox('getValue') || 0),
                Lev: Number($('#batchRobotLev').numberbox('getValue') || 1),
                Sex: Number($('#batchRobotSex').combobox('getValue') || 0),
                Gold: Number($('#batchRobotGold').numberbox('getValue') || 100000)
            };
            confirm('确认批量创建 ' + num + ' 个机器人账户？昵称将从名字库随机生成 2~8 个汉字。', function () {
                request('/Game/Robot/BatchCreateRobotAccounts', payload, function (data) {
                    showMsg(data);
                    if (data && data.code == 1) {
                        var names = data.names || data.Names || [];
                        if ($.isArray(names) && names.length) {
                            var nickNames = $.map(names, function (item) {
                                return typeof item === 'string' ? item : (item.UserNick || item.userNick || item.UserName || item.userName || '');
                            });
                            $('#batchRobotNames').text('本次生成昵称：' + nickNames.join('、'));
                        }
                        request('/Game/Robot/ReloadRobotAccounts', {}, function (reload) {
                            showMsg(reload);
                            if (reload && reload.code == 1) {
                                $('#batchAccountWin').dialog('close');
                                reloadRobotViews();
                            }
                        });
                    }
                });
            });
        }
        function getCheckedRobotAccounts() {
            if (!$('#tb_RobotAccount').data('datagrid')) return [];
            return $('#tb_RobotAccount').datagrid('getChecked') || [];
        }
        function batchDeleteRobotAccounts() {
            var rows = getCheckedRobotAccounts();
            var ids = [];
            $.each(rows, function (_, row) {
                var id = row && (row.RobotId || row.robotId || row.ID || row.UserId || row.USER_ID);
                if (id && $.inArray(String(id), ids) < 0) ids.push(String(id));
            });
            if (!ids.length) {
                showMsg({ code: 0, content: '请先勾选要删除的机器人账户。' });
                return;
            }
            confirm('确认删除已勾选的 ' + ids.length + ' 个机器人账户？删除后无法继续上线入座。', function () {
                request('/Game/Robot/BatchDeleteRobotAccounts', { Ids: ids.join(','), ids: ids.join(',') }, function (data) {
                    showMsg(data);
                    if (data && data.code == 1) reloadRobotViews();
                });
            });
        }
        // Short aliases kept for the legacy page scripts and browser contract checks.
        function saveBatchRobot() { saveBatchRobotAccounts(); }
        function deleteBatchRobot() { batchDeleteRobotAccounts(); }
        //绑定表格数据
        function bindGridData(para) {
            if (!$('#tb_Robot').data('datagrid')) {
                $('#tb_Robot').datagrid({
                    url: "/Game/Robot/GetRobot",
                    queryParams: $.extend({}, para),
                    pagination: true,
                    fitColumns: true,
                    singleSelect: true,
                    striped: true,
                    rownumbers: true,
                    showFooter: true,  
                    height: 360,
                    pageSize: 20,
                    pageList: [10, 20, 50],
                    idField: 'ID',
                    onBeforeLoad: setGridSize,
                    onLoadSuccess: function (data) { onLoaded(data); setGridSize(); }
                });
            } else {
                $('#tb_Robot').datagrid('load', para);
            }
        }

        function SaveRobot() {
            @Html.Raw(@"var para = $('#form3').serializeObject();
                if (usesMachineRobotCount()) {
                    var count = $('#addCardRobotNo').numberbox('getValue');
                    if (!cardCapacityReady || !/^(0|[1-9][0-9]*)$/.test(count) || Number(count) > cardTotal) {
                        showMsg({ code: 0, content: '请输入 0~' + cardTotal + ' 之间的机器人数量！' });
                        return;
                    }
                    para.RobotNo = count;
                    delete para.TABLE_ID;
                    if (usesMultiSeatRobotCount()) {
                        var limit = $('#addMaxPerTable').numberbox('getValue');
                        if (!/^[1-9][0-9]*$/.test(limit) || Number(limit) > multiSeatCapacity.maxAllowed) {
                            showMsg({ code: 0, content: '请填写有效的每桌最大机器人数！' });
                            return;
                        }
                        para.MaxPerTable = limit;
                    }
                }
                request('/Game/Robot/SaveRobot', para, function (data) {
                    //提示消息
                    showMsg(data);
                    if (data && data.code == 1) {
                        $('#addWin').dialog('close');
                        $('#form3').form('reset');
                        reloadRobotViews();//同步配置与实时状态
                    }
             });");
        }

        function deleteRobot(id) {
           @Html.Raw(@" confirm('确认删除机器人？', function () {
                request('/Game/Robot/DelRobot', { ID: id }, function (data) {
                    //提示消息
                    showMsg(data);
                    if (data && data.code == 1) {
                        queryData();//重新加载数据
                    }
                });
            });");
        }

        function deleteAllRobot() {
            @Html.Raw(@" confirm('确认清空所有游戏、所有代理线的机器人配置？账户仍保留，此操作不受当前筛选条件限制。', function () {
                request('/Game/Robot/DelAllRobot', {}, function (data) {
                    //提示消息
                    showMsg(data);
                    if (data && data.code == 1) {
                        reloadRobotViews();//同步配置与实时状态
                    }
                });
            });");
        }

        function showAddWin() {
            var para = {
                winId: '#addWin',
                title: '【设置机器人数量】',
                width: Math.min(440, window.innerWidth - 24),
                height: Math.min(460, window.innerHeight - 32),
                iconCls: 'icon-user_add',
                callBack: function () {
                    $('#addGameType').combobox('loadData', actionSelData1());
                    $('#addLine').combobox('loadData', publicLineData());
                    $('#addTABLE_ID').combobox('clear').combobox('loadData', []);
                    configureRobotInputs();
                    $('#addWin').scrollTop(0);
                }
            };
            openWin(para);
        }
        function bindGameTypeTree(newValue, oldValue) {
            if (!robotInputsReady) return;
            configureRobotInputs();
            $('#addGameId').combobox('clear').combobox('loadData', []);
            if (newValue > -1) {
                request('/Game/Robot/GetGamesTreeData', { GameType: newValue }, function (datas) {
                    if ($('#addGameType').combobox('getValue') != newValue) return;
                    var arr = [];
                    arr.push({ id: -1, text: '请选择游戏', selected: true });
                    $('#addGameId').combobox('clear');
                    for (var i = 0; i < datas.length; i++) {
                        if (newValue == datas[i].id) {
                            arr = arr.concat(datas[i].children);
                        }
                    }
                    $('#addGameId').combobox('loadData', arr);
                    $('#addLine').combobox('loadData', publicLineData());
                    $('#addTABLE_ID').combobox('clear').combobox('loadData', []);
                })
            }
        }
        function bindGamesTree(newValue, oldValue) {
            if (!robotInputsReady) return;
            resetCardCapacity();
            if (newValue > -1 && newValue !== '') {
                // 换游戏后先刷新代理线（公共桌台 + 在该游戏有专属桌台的直属代理），再按代理线取桌台
                loadLines(newValue);
            }
        }
        // 代理线下拉的初始数据：只有“公共桌台”（值 _public，与服务端 PublicLineKey 一致）
        function publicLineData() {
            return [{ id: '_public', text: '公共桌台', selected: true }];
        }
        function loadLines(gameId) {
            request('/Game/Robot/GetRobotLineOptions', { GameId: gameId }, function (data) {
                if ($('#addGameId').combobox('getValue') != gameId) return;
                $('#addLine').combobox('loadData', (data && data.length) ? data : publicLineData());
                getRoom();
            });
        }
        function bindLineTables(newValue, oldValue) {
            if (!robotInputsReady) return;
            resetCardCapacity();
            if (newValue && newValue != oldValue) {
                getRoom();
            }
        }
        function fmtLine(value, rowData, rowIndex) {
            if (rowData.GAME_TYPE == 5) return '';
            if (!value) return '<span>公共桌台</span>';
            if (value == '#') return '<span style="color:#c00;">已收回</span>';
            return $('<span/>').text(value).prop('outerHTML');
        }
        function actionSelData1() {
            return [
                { id: -1, text: '请选择游戏类型', selected: true },
                { id: 0, text: '押注类' },
                { id: 1, text: '牌机类' },
                { id: 2, text: '鱼机类' },
                { id: 3, text: '拉霸类' }
            ];
        }
        function fmtGameType(value, rowData, rowIndex) {
            if (value == 0)
                return '<span>押注类</span>';
            else if (value == 1)
                return '<span>牌机类</span>';
            else if (value == 2)
                return '<span>鱼机类</span>';
            else if (value == 3)
                return '<span>拉霸类</span>';
        }

        function fmtRobotCount(value, rowData, rowIndex) {
            rowData = rowData || {};
            var robotCount = rowData.ROBOT_COUNT;
            if (robotCount === undefined || robotCount === null) robotCount = value;
            if (Number(robotCount) < 0) return '<span title="实时状态暂不可用">—</span>';
            return robotCount === undefined || robotCount === null ? '—' : String(robotCount);
        }
        // 获取桌台列表(所有游戏类型统一从 roomtableconfig 读取，空名保底"桌台n")
        var cardRemaining = 0;
        var cardTotal = 0;
        var robotInputsReady = false;
        var cardCapacityReady = false;
        var roomRequestVersion = 0;
        var multiSeatCapacity = null;
        function resetCardCapacity() {
            roomRequestVersion++;
            cardRemaining = 0;
            cardTotal = 0;
            cardCapacityReady = false;
            multiSeatCapacity = null;
            $('#addMaxPerTable').numberbox('clear').numberbox('disable');
            $('#addCardRobotNo').numberbox('clear').numberbox('disable');
            $('#cardRobotHint').text('请选择游戏和代理线');
        }
        function configureRobotInputs() {
            var card = usesMachineRobotCount();
            $('#tableRobotRow,#tableRobotCountRow').toggle(false);
            $('#cardRobotCountRow,#cardRobotHintRow').toggle(card);
            $('#maxPerTableRow').toggle(usesMultiSeatRobotCount());
            // 数量框在隐藏行里初始化时宽度为 0，显示后要重新计算宽度
            if (card) $('#addCardRobotNo').numberbox('resize', 150);
            $('#addTABLE_ID').combobox('disable');
            $('#addRobotNo').combobox('disable');
            resetCardCapacity();
        }
        function usesMachineRobotCount() {
            var type = $('#addGameType').combobox('getValue');
            return type !== '' && (type == 0 || type == 1 || type == 2 || type == 3);
        }
        function usesMultiSeatRobotCount() {
            var type = $('#addGameType').combobox('getValue');
            return type !== '' && (type == 0 || type == 2);
        }
        function updateMultiSeatCapacity() {
            if (!multiSeatCapacity) return;
            var limit = Number($('#addMaxPerTable').numberbox('getValue'));
            cardTotal = multiSeatCapacity.tableLimits.reduce(function (sum, seats) { return sum + Math.min(seats, limit); }, 0);
            $('#addCardRobotNo').numberbox({ min: 0, max: null, disabled: false }).numberbox('resize', 150);
            $('#cardRobotHint').text('本线启用桌台' + multiSeatCapacity.tableCount + '张，当前已设置' + multiSeatCapacity.current +
                '个机器人。总数范围0~' + cardTotal + '，均匀分配且每桌至少保留一个真人座位；填0清空人数。');
        }
        function getRoom() {
            resetCardCapacity();
            var version = roomRequestVersion;
            var GameId = $('#addGameId').combobox('getValue');
            var Line = $("#form3 input[name='Line']").val() || '_public';
            //console.log("游戏名称：" + GameId);
            if (GameId == -1 || GameId=='') {
              //alert("请选择游戏");
                return;
            }
            if (usesMachineRobotCount()) {
                request('/Game/Robot/GetCardRobotCapacity', { GameId: GameId, Line: Line }, function (data) {
                    if (version != roomRequestVersion) return;
                    if (!data || data.code != 1) {
                        $('#cardRobotHint').text('机台数量读取失败，请重新选择');
                        return;
                    }
                    if (usesMultiSeatRobotCount()) {
                        if (!data.schemaReady) {
                            $('#cardRobotHint').text('请先安装机器人每桌上限数据库升级');
                            return;
                        }
                        multiSeatCapacity = data;
                        $('#addMaxPerTable').numberbox({ min: 1, max: data.maxAllowed, disabled: false })
                            .numberbox('resize', 150).numberbox('setValue', data.maxPerTable);
                        updateMultiSeatCapacity();
                        cardCapacityReady = data.tableCount > 0 || data.current > 0;
                        // 旧配置超出新容量时保留原值，交由操作者明确调整，避免悄悄减少人数。
                        $('#addCardRobotNo').numberbox('setValue', data.current);
                        if (!cardCapacityReady) $('#addCardRobotNo').numberbox('disable');
                        return;
                    }
                    cardRemaining = data.remaining;
                    cardTotal = data.total;
                    cardCapacityReady = true;
                    $('#cardRobotHint').text('本线启用机台' + data.total + '台，当前已设置' + data.current + '个机器人。填写要设置的总数（0~' + data.total + '），保存后按此数量增减；机器人随机寻找本线空机台入座，满台时等待。');
                    // numberbox 与 textbox 分别缓存 disabled；重新配置范围时必须一起清除旧的禁用状态。
                    if (cardTotal > 0 || data.current > 0) $('#addCardRobotNo').numberbox({ min: 0, max: cardTotal, disabled: false }).numberbox('resize', 150).numberbox('setValue', Math.min(data.current, cardTotal));
                });
                return;
            }
            request('/Game/Robot/GetRobotTableList', { GameId: GameId, Line: Line }, function (data) {
                if (version != roomRequestVersion) return;
                $('#addTABLE_ID').combobox('clear').combobox('loadData', data || [])
            })
        }
        //获取下拉数字序列数据(机器人数)数据
        function getComboSelData(len, minVal) {
            var arr = [];
            var _minVal = (typeof minVal == "number" ? minVal : 0)
            for (var i = _minVal; i < len; i++) {
                if (i == _minVal)
                    arr.push({ id: i, text: i.toString(), selected: true });
                else
                    arr.push({ id: i, text: i.toString() });
            }
            return arr;
        }

        function fmtOpt(value, rowData, rowIndex) {
            rowData = rowData || {};
            if (!rowData.GAME_ID) return '';
            var line = String(rowData.LINE_AGENT || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
            return '<a href="javascript:void(0)" class="robot-danger Lpd5" onclick="deleteRobotSummary(' + Number(rowData.GAME_ID) + ',\'' + line + '\')">清空配置</a>';
        }
        function deleteRobotSummary(gameId, line) {
            confirm('确认清零该游戏/代理线的全部机器人配置？', function () {
                request('/Game/Robot/DeleteRobotSummary', { GameId: gameId, Line: line || '_public' }, function (data) {
                    showMsg(data);
                    if (data && data.code == 1) reloadRobotViews();
                });
            });
        }

    </script>
    <style>
