
@{
    Layout = "~/Views/Shared/Layout/_ContentLayout.cshtml";
    ViewBag.RouteMap = "点杀记录";
    M_LoginUser loginUser = WebHelper.GetLoginInfo();
}
@section include_res{
    <link href="@Url.Content("~/Content/css/ios-page.css?v=" + ConfigHelper.Get("WebVer"))" rel="stylesheet" />
    <script>
        $(function () {
            // 加载指定的模块
                easyloader.load(['textbox', 'linkbutton', 'datagrid', 'messager'], function () {
                //适应窗口大小变化
                $(window).resize(function () {
                    if ($('body').data('grid-init')) {
                        setGridSize();
                    }
                });
                //初始化插件
                pluginInit();
                //初始化查询
                queryData();
            });
        })
        //重置表格大小
        function setGridSize(param) {
            var w = $(window).width() - 8;
            var h = $(window).height() - 78;
            resizeGrid('tb_UCRecords', 'auto', h);
        }
        //查询数据
        function queryData() {
            var para = $("#frm_srch").serializeObject();
            bindGridData(para);
        }
        //绑定表格数据
        function bindGridData(para) {
            if (!$('body').data('grid-init')) {
                $('#tb_UCRecords').datagrid({
                    url: "/Game/UCRecord/GetUCRecords",
                    queryParams: $.extend({}, para),
                    pagination: true,
                    fitColumns: true,
                    singleSelect: true,
                    striped: true,
                    rownumbers: true,
                    height: 768,
                    pageSize: 20,
                    pageList: [10, 20, 50],
                    idField: 'USER',
                    onBeforeLoad: setGridSize,
                    onLoadSuccess: function () {
                        if (typeof onLoaded === 'function') onLoaded();
                        renderUCRecordStats();
                    }
                });
            } else {
                $('#tb_UCRecords').datagrid('load', para);
            }
        }
        function fmtOptCol(value, rowData, rowIndex) {
            switch (value) {
                case 1:
                    return '鱼机点杀';
                case 2:
                    return '鱼机放水';
                case 3:
                    return '押分点杀';
                case 4:
                    return '押分放水';
                case 21:
                    return '总点杀';
                case 22:
                    return '总放水';
                case 23:
                    return '总控牌';
            }
            if (value >= 5 && value <= 17) return '控牌';
            return '--';
        }
        function fmtOperator(value, rowData, rowIndex) {
            if (!value) return '<span style="color:#bbb;">--</span>';
            return value;
        }
        // 点杀记录统计（按当前页 rows 计算）
        function renderUCRecordStats() {
            var rows = [];
            try { rows = $('#tb_UCRecords').datagrid('getRows') || []; } catch (e) { }
            var total = rows.length, kill = 0, release = 0, control = 0;
            $.each(rows, function (i, r) {
                var o = parseInt(r.Opt, 10);
                if (o == 1 || o == 3 || o == 21) kill++;
                else if (o == 2 || o == 4 || o == 22) release++;
                else if ((o >= 5 && o <= 17) || o == 23) control++;
            });
            $('#stUCTotal').text(total);
            $('#stUCKill').text(kill);
            $('#stUCRelease').text(release);
            $('#stUCControl').text(control);
        }
        function clearRecords() {
            $.messager.confirm('确认', '确定要清空全部点杀记录吗？此操作不可恢复！', function (r) {
                if (!r) return;
                $.post('/Game/UCRecord/ClearRecords', {}, function (res) {
                    if (res.code === 1) {
                        $.messager.alert('提示', res.msg, 'info', function () {
                            queryData();
                        });
                    } else {
                        $.messager.alert('提示', res.msg, 'error');
                    }
                });
            });
        }
    </script>
}
<div class="container">
    <div class="stats-grid" style="grid-template-columns:repeat(4,1fr);">
        <div class="stat-box"><div class="stat-value" id="stUCTotal">0</div><div class="stat-label">记录总数</div></div>
        <div class="stat-box"><div class="stat-value" id="stUCKill">0</div><div class="stat-label">点杀</div></div>
        <div class="stat-box"><div class="stat-value" id="stUCRelease">0</div><div class="stat-label">放水</div></div>
        <div class="stat-box"><div class="stat-value" id="stUCControl">0</div><div class="stat-label">控牌</div></div>
    </div>

    <form id="frm_srch" class="filter-row">
        <input type="text" class="ios-input" name="ID" placeholder="用户账号" style="flex:1 1 160px;min-width:160px;" />
        <button type="button" class="ios-btn" onclick="queryData();">查找</button>
        @if (loginUser != null && loginUser.UserPriv == 0)
        {
            <button type="button" class="ios-btn danger-outline" onclick="clearRecords();">清理记录</button>
        }
    </form>

@*点杀记录信息*@
<div class="table-container">
<div class="table-scroll">
<table id="tb_UCRecords">
    <thead>
        <tr>
            <th field="UserID" width="120">用户账号</th>
            <th field="AGENCY" width="135">所属代理</th>
            <th field="NAME" width="85">用户昵称</th>
            <th field="Opt" width="85" formatter="fmtOptCol">功能</th>
            <th field="OptValue" width="85">控值</th>
            <th field="TIME" width="135">时间</th>
            <th field="OPERATOR" width="100" formatter="fmtOperator">操作</th>
        </tr>
    </thead>
</table>
</div>
    <div class="scroll-hint">↔ 左右滑动查看更多数据</div>
</div>
</div>
