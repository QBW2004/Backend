
@{
    Layout = "~/Views/Shared/Layout/_ContentLayout.cshtml";
    ViewBag.RouteMap = "代理记录";
    M_LoginUser loginUser = WebHelper.GetLoginInfo();
}
@section include_res{
    <link href="@Url.Content("~/Content/css/ios-page.css?v=" + ConfigHelper.Get("WebVer"))" rel="stylesheet" />
    <script>
        $(function () {
            // 加载指定的模块
                easyloader.load(['textbox', 'linkbutton', 'datagrid', 'messager'], function () {
                //适应窗口大小变化
                $(window).resize(function () {
                    if ($('body').data('grid-init')) {
                        setGridSize();
                    }
                });
                //初始化插件
                pluginInit();

                //初始化查询
                setTimeout(function () {
                    queryData();
                }, 10);
            });
        })
        //重置表格大小
        function setGridSize(param) {
            var w = $(window).width() - 8;
            var h = $(window).height() - 78;
            resizeGrid('tb_AgencyRecords', 'auto', h);
        }
        //查询数据
        function queryData() {
            var para = $("#frm_srch").serializeObject();
            bindGridData(para);
        }
        //绑定表格数据
        function bindGridData(para) {
            if (!$('body').data('grid-init')) {
                $('#tb_AgencyRecords').datagrid({
                    url: "/Game/AgencyRecord/GetAgencyRecords",
                    queryParams: $.extend({}, para),
                    pagination: true,
                    fitColumns: true,
                    singleSelect: true,
                    striped: true,
                    rownumbers: true,
                    height: 768,
                    pageSize: 20,
                    pageList: [10, 20, 50],
                    idField: 'USER',
                    onBeforeLoad: setGridSize,
                    onLoadSuccess: function () {
                        if (typeof onLoaded === 'function') onLoaded();
                        renderAgencyRecordStats();
                    }
                });
            } else {
                $('#tb_AgencyRecords').datagrid('load', para);
            }
        }
        function fmtOptType(value, rowData, rowIndex) {
            switch (value) {
                case 0:
                    return '充值';
                case 1:
                    return '兑换';
                case 2:
                    return '登录';
                case 3:
                    return '退出';
                default:
                    return '--';
            }
        }
        function fmtContents(value, rowData, rowIndex) {
            switch (rowData.OPT) {
                case 0:
                case 1:
                    return getRechargeExchangeMsg(rowData);
                case 2:
                case 3:
                    return getAngencyMsg(rowData);
                default:
                    return "--";
            }
        }
        function getRechargeExchangeMsg(rowData) {
            var optStr = fmtOptType(rowData.OPT);
            return rowData.SrcUserTitle
                + '账号[ ' + rowData.OptID
                + ' ]给' + rowData.DestUserTitle
                + '账号[ ' + rowData.ID + ' ]'
                + optStr + ' ' + top.goldFormat(rowData.COINS)
                + ' ，该账号' + optStr
                + '前 ' + top.goldFormat(rowData.BEF_COINS) + ' ，'
                + optStr + '后 ' + top.goldFormat(rowData.AFT_COINS) + ' 。';
        }
        function getAngencyMsg(rowData) {
            var optStr = fmtOptType(rowData.OPT);
            return rowData.SrcUserTitle
                + '账号[ ' + rowData.OptID
                + ' ]在 ' + rowData.REC_TIME_Str + ' ' + optStr
                + '，' + optStr + '时携带 ' + top.goldFormat(rowData.BEF_COINS) + ' 。';
        }
        function clearRecords() {
            $.messager.confirm('确认', '确定要清空全部代理记录吗？此操作不可恢复！', function (r) {
                if (!r) return;
                $.post('/Game/AgencyRecord/ClearRecords', {}, function (res) {
                    if (res.code === 1) {
                        $.messager.alert('提示', res.msg, 'info', function () { queryData(); });
                    } else {
                        $.messager.alert('提示', res.msg, 'error');
                    }
                });
            });
        }
        // 代理记录统计（按当前页 rows 计算）
        function renderAgencyRecordStats() {
            var rows = [];
            try { rows = $('#tb_AgencyRecords').datagrid('getRows') || []; } catch (e) { }
            var total = rows.length, rc = 0, ex = 0, login = 0;
            $.each(rows, function (i, r) {
                var o = parseInt(r.OPT, 10);
                if (o == 0) rc++;
                else if (o == 1) ex++;
                else if (o == 2 || o == 3) login++;
            });
            $('#stARTotal').text(total);
            $('#stARRecharge').text(rc);
            $('#stARExchange').text(ex);
            $('#stARLogin').text(login);
        }
    </script>
}
<div class="container">
    <div class="stats-grid" style="grid-template-columns:repeat(4,1fr);">
        <div class="stat-box"><div class="stat-value" id="stARTotal">0</div><div class="stat-label">记录总数</div></div>
        <div class="stat-box"><div class="stat-value" id="stARRecharge">0</div><div class="stat-label">充值</div></div>
        <div class="stat-box"><div class="stat-value" id="stARExchange">0</div><div class="stat-label">兑换</div></div>
        <div class="stat-box"><div class="stat-value" id="stARLogin">0</div><div class="stat-label">登录·退出</div></div>
    </div>

    <form id="frm_srch" class="filter-row">
        <input type="text" class="ios-input" name="ID" placeholder="搜索账号" style="flex:1 1 110px;min-width:110px;" />
        <select name="OPT" class="ios-select" style="min-width:96px;">
            <option value="-1" selected>-- 全部 --</option>
            <option value="0">充值</option>
            <option value="1">兑换</option>
            <option value="2">登录</option>
            <option value="3">退出</option>
        </select>
        <label class="filter-label">时间：</label>
        <input type="text" class="easyui-datebox filter-datetime" name="TIME" value="return GetDate()" style="width:135px">
        <button type="button" class="ios-btn" onclick="queryData();">查找</button>
        @if (loginUser != null && loginUser.UserPriv == 0)
        {
            <button type="button" class="ios-btn danger-outline" onclick="clearRecords();">清理记录</button>
        }
    </form>

@*查询代理的信息*@
<div class="table-container">
<div class="table-scroll">
<table id="tb_AgencyRecords">
    <thead>
        <tr>
            <th field="OptID" width="85">代理账号</th>
            <th field="REC_TIME_Str" width="130">时间</th>
            <th field="Contents" width="600" formatter="fmtContents">日志内容</th>
        </tr>
    </thead>
</table>
</div>
    <div class="scroll-hint">↔ 左右滑动查看更多数据</div>
</div>
</div>