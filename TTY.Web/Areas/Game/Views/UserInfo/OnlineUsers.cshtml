    // 各牌机游戏倍率（与台机设定 GC_MAG_TAB 一致，客户端固定值只读；ATT3 取 middle 档）
    var TC_MAG_TAB = {
        phenix: [0, 1, 2, 3, 5, 7, 10, 40, 80, 120, 250, 500, 1000],
        king3:  [0, 1, 2, 3, 5, 7, 10, 60, 60, 120, 250, 500, 1000],
