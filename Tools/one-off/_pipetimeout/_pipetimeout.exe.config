<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 与 TTY.Web/Web.config 同键：中心服在本机，管道名 mynamedpipe -->
    <add key="serverName" value="."/>
    <add key="pipeName" value="mynamedpipe"/>
    <add key="robotPipeName" value="MTH_RobotPipe"/>
  </appSettings>
</configuration>
