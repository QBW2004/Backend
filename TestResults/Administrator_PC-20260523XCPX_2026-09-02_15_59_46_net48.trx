&#xD;
@*控制类型选择窗口*@&#xD;
&lt;div id="chgCtrlSelect" class="hide" style="text-align:center;padding:30px 20px;"&gt;&#xD;
    &lt;a id="btnFishCtrl" href="javascript:void(0);" class="easyui-linkbutton" onclick="subCtrlClick('fish')" data-options="plain:true,iconCls:'icon-chart_curve'" style="margin:8px;width:140px;"&gt;鱼机控制&lt;/a&gt;&#xD;
    &lt;br/&gt;&#xD;
    &lt;a id="btnPaiJiCtrl" href="javascript:void(0);" class="easyui-linkbutton" onclick="subCtrlClick('paiji')" data-options="plain:true,iconCls:'icon-chart_curve'" style="margin:8px;width:140px;"&gt;牌机控制&lt;/a&gt;&#xD;
    &lt;br/&gt;&#xD;
    &lt;a id="btnTotalCtrl" href="javascript:void(0);" class="easyui-linkbutton" onclick="subCtrlClick('total')" data-options="plain:true,iconCls:'icon-chart_curve'" style="margin:8px;width:140px;"&gt;总控&lt;/a&gt;&#xD;
&lt;/div&gt;&#xD;
&#xD;
@*修改鱼机控制窗口*@&#xD;
&lt;div id="chgRateWin" class="hide"&gt;&#xD;
    &lt;form id="form3"&gt;&#xD;
        &lt;table cellpadding="0" cellspacing="0" border="0" width="100%" align="center"&gt;&#xD;
            &lt;tr&gt;&#xD;
                &lt;td colspan="2" align="left" style="padding-left: 50px;color:#999;"&gt;&#xD;
                    &lt;p style="margin-left:-35px;"&gt;温馨提示:修改后即时生效&lt;/p&gt;&#xD;
                &lt;/td&gt;&#xD;
            &lt;/tr&gt;&#xD;
            &lt;tr&gt;&#xD;
                &lt;td align="right"&gt;用户账号&lt;/td&gt;&#xD;
                &lt;td align="left" class="pd5"&gt;&#xD;
                    &lt;input class="easyui-textbox win-txt" id="txtE_ID" disabled /&gt;&#xD;
                &lt;/td&gt;&#xD;
            &lt;/tr&gt;&#xD;
            &lt;tr&gt;&#xD;
                &lt;td align="right"&gt;功能&lt;/td&gt;&#xD;
                &lt;td align="left" class="pd5"&gt;&#xD;
                    &lt;select class="easyui-combobox win-txt" id="selE_Action1" name="Action" data-options="valueField:'id',textField:'text',panelHeight:150,data:actionSelData(),onChange:bindAction"&gt;&lt;/select&gt;&#xD;
                &lt;/td&gt;&#xD;
            &lt;/tr&gt;&#xD;
            &lt;tr&gt;&#xD;
                &lt;td align="right"&gt;控值&lt;/td&gt;&#xD;
                &lt;td align="left" class="pd5"&gt;&#xD;
                    &lt;select class="easyui-combobox win-txt" id="selE_Val1" name="Val" data-options="valueField:'id',textField:'text',panelHeight:150,data:getComboValKill()"&gt;&lt;/select&gt;&#xD;
&#xD;
                &lt;/td&gt;&#xD;
            &lt;/tr&gt;&#xD;
            &lt;tr&gt;&#xD;
                &lt;td align="right"&gt;目标&lt;/td&gt;&#xD;
                &lt;td align="left" class="pd5"&gt;&#xD;
                    &lt;input class="easyui-numberbox win-txt" id="numGoldLimit1" name="GoldLimit" data-options="min:0,precision:0,prompt:'0=不限制'" style="width:150px;" /&gt;&#xD;
                    &lt;span style="color:#999;font-size:12px;"&gt;金币上限到达后恢复正常吞吐币，0=不限制&lt;/span&gt;&#xD;
                &lt;/td&gt;&#xD;
            &lt;/tr&gt;&#xD;
            &lt;tr&gt;&#xD;
