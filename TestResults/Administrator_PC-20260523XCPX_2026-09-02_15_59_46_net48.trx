        function bindGameTypePaiJi(newValue, oldValue) {&#xD;
            console.log("newValue:" + newValue);&#xD;
            console.log("oldValue:" + oldValue);&#xD;
          &#xD;
            if (oldValue &amp;&amp; newValue &gt; -1 &amp;&amp; newValue != oldValue) {&#xD;
                if (newValue == 5 || newValue == 7 || newValue == 12 || newValue == 13 || newValue == 14) {&#xD;
                    // 牌机型：按所选游戏动态生成0-12牌型+关闭(99)，倍率与台机设定一致&#xD;
                    $('#selE_Type').combobox('loadData', valSelDataPAIJI(newValue));&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
&#xD;
        function SaveUserRate() {&#xD;
            @Html.Raw(@"       var para = $('#form3').serializeObject();&#xD;
                request('/Game/UserInfo/ChgUserRate', para, function (data) {&#xD;
                    //提示消息&#xD;
                    showUserResult(data);&#xD;
                    if (data &amp;&amp; data.code == 1) {&#xD;
                        $('#chgRateWin').dialog('close');&#xD;
                        $('#form3').form('reset');&#xD;
                        refreshChangedUserRow(para.ID, 500);&#xD;
                    }&#xD;
                });");&#xD;
        }&#xD;
        function SaveUserRatePAIJI() {&#xD;
            @Html.Raw(@"       var para = $('#form6').serializeObject();&#xD;
                request('/Game/UserInfo/ChgUserRatePAIJI', para, function (data) {&#xD;
                    //提示消息&#xD;
                    showUserResult(data);&#xD;
                    if (data &amp;&amp; data.code == 1) {&#xD;
                        $('#chgRateWinPAIJI').dialog('close');&#xD;
                        $('#form6').form('reset');&#xD;
                        refreshChangedUserRow(para.ID1, 500);&#xD;
                    }&#xD;
                });");&#xD;
        }&#xD;
        function SaveUserRateLaba() {&#xD;
            @Html.Raw(@"       var para = $('#formLaba').serializeObject();&#xD;
                request('/Game/UserInfo/ChgUserRateLaba', para, function (data) {&#xD;
                    showUserResult(data);&#xD;
                    if (data &amp;&amp; data.code == 1) {&#xD;
                        $('#chgRateWinLaba').dialog('close');&#xD;
                        $('#formLaba').form('reset');&#xD;
                        refreshChangedUserRow(para.IDLaba, 500);&#xD;
                    }&#xD;
                });");&#xD;
        }&#xD;
        function kickPlayer(id) {&#xD;
            var _tip = 'ALL', _url = '/Game/UserInfo/KickAllPlayer';&#xD;
            if (id &amp;&amp; id.length &gt; 0) {&#xD;
                _tip = '选择的';&#xD;
                _url = '/Game/UserInfo/KickPlayer';&#xD;
            }&#xD;
            @Html.Raw(@"        confirm('确认踢出' + _tip + ' 用户？', function () {&#xD;
                request(_url, { UserID: id }, function (data) {&#xD;
                    //提示消息&#xD;
                    showUserResult(data);&#xD;
                    if (data &amp;&amp; data.code == 1) {&#xD;
                        if (id &amp;&amp; id.length &gt; 0) {&#xD;
                            patchVisibleUserRow(id, { INHALL: false, CurrentGameName: null, CurrentGameType: null, CurrentRoomId: null, CurrentTableId: null, CurrentSeatId: null, CurrentBetCoins: null, CurrentWinLose: null });&#xD;
                            refreshChangedUserRow(id, 800);&#xD;
                        } else {&#xD;
                            refreshChangedUserRow(null, 800);&#xD;
                        }&#xD;
                    }&#xD;
                });&#xD;
            }); ");&#xD;
        }&#xD;
        function showAddUser() {&#xD;
            var para = {&#xD;
                winId: '#addUser',&#xD;
                title: '【添加用户】',&#xD;
                iconCls: 'icon-user_add'&#xD;
            };&#xD;
            openWin(para);&#xD;
        }&#xD;
&#xD;
        function SaveUserInfo() {&#xD;
            var para = $('#form4').serializeObject();&#xD;
            request('/Game/UserInfo/AddUser', para, function (data) {&#xD;
                //提示消息&#xD;
                showUserResult(data);&#xD;
                if (data &amp;&amp; data.code == 1) {&#xD;
                    $('#addUser').dialog('close');&#xD;
                    $('#form4').form('reset');&#xD;
                    //queryData();//重新绑定表格数据&#xD;
                    $('#tb_UserInfo').datagrid('reload');&#xD;
                }&#xD;
            });&#xD;
        }&#xD;
        function fmtUserID(value, rowData, rowIndex) {&#xD;
            if (rowData.FROZEN != 2) {&#xD;
                return value;&#xD;
            } else {&#xD;
                return '';&#xD;
            }&#xD;
        }&#xD;
&#xD;
        function bindAction(newValue, oldValue) {&#xD;
            if (oldValue &amp;&amp; newValue &gt; -1 &amp;&amp; newValue != oldValue) {&#xD;
                if (newValue == 1) {&#xD;
                    $('#selE_Val1').combobox('loadData', getComboValKill());&#xD;
                } else if (newValue == 2) {&#xD;
                    $('#selE_Val1').combobox('loadData', getComboValPut());&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
&#xD;
        function getComboValKill() {&#xD;
            var arr = [];&#xD;
            arr.push({ id: 3, text: '小吃(3%)' });&#xD;
            arr.push({ id: 6, text: '中吃(6%)', selected: true });&#xD;
            arr.push({ id: 9, text: '大吃(9%)' });&#xD;
            arr.push({ id: 0, text: '关闭' });&#xD;
            return arr;&#xD;
        }&#xD;
        function getComboValPut() {&#xD;
            var arr = [];&#xD;
            arr.push({ id: 3, text: '小放(3%)', selected: true });&#xD;
            arr.push({ id: 6, text: '中放(6%)' });&#xD;
            arr.push({ id: 9, text: '大放(9%)' });&#xD;
            arr.push({ id: 0, text: '关闭' });&#xD;
            return arr;&#xD;
        }&#xD;
        @*总控专用 - 吃分只显示吃分，默认吃分*@&#xD;
        function getComboValKill_Total() {&#xD;
            var arr = [];&#xD;
            //arr.push({ id: 3, text: '小吃(3%)', selected: true });&#xD;
            arr.push({ id: 3, text: '吃分', selected: true });&#xD;
            arr.push({ id: 0, text: '关闭' });&#xD;
            return arr;&#xD;
        }&#xD;
        @*总控专用 - 放水只显示放水，默认放水*@&#xD;
        function getComboValPut_Total() {&#xD;
            var arr = [];&#xD;
            //arr.push({ id: 3, text: '小放(3%)', selected: true });&#xD;
            arr.push({ id: 3, text: '放水', selected: true });&#xD;
            arr.push({ id: 0, text: '关闭' });&#xD;
            return arr;&#xD;
        }&#xD;
&#xD;
        var _menuUser = null;&#xD;
        var _menuInited = false;&#xD;
&#xD;
        function showMenuModal() {&#xD;
            var dlg = $('#menuModal');&#xD;
            if (!_menuInited) {&#xD;
                dlg.dialog({&#xD;
                title: '【功能菜单】',&#xD;
                width: 320,&#xD;
                height: 'auto', // 高度自适应内容，完整显示所有按钮、不出现滚动条&#xD;
                modal: true,&#xD;
                    closed: true,&#xD;
                    collapsible: false,&#xD;
                    minimizable: false,&#xD;
                    maximizable: false,&#xD;
                    resizable: false&#xD;
                });&#xD;
                _menuInited = true;&#xD;
            }&#xD;
            dlg.dialog('open');&#xD;
        }&#xD;
&#xD;
        function closeMenu() {&#xD;
            $('#menuModal').dialog('close');&#xD;
        }&#xD;
&#xD;
        function menuDelete() { closeMenu(); deleteUser(_menuUser.ID); }&#xD;
        function menuControl() { closeMenu(); showTotalCtrlWin(_menuUser.ID); }&#xD;
        function menuKick() { closeMenu(); kickPlayer(_menuUser.ID); }&#xD;
        function menuRecharge() { closeMenu(); showReChange(_menuUser.ID); }&#xD;
        function menuDeduct() { closeMenu(); showDeduct(_menuUser.ID); }&#xD;
        function menuChgPwd() { closeMenu(); showChgWin(_menuUser.ID); }&#xD;
        function menuFrozen() { closeMenu(); frozenUser(_menuUser.ID, (_menuUser.FROZEN == 1 ? 0 : 1)); }&#xD;
&#xD;
        function bindRowClickMenu() {&#xD;
            if (bindRowClickMenu._done) return;&#xD;
            bindRowClickMenu._done = true;&#xD;
            document.addEventListener('click', function (e) {&#xD;
                if (!e.target || !e.target.closest) return;&#xD;
                var row = e.target.closest('tr.datagrid-row');&#xD;
                if (!row) return;&#xD;
                var panel = $('#tb_UserInfo').datagrid('getPanel');&#xD;
                if (!panel.length || !panel[0].contains(row)) return;&#xD;
                if (e.target.closest('a') || e.target.closest('input[type=checkbox]')) return;&#xD;
                var idx = parseInt(row.getAttribute('datagrid-row-index'));&#xD;
                if (isNaN(idx)) return;&#xD;
                var rows = $('#tb_UserInfo').datagrid('getRows');&#xD;
                var rd = rows[idx];&#xD;
                if (rd &amp;&amp; rd.FROZEN != 2) {&#xD;
                    _menuUser = rd;&#xD;
                    $('#menuUserAccount').text(rd.ID || '');&#xD;
                    $('#menuUserName').text(rd.NAME || '');&#xD;
                    // 冻结按钮：按用户当前状态显示 冻结/解冻，并按权限显隐&#xD;
                    $('#menuBtnFrozen').text(rd.FROZEN == 1 ? '解冻' : '冻结');&#xD;
                    @if (loginUser.UserPriv == 0 || loginUser.IsFrozen == 1)&#xD;
                    {&#xD;
                        &lt;text&gt;$('#menuBtnFrozen').show();&lt;/text&gt;&#xD;
                    }&#xD;
                    else&#xD;
                    {&#xD;
                        &lt;text&gt;$('#menuBtnFrozen').hide();&lt;/text&gt;&#xD;
                    }&#xD;
                    if (canKick &amp;&amp; (canKickWholeLine || rd.AGENCY == loginAgencyAccount))&#xD;
                        $('#menuBtnKick').show();&#xD;
                    else&#xD;
                        $('#menuBtnKick').hide();&#xD;
                    showMenuModal();&#xD;
                }&#xD;
            }, true);&#xD;
        }&#xD;
    &lt;/script&gt;&#xD;
    &lt;style&gt;&#xD;
        .dialog-coin-tip { display: block; padding-top: 6px; color: #c00; white-space: nowrap; }&#xD;
        .coin-dialog-table { width: auto; margin: 0 auto; }&#xD;
        .coin-dialog-label { width: 72px; text-align: right; white-space: nowrap; vertical-align: top; padding-top: 9px; }&#xD;
        .coin-dialog-field { text-align: left; white-space: nowrap; }&#xD;
        .coin-dialog-tip { color: #999; text-align: left; }&#xD;
        .coin-dialog-form { min-height: 260px; height: 100%; display: flex; align-items: center; justify-content: center; margin: 0; }&#xD;
        .menu-btn-item { display: block; width: 100%; padding: 12px 0; border: none; border-radius: 6px; font-size: 18px; font-weight: 600; cursor: pointer; margin-bottom: 8px; text-decoration: none; text-align: center; transition: opacity 0.2s; box-sizing: border-box; }&#xD;
        .menu-btn-item:hover { opacity: 0.85; }&#xD;
        .menu-btn-item:last-child { margin-bottom: 0; }&#xD;
        .menu-btn-control { background: #ecf5ff; color: #409eff; }&#xD;
        .menu-btn-recharge { background: #f0f9eb; color: #67c23a; }&#xD;
        .menu-btn-deduct { background: #fdf6ec; color: #e6a23c; }&#xD;
        .menu-btn-kick { background: #fef0f0; color: #f56c6c; }&#xD;
        .menu-btn-pwd { background: #f3f0ff; color: #722ed1; }&#xD;
        .menu-btn-frozen { background: #e6f7ff; color: #1890ff; }&#xD;
        .menu-btn-delete { background: #fff1f0; color: #cf1322; }&#xD;
        .menu-btn-back { background: #f5f7fa; color: #606266; }&#xD;
    &lt;/style&gt;&#xD;
}&#xD;
&#xD;
@*查询条件*@&#xD;
&lt;form id="frm_srch"&gt;&#xD;
    &lt;table width="100%" border="0" cellpadding="0" cellspacing="0" class="titleQueBg" style="height:40px;"&gt;&#xD;
        &lt;tr&gt;&#xD;
            &lt;td&gt;&#xD;
                &lt;div class="left Lpd5"&gt;&#xD;
                    用户账号&#xD;
                    &lt;input type="text" class="easyui-textbox" name="srch_ID" /&gt;&#xD;
                &lt;/div&gt;&#xD;
                &lt;div class="left Lpd5"&gt;&#xD;
                    昵称&#xD;
                    &lt;input type="text" class="easyui-textbox" name="srch_NAME" /&gt;&#xD;
                &lt;/div&gt;&#xD;
                &lt;div class="left Lpd5"&gt;&#xD;
                    所属代理&#xD;
                    &lt;input type="text" class="easyui-textbox" name="srch_Agency" /&gt;&#xD;
                &lt;/div&gt;&#xD;
                @*&lt;div class="left Lpd5"&gt;&#xD;
                        开始时间&#xD;
                        &lt;input class="easyui-datetimebox" name="srch_StartTime"&#xD;
                               data-options="required:true,showSeconds:false" value="3/4/2010 2:3" style="width:150px"&gt;&#xD;
                    &lt;/div&gt;&#xD;
                    &lt;div class="left Lpd5"&gt;&#xD;
                        结束时间&#xD;
                        &lt;input class="easyui-datetimebox" name="srch_EndTime"&#xD;
                               data-options="required:true,showSeconds:false" value="3/4/2010 2:3" style="width:150px"&gt;&#xD;
                    &lt;/div&gt;*@&#xD;
                &lt;div class="left Lmg10"&gt;&#xD;
                    &lt;a href="javascript:void(0);" class="easyui-linkbutton" onclick="queryData();" data-options="plain:true,iconCls:'icon-search'"&gt;查找&lt;/a&gt;&#xD;
                    &lt;a href="javascript:void(0);" class="easyui-linkbutton" onclick="showAddUser();" data-options="plain:true,iconCls:'icon-add'"&gt;添加用户&lt;/a&gt;&#xD;
                    @if (loginUser?.UserPriv == 0)&#xD;
                    {&#xD;
                        &lt;a href="javascript:void(0);" class="easyui-linkbutton" onclick="kickPlayer();" data-options="plain:true,iconCls:'icon-user_cross'"&gt;剔除所有人&lt;/a&gt;&#xD;
                    }&#xD;
                    @if (loginUser?.UserPriv == 1 &amp;&amp; loginUser?.IsKicking == 1)&#xD;
                    {&#xD;
                        &lt;a href="javascript:void(0);" class="easyui-linkbutton" onclick="kickPlayer();" data-options="plain:true,iconCls:'icon-user_cross'"&gt;@(loginUser?.ManageScope == 2 ? "剔除整条线在线玩家" : "剔除直属在线玩家")&lt;/a&gt;&#xD;
                    }&#xD;
                &lt;/div&gt;&#xD;
            &lt;/td&gt;&#xD;
        &lt;/tr&gt;&#xD;
    &lt;/table&gt;&#xD;
&lt;/form&gt;&#xD;
&#xD;
@*查询代理的信息*@&#xD;
&lt;table id="tb_UserInfo"&gt;&#xD;
    &lt;thead&gt;&#xD;
        &lt;tr&gt;&#xD;
            &lt;th data-options="field:'ck',checkbox:true"&gt;&lt;/th&gt;&#xD;
            &lt;th field="ID" width="75"&gt;用户账号&lt;/th&gt;&#xD;
            &lt;th field="NAME" width="75"&gt;昵称&lt;/th&gt;&#xD;
            &lt;th field="AGENCY" width="60"&gt;所属代理&lt;/th&gt;&#xD;
            &lt;th field="FROZEN" width="45" formatter="fmtForzen"&gt;是否冻结&lt;/th&gt;&#xD;
            &lt;th field="INHALL" width="45" formatter="fmtForzen"&gt;是否在线&lt;/th&gt;&#xD;
            &lt;th field="COINS" width="65" formatter="fmtCoins" sortable="true"&gt;账面余额&lt;/th&gt;&#xD;
            &lt;th field="GAME_SCORE" width="65" formatter="fmtCoins" sortable="true"&gt;账面游戏分&lt;/th&gt;&#xD;
            &lt;th field="CurrentGameName" width="120" hidden="true"&gt;当前游戏&lt;/th&gt;&#xD;
            &lt;th field="CurrentRoomId" width="80" hidden="true"&gt;当前厅&lt;/th&gt;&#xD;
            &lt;th field="CurrentTableId" width="80" hidden="true"&gt;桌号&lt;/th&gt;&#xD;
            &lt;th field="CurrentSeatId" width="80" hidden="true"&gt;座号&lt;/th&gt;&#xD;
            &lt;th field="CurrentBetCoins" width="90" formatter="fmtCoins" hidden="true"&gt;下注&lt;/th&gt;&#xD;
            &lt;th field="CurrentWinLose" width="90" formatter="fmtCoins" hidden="true"&gt;当前输赢&lt;/th&gt;&#xD;
            &lt;th field="COINS_BUY" width="70" formatter="fmtCoins"&gt;充值&lt;/th&gt;&#xD;
            &lt;th field="COINS_BACK" width="60" formatter="fmtCoins"&gt;兑换&lt;/th&gt;&#xD;
            &lt;th field="TodayWinLoss" width="60" formatter="fmtWinLoss" sortable="true" order="desc"&gt;今日盈亏&lt;/th&gt;&#xD;
            &lt;th field="Profit" width="70" formatter="fmtWinLoss" sortable="true" order="desc"&gt;总盈亏&lt;/th&gt;&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsViewPwd == 1)
            {&#xD;
                &lt;th field="PWD" width="75"&gt;用户密码&lt;/th&gt;&#xD;
                &lt;!-- 保险柜密码已隐藏 --&gt;&#xD;
            }&#xD;
            &lt;!-- 保险柜余额已隐藏 --&gt;&#xD;
            @*@if (loginUser?.UserPriv == 0)&#xD;
                {&#xD;
                    &lt;th field="TELEPHONE" width="110"&gt;手机号&lt;/th&gt;&#xD;
                }*@&#xD;
            &lt;th field="OPT" width="700" formatter="fmtOpt" hidden="true"&gt;操作&lt;/th&gt;&#xD;
&#xD;
        &lt;/tr&gt;&#xD;
    &lt;/thead&gt;&#xD;
&lt;/table&gt;&#xD;
&#xD;
