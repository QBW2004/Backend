                &lt;td align="right" style="width:30%;"&gt;用户账号&lt;/td&gt;&#xD;
                &lt;td align="left" class="pd5"&gt;&#xD;
                    &lt;input class="easyui-textbox win-txt" id="txtE_ID1" disabled /&gt;&#xD;
                &lt;/td&gt;&#xD;
            &lt;/tr&gt;&#xD;
            &lt;tr&gt;&#xD;
                &lt;td align="right"&gt;功能&lt;/td&gt;&#xD;
                &lt;td align="left" class="pd5"&gt;&#xD;
                    &lt;select class="easyui-combobox win-txt" id="selE_Mode" name="Mode" data-options="valueField:'id',textField:'text',panelHeight:'auto'"&gt;&lt;/select&gt;&#xD;
                &lt;/td&gt;&#xD;
            &lt;/tr&gt;&#xD;
            &lt;tr class="trPaiJiCtrl"&gt;&#xD;
                &lt;td align="right"&gt;游戏类型&lt;/td&gt;&#xD;
                &lt;td align="left" class="pd5"&gt;&#xD;
                    &lt;select class="easyui-combobox win-txt" id="selE_Action" name="Action1" data-options="valueField:'id',textField:'text',panelHeight:150"&gt;&lt;/select&gt;&#xD;
                &lt;/td&gt;&#xD;
            &lt;/tr&gt;&#xD;
            &lt;tr class="trPaiJiCtrl"&gt;&#xD;
