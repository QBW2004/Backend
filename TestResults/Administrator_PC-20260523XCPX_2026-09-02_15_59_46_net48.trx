        function valSelDataMx97() {&#xD;
            @*明星97控牌=按结果类 code 强制（与游戏配置页奖励结果设置/服务端 Mx97Rtp::ComboToClass 一致）：&#xD;
               300-308纯色三连 310 ANY BAR 311/312樱桃2/1连 322-329 Scatter 330全水果 340-347全屏 350全屏BAR；10=关闭。&#xD;
               控牌值兼容旧值 0-8（单线三连符号）*@&#xD;
            var arr = [];&#xD;
