            arr.push({ id: 325, text: 'Scatter 全盘5个七(40倍)' });&#xD;
            arr.push({ id: 326, text: 'Scatter 全盘6个七(60倍)' });&#xD;
            arr.push({ id: 327, text: 'Scatter 全盘7个七(80倍)' });&#xD;
            arr.push({ id: 328, text: 'Scatter 全盘8个七(100倍)' });&#xD;
            arr.push({ id: 329, text: 'Scatter 全盘9个七(200倍)' });&#xD;
            arr.push({ id: 330, text: '全水果(15倍)' });&#xD;
            arr.push({ id: 340, text: '全屏·樱桃(80倍)' });&#xD;
            arr.push({ id: 341, text: '全屏·橘子(40倍)' });&#xD;
            arr.push({ id: 342, text: '全屏·蓝莓(40倍)' });&#xD;
