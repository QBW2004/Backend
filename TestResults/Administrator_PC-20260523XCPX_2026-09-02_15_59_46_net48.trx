            arr.push({ id: 324, text: 'Scatter 全盘4个七(20倍)' });&#xD;
            arr.push({ id: 325, text: 'Scatter 全盘5个七(40倍)' });&#xD;
            arr.push({ id: 326, text: 'Scatter 全盘6个七(60倍)' });&#xD;
            arr.push({ id: 327, text: 'Scatter 全盘7个七(80倍)' });&#xD;
            arr.push({ id: 328, text: 'Scatter 全盘8个七(100倍)' });&#xD;
