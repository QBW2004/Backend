        function showDeduct(uid) {&#xD;
            var para = {&#xD;
                winId: '#chgDeduct',&#xD;
                title: '【用户扣币】',&#xD;
                iconCls: 'icon-user-edit',&#xD;
                callBack: function () {&#xD;
                    $('#txtE_UID5').textbox('setValue', uid);&#xD;
                    $('#hfUID5').val(uid);&#xD;
                    resetPlayerCoins('#txtCurrentCoins_Deduct', '#btnSaveDeduct');&#xD;
                    QueryPlayerCoins('#hfUID5', '#txtCurrentCoins_Deduct', '#btnSaveDeduct');&#xD;
