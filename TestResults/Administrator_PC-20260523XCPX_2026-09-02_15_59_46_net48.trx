            arr.push({ id: 345, text: '全屏·黄BAR(60倍)' });&#xD;
            arr.push({ id: 346, text: '全屏·红BAR(90倍)' });&#xD;
            arr.push({ id: 347, text: '全屏·蓝BAR(100倍)' });&#xD;
