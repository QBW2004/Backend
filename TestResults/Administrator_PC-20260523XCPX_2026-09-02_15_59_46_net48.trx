      <Output>
        <ErrorInfo>
          <Message>StringAssert.Contains 失败。字符串“@{&#xD;
    Layout = "~/Views/Shared/Layout/_ContentLayout.cshtml";&#xD;
    ViewBag.RouteMap = "用户管理";&#xD;
    M_LoginUser loginUser = WebHelper.GetLoginInfo();&#xD;
}&#xD;
&#xD;
@section include_res{&#xD;
    &lt;script&gt;&#xD;
    var canKickWholeLine = @((loginUser?.UserPriv == 0 || loginUser?.ManageScope == 2).ToString().ToLower());&#xD;
    var loginAgencyAccount = "@(loginUser?.Accounts)";&#xD;
    var canDelete = @((loginUser?.UserPriv == 0 || loginUser?.IsDelete == 1).ToString().ToLower());&#xD;
    var canControl = @((loginUser?.UserPriv == 0 || loginUser?.IsKill == 1 || loginUser?.IsProbability == 1 || loginUser?.IsRelease == 1).ToString().ToLower());&#xD;
    var canKick = @((loginUser?.UserPriv == 0 || loginUser?.IsKicking == 1).ToString().ToLower());&#xD;
    var canUpDown = @((loginUser?.UserPriv == 0 || loginUser?.IsUpDown == 1).ToString().ToLower());&#xD;
    var canModifyPwd = @((loginUser?.UserPriv == 0 || loginUser?.IsModifyPwd == 1).ToString().ToLower());&#xD;
    $(function () {&#xD;
        // 加载指定的模块&#xD;
        easyloader.load(['textbox', 'linkbutton', 'datagrid', 'dialog'], function () {&#xD;
            //适应窗口大小变化&#xD;
            $(window).resize(function () {&#xD;
                if ($('body').data('grid-init')) {&#xD;
                    setGridSize();&#xD;
                }&#xD;
            });&#xD;
            //初始化插件&#xD;
            pluginInit();&#xD;
            bindUserRechargeCoinTriggers();&#xD;
            //初始化查询&#xD;
            queryData();&#xD;
            startUserInfoAutoRefresh();&#xD;
        });&#xD;
&#xD;
&#xD;
        //setTimeout(function () {&#xD;
        //    $(".panel-body-noheader").eq(1).children('div').each(function (index) {&#xD;
        //        $(this).on("click", function () {&#xD;
        //            goFirstPage(index);&#xD;
        //        });&#xD;
        //    })&#xD;
&#xD;
        //    $(".panel-body-noheader").eq(2).children('div').each(function (index) {&#xD;
        //        $(this).on("click", function () {&#xD;
        //            let text = $(this).text();&#xD;
        //            setTimeout(function () {&#xD;
        //                $("#_easyui_textbox_input14").val(text)&#xD;
        //            }, 10)&#xD;
        //        });&#xD;
        //    })&#xD;
        //},1000)&#xD;
    })&#xD;
    //    function goFirstPage(index) {&#xD;
    //        valSelData(index)&#xD;
    //}&#xD;
    //重置表格大小&#xD;
    function setGridSize(param) {&#xD;
        var w = 840; // 固定表宽（与在线用户页一致），不再占满整屏&#xD;
        var h = $(window).height() - 78;&#xD;
        resizeGrid('tb_UserInfo', w, h);&#xD;
    }&#xD;
    //查询数据&#xD;
    function queryData() {&#xD;
        var para = $("#frm_srch").serializeObject();&#xD;
        bindGridData(para);&#xD;
    }&#xD;
    var userInfoAutoRefreshTimer = null;&#xD;
    var userInfoSilentRefreshRunning = false;&#xD;
    function startUserInfoAutoRefresh() {&#xD;
        if (userInfoAutoRefreshTimer) {&#xD;
            clearInterval(userInfoAutoRefreshTimer);&#xD;
        }&#xD;
        userInfoAutoRefreshTimer = setInterval(function () {&#xD;
            refreshVisibleUserRows();&#xD;
        }, 3000);&#xD;
    }&#xD;
    function getVisibleUserIds() {&#xD;
        var grid = $('#tb_UserInfo');&#xD;
        if (!grid.data('datagrid')) {&#xD;
            return [];&#xD;
        }&#xD;
        var rows = grid.datagrid('getRows') || [];&#xD;
        var ids = [];&#xD;
        for (var i = 0; i &lt; rows.length; i++) {&#xD;
            if (rows[i] &amp;&amp; rows[i].ID) {&#xD;
                ids.push(rows[i].ID);&#xD;
            }&#xD;
        }&#xD;
        return ids;&#xD;
    }&#xD;
    function refreshVisibleUserRows() {&#xD;
        refreshVisibleUserRowsByIds(getVisibleUserIds());&#xD;
    }&#xD;
    function refreshVisibleUserRowsByIds(ids) {&#xD;
        var grid = $('#tb_UserInfo');&#xD;
        if (!grid.data('datagrid') || userInfoSilentRefreshRunning || !ids || ids.length &lt; 1) {&#xD;
            return;&#xD;
        }&#xD;
        userInfoSilentRefreshRunning = true;&#xD;
        $.ajax({&#xD;
            url: '/Game/UserInfo/GetVisibleUserRows',&#xD;
            type: 'POST',&#xD;
            dataType: 'json',&#xD;
            data: { UserIDs: JSON.stringify(ids) },&#xD;
            success: function (data) {&#xD;
                if (!data || data.code != 1 || !data.datas) {&#xD;
                    return;&#xD;
                }&#xD;
                applyVisibleUserRows(data.datas);&#xD;
            },&#xD;
            complete: function () {&#xD;
                userInfoSilentRefreshRunning = false;&#xD;
            }&#xD;
        });&#xD;
    }&#xD;
    function applyVisibleUserRows(serverRows) {&#xD;
        var grid = $('#tb_UserInfo');&#xD;
        var rows = grid.datagrid('getRows') || [];&#xD;
        var indexById = {};&#xD;
        for (var i = 0; i &lt; rows.length; i++) {&#xD;
            if (rows[i] &amp;&amp; rows[i].ID) {&#xD;
                indexById[rows[i].ID] = i;&#xD;
            }&#xD;
        }&#xD;
        for (var j = 0; j &lt; serverRows.length; j++) {&#xD;
            var fresh = serverRows[j];&#xD;
            if (!fresh || indexById[fresh.ID] == null) {&#xD;
                continue;&#xD;
            }&#xD;
            var rowIndex = indexById[fresh.ID];&#xD;
            grid.datagrid('updateRow', {&#xD;
                index: rowIndex,&#xD;
                row: $.extend({}, rows[rowIndex], fresh)&#xD;
            });&#xD;
        }&#xD;
        refreshUserInfoFooter();&#xD;
    }&#xD;
    function refreshUserInfoFooter() {&#xD;
        var rows = $('#tb_UserInfo').datagrid('getRows') || [];&#xD;
        var footer = {&#xD;
            FROZEN: 2,&#xD;
            NAME: '合计',&#xD;
            COINS: 0,&#xD;
            GAME_SCORE: 0,&#xD;
            COINS_BUY: 0,&#xD;
            COINS_BACK: 0,&#xD;
            TodayWinLoss: 0,&#xD;
            Profit: 0&#xD;
        };&#xD;
        for (var i = 0; i &lt; rows.length; i++) {&#xD;
            footer.COINS += Number(rows[i].COINS || 0);&#xD;
            footer.GAME_SCORE += Number(rows[i].GAME_SCORE || 0);&#xD;
            footer.COINS_BUY += Number(rows[i].COINS_BUY || 0);&#xD;
            footer.COINS_BACK += Number(rows[i].COINS_BACK || 0);&#xD;
            footer.TodayWinLoss += Number(rows[i].TodayWinLoss || 0);&#xD;
            footer.Profit += Number(rows[i].Profit || 0);&#xD;
        }&#xD;
        $('#tb_UserInfo').datagrid('reloadFooter', [footer]);&#xD;
    }&#xD;
    function refreshChangedUserRow(id, delay) {&#xD;
        if (!id) {&#xD;
            setTimeout(function () { refreshVisibleUserRows(); }, delay || 0);&#xD;
            return;&#xD;
        }&#xD;
        setTimeout(function () { refreshVisibleUserRowsByIds([id]); }, delay || 0);&#xD;
    }&#xD;
    function patchVisibleUserRow(id, patch) {&#xD;
        var grid = $('#tb_UserInfo');&#xD;
        if (!grid.data('datagrid') || !id || !patch) {&#xD;
            return;&#xD;
        }&#xD;
        var rowIndex = grid.datagrid('getRowIndex', id);&#xD;
        if (rowIndex &lt; 0) {&#xD;
            return;&#xD;
        }&#xD;
        grid.datagrid('updateRow', { index: rowIndex, row: patch });&#xD;
        refreshUserInfoFooter();&#xD;
    }&#xD;
    //绑定表格数据&#xD;
    function bindGridData(para) {&#xD;
        if (!$('body').data('grid-init')) {&#xD;
            $('#tb_UserInfo').datagrid({&#xD;
                url: "/Game/UserInfo/GetUsers",&#xD;
                queryParams: $.extend({}, para),&#xD;
                pagination: true,&#xD;
                fitColumns: true,&#xD;
                checkbox: true,&#xD;
                singleSelect: false,&#xD;
                striped: true,&#xD;
                rownumbers: true,&#xD;
                showFooter: true,&#xD;
                height: 768,&#xD;
                pageSize: 20,&#xD;
                pageList: [10, 20, 50],&#xD;
                idField: 'ID',&#xD;
                //sortName: 'INHALL',&#xD;
                //sortOrder: 'desc',&#xD;
                //remoteSort: false,&#xD;
                onBeforeLoad: setGridSize,&#xD;
                onLoadSuccess: function (data) {&#xD;
                    if (window.onLoaded) onLoaded(data);&#xD;
                    bindRowClickMenu();&#xD;
                }&#xD;
            });&#xD;
        } else {&#xD;
            $('#tb_UserInfo').datagrid('load', para);&#xD;
        }&#xD;
    }&#xD;
    //格式化&#xD;
        function fmtForzen(value, rowData, rowIndex) {&#xD;
            if (rowData.FROZEN != 2) {&#xD;
                if (value == 1)&#xD;
                    return '&lt;span class="red"&gt;是&lt;/span&gt;';&#xD;
                else&#xD;
                    return '&lt;span&gt;否&lt;/span&gt;';&#xD;
&#xD;
            } else {&#xD;
                return '';&#xD;
            }&#xD;
        }&#xD;
        function fmtOpt(value, rowData, rowIndex) {&#xD;
            if (!rowData || rowData.FROZEN == 2) {&#xD;
                return '';&#xD;
            }&#xD;
            var arr = [];&#xD;
            if (rowData.FROZEN != 2) {&#xD;
                @if (loginUser.UserPriv == 0 || loginUser.IsDelete == 1)&#xD;
                {&#xD;
                @Html.Raw("arr.push('&lt;a href=\"javascript:void(0)\" class=\"blue Lpd5\" onclick=\"deleteUser(\\\'' + rowData.ID + '\\\')\"&gt;删除&lt;/a&gt;');");&#xD;
                }&#xD;
                // arr.push('&lt;a href="javascript:void(0)" class="blue Lpd5" onclick="showGrade(\'' + rowData.ID + '\')"&gt;等级设置&lt;/a&gt;');&#xD;
                if (rowData.FROZEN == 1) {&#xD;
                  @if (loginUser.IsFrozen == 1) {&#xD;
                       @Html.Raw("arr.push('&lt;a href=\"javascript: void(0)\" class=\"blue Lpd5\" onclick=\"frozenUser(\\\'' + rowData.ID + '\\\',0)\"&gt;解冻&lt;/a&gt;'); ");&#xD;
                  }&#xD;
                }&#xD;
                else {&#xD;
                  @if (loginUser.IsFrozen == 1)&#xD;
                  {&#xD;
                       @Html.Raw("arr.push('&lt;a href=\"javascript: void(0)\" class=\"blue Lpd5\" onclick=\"frozenUser(\\\'' + rowData.ID + '\\\',1)\"&gt;冻结&lt;/a&gt;'); ");&#xD;
                  }&#xD;
                }&#xD;
                 @if (loginUser.UserPriv == 0 || loginUser.IsKill == 1 || loginUser.IsProbability == 1 || loginUser.IsRelease == 1)&#xD;
                 {&#xD;
                      @Html.Raw("arr.push('&lt;a href=\"javascript:void(0)\" class=\"blue Lpd5\" onclick=\"showTotalCtrlWin(\\\'' + rowData.ID + '\\\')\"&gt;控制&lt;/a&gt;');");&#xD;
                 }&#xD;
                @*鱼机控制已合并到「控制」按钮*@&#xD;
                @*牌机控制已合并到「控制」按钮*@&#xD;
                @*注机控制已合并到「控制」按钮*@&#xD;
                @if (loginUser.UserPriv == 0 || loginUser.IsKicking == 1)&#xD;
                 {&#xD;
                    @Html.Raw("if (canKickWholeLine || rowData.AGENCY == loginAgencyAccount) {");&#xD;
                      @Html.Raw("arr.push('&lt;a href=\"javascript:void(0)\" class=\"blue Lpd5\" onclick=\"kickPlayer(\\\'' + rowData.ID + '\\\')\"&gt;踢人&lt;/a&gt;');");&#xD;
                    @Html.Raw("}");&#xD;
                 }&#xD;
            }&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsUpDown == 1)&#xD;
            {&#xD;
            @Html.Raw("arr.push('&lt;a href=\"javascript:void(0)\" class=\"blue Lpd5\" onclick=\"showReChange(\\\'' + rowData.ID + '\\\')\"&gt;充值&lt;/a&gt;');");&#xD;
            }&#xD;
            // arr.push('&lt;a href="javascript:void(0)" class="blue Lpd5" onclick="showGive(\'' + rowData.ID + '\')"&gt;赠送&lt;/a&gt;');&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsUpDown == 1)&#xD;
            {&#xD;
            @Html.Raw("arr.push('&lt;a href=\"javascript:void(0)\" class=\"blue Lpd5\" onclick=\"showDeduct(\\\'' + rowData.ID + '\\\')\"&gt;扣币&lt;/a&gt;');");&#xD;
            }&#xD;
            @if (false)&#xD;
            {&#xD;
            @Html.Raw("arr.push('&lt;a href=\"javascript:void(0)\" class=\"blue Lpd5\" onclick=\"showChgSafePwdWin(\\\'' + rowData.ID + '\\\')\"&gt;修改保险柜密码&lt;/a&gt;');");&#xD;
            }&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsModifyPwd == 1)&#xD;
            {&#xD;
            @Html.Raw("arr.push('&lt;a href=\"javascript:void(0)\" class=\"blue Lpd5\" onclick=\"showChgWin(\\\'' + rowData.ID + '\\\')\"&gt;修改密码&lt;/a&gt;');");&#xD;
            }&#xD;
            return arr.join('  ');&#xD;
        }&#xD;
        function fmtCoins(value, rowData, rowIndex) {&#xD;
            return top.goldFormat(value);&#xD;
        }&#xD;
        function fmtWinLoss(value, rowData, rowIndex) {&#xD;
            var num = Number(value || 0);&#xD;
            var color = num &gt; 0 ? '#3c9b5f' : (num &lt; 0 ? '#d9534f' : '#333');&#xD;
            return '&lt;span style="color:' + color + '"&gt;' + top.goldFormat(num) + '&lt;/span&gt;';&#xD;
        }&#xD;
        function showUserToast(message, type) {&#xD;
            var toast = $('#userInfoToast');&#xD;
            if (toast.length &lt; 1) {&#xD;
                toast = $('&lt;div id="userInfoToast"&gt;&lt;/div&gt;').appendTo('body');&#xD;
            }&#xD;
            var color = '#4b89dc';&#xD;
            if (type == 'success')&#xD;
                color = '#3c9b5f';&#xD;
            else if (type == 'danger' || type == 'error')&#xD;
                color = '#d9534f';&#xD;
            else if (type == 'warning')&#xD;
                color = '#f0ad4e';&#xD;
            toast.stop(true, true)&#xD;
                .text(message)&#xD;
                .css({&#xD;
                    position: 'fixed',&#xD;
                    top: '18px',&#xD;
                    left: '50%',&#xD;
                    transform: 'translateX(-50%)',&#xD;
                    zIndex: 99999,&#xD;
                    background: color,&#xD;
                    color: '#fff',&#xD;
                    padding: '10px 22px',&#xD;
                    borderRadius: '4px',&#xD;
                    boxShadow: '0 4px 12px rgba(0,0,0,.18)',&#xD;
                    fontSize: '14px',&#xD;
                    lineHeight: '20px',&#xD;
                    display: 'none'&#xD;
                })&#xD;
                .fadeIn(120)&#xD;
                .delay(5000)&#xD;
                .fadeOut(180);&#xD;
        }&#xD;
        function showUserResult(data, dangerOnSuccess) {&#xD;
            if (!data)&#xD;
                return;&#xD;
            if (data.code == -1) {&#xD;
                loginTimeoutCallback(data);&#xD;
                return;&#xD;
            }&#xD;
            var message = data.msg ? data.msg : data.content;&#xD;
            var type = data.code &lt; 1 ? 'danger' : (dangerOnSuccess ? 'danger' : 'success');&#xD;
            showUserToast(message, type);&#xD;
        }&#xD;
        function frozenUser(id, flag) {&#xD;
            confirm('确认' + (flag == 0 ? '解冻' : '冻结') + '选定的用户？', function () {&#xD;
                request('/Game/UserInfo/FrozenUser', { ID: id, frozen: flag }, function (data) {&#xD;
                    //提示消息&#xD;
                    showUserResult(data);&#xD;
                    if (data &amp;&amp; data.code == 1) {&#xD;
                        patchVisibleUserRow(id, { FROZEN: flag });&#xD;
                        refreshChangedUserRow(id, 300);&#xD;
                    }&#xD;
                });&#xD;
            });&#xD;
        }&#xD;
        function deleteUser(id) {&#xD;
             @Html.Raw(@"        confirm('确认删除所选用户？', function () {&#xD;
                request('/Game/UserInfo/DelUser', { ID: id }, function (data) {&#xD;
                    //提示消息&#xD;
                    showUserResult(data, data &amp;&amp; data.code == 1);&#xD;
                    if (data &amp;&amp; data.code == 1) {&#xD;
                        queryData();//重新加载数据&#xD;
                    }&#xD;
                });&#xD;
            });");&#xD;
        }&#xD;
&#xD;
