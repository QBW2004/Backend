            arr.push({ id: 10, text: '关闭控制' });&#xD;
            return arr;&#xD;
        }&#xD;
        function valSelDataFruit() {&#xD;
            @*水果拉霸控牌=强制大转盘指向面板位（与机台设定的 24 面板位一致）；id=30+面板位，10=关闭；&#xD;
               按倍率小到大排（送灯位无倍率=免费局排最后；同倍率按面板位），控牌值不变。&#xD;
               文本不再带"面板X"前缀（面板位仍由 id=30+面板位 编码，回显同文本）*@&#xD;
            var panels = [&#xD;
                '橘子·大(10倍)', '铃铛·大(20倍)', 'BAR·小(50倍)', 'BAR·大(120倍)', '苹果(5倍)', '苹果·小(3倍)',&#xD;
                '柠檬·大(15倍)', '西瓜·大(20倍)', '西瓜·小(3倍)', '送灯位(免费局)', '苹果(5倍)', '橘子·小(3倍)',&#xD;
                '橘子·大(10倍)', '铃铛·大(20倍)', '双7·小(3倍)', '双7·大(40倍)', '苹果(5倍)', '柠檬·小(3倍)',&#xD;
                '柠檬·大(15倍)', '星星·小(3倍)', '星星·大(30倍)', '送灯位(免费局)', '苹果(5倍)', '铃铛·小(3倍)'&#xD;
            ];&#xD;
            var arr = [];&#xD;
            for (var i = 0; i &lt; panels.length; i++) {&#xD;
                var m = /\((\d+)倍\)/.exec(panels[i]);&#xD;
                arr.push({ id: 30 + i, text: panels[i], mag: m ? parseInt(m[1]) : 9999 });&#xD;
            }&#xD;
            arr.sort(function (a, b) {&#xD;
                if (a.mag != b.mag) return a.mag - b.mag;&#xD;
                return (a.id - 30) - (b.id - 30);&#xD;
            });&#xD;
            arr.push({ id: 10, text: '关闭控制' });&#xD;
            return arr;&#xD;
        }&#xD;
&#xD;
        @*拉霸控牌值回显图标名（与控牌下拉/服务端映射一致；cardAction 15=水浒传 16=明星97 17=水果拉霸）*@&#xD;
        function labaTypeName(action, value) {&#xD;
            action = parseInt(action); value = parseInt(value);&#xD;
            if (value == 10) return '关闭';&#xD;
            var list = null;&#xD;
            if (action == 15) list = valSelDataShz();&#xD;
            else if (action == 16) list = valSelDataMx97();&#xD;
            else if (action == 17) list = valSelDataFruit();&#xD;
            if (list) {&#xD;
                for (var i = 0; i &lt; list.length; i++)&#xD;
                    if (list[i].id == value) return list[i].text;&#xD;
                // 兼容旧控牌值：水浒传 0-7=中间行五连符号；明星97 0-8=单线三连符号&#xD;
                if (action == 15 &amp;&amp; value &gt;= 0 &amp;&amp; value &lt;= 7)&#xD;
                    return '五连·' + ['忠义堂(1000倍)', '替天行道(400倍)', '宋江(200倍)', '林冲(160倍)', '鲁智深(100倍)', '刀(60倍)', '枪(40倍)', '斧(20倍)'][value];&#xD;
                if (action == 16 &amp;&amp; value &gt;= 0 &amp;&amp; value &lt;= 8)&#xD;
                    return '三连·' + ['樱桃(10倍)', '橘子(10倍)', '蓝莓(14倍)', '铃铛(18倍)', '西瓜(20倍)', '黄BAR(30倍)', '红BAR(50倍)', '蓝BAR(70倍)', '七(80倍+)'][value];&#xD;
            }&#xD;
            return String(value);&#xD;
        }&#xD;
&#xD;
        function actionSelDataPAIJI() {&#xD;
            return [&#xD;
                { id: 5, text: '大字版控制', selected: true  },&#xD;
                { id: 7, text: 'ATT3控制' },&#xD;
                { id: 12, text: '金皇冠' },&#xD;
                { id: 13, text: 'NBA' },&#xD;
                { id: 14, text: '火凤凰' }&#xD;
            ];&#xD;
        }&#xD;
        function valSelData() {&#xD;
            var arr = [];&#xD;
            for (var i = 0; i &lt; 11; i++)&#xD;
                if (i == 0)&#xD;
                    arr.push({ id: i, text: i });&#xD;
                else&#xD;
                    arr.push({ id: i, text: i });&#xD;
            return arr;&#xD;
        }&#xD;
        function valSelDataPAIJI1() {&#xD;
            var arr = [];&#xD;
            arr.push({ id: 5, text: '五把之内' });&#xD;
            arr.push({ id: 10, text: '十把之内' });&#xD;
            return arr;&#xD;
        }&#xD;
&#xD;
        // 牌机型13种牌型（与服务端 te_CardsType 枚举 0..12 一致，与台机设定 GC_PAYOUT_ROWS 同口径）&#xD;
        var TC_CARD_TYPES = [&#xD;
            { ht: 0, name: '杂牌' }, { ht: 1, name: '对子' }, { ht: 2, name: '两对' },&#xD;
            { ht: 3, name: '三条' }, { ht: 4, name: '杂顺' }, { ht: 5, name: '同花' },&#xD;
            { ht: 6, name: '葫芦' }, { ht: 7, name: '小四梅' }, { ht: 8, name: '大四梅' },&#xD;
            { ht: 9, name: '同花顺' }, { ht: 10, name: '五梅' }, { ht: 11, name: '同花大顺' },&#xD;
            { ht: 12, name: '五鬼' }&#xD;
        ];&#xD;
        // 各牌机游戏倍率（与台机设定 GC_MAG_TAB 一致，客户端固定值只读；ATT3 取 middle 档）&#xD;
        var TC_MAG_TAB = {&#xD;
            phenix: [0, 1, 2, 3, 5, 7, 10, 40, 80, 120, 250, 500, 1000],&#xD;
            king3:  [0, 1, 2, 3, 5, 7, 10, 60, 60, 120, 250, 500, 1000],&#xD;
            dazhi:  [0, 1, 2, 3, 5, 7, 15, 65, 65, 150, 350, 250, 350],&#xD;
            nba:    [0, 1, 2, 3, 5, 7, 10, 50, 50, 100, 400, 200, 1000],&#xD;
            att3:   [0, 1, 2, 3, 5, 7, 10, 50, 50, 120, 400, 200, 1000]&#xD;
        };&#xD;
        // cardAction -&gt; 倍率key：5大字版/7ATT3/12金皇冠/13NBA/14火凤凰&#xD;
        function tcMagKey(action) {&#xD;
            if (action == 5) return 'dazhi';&#xD;
            if (action == 7) return 'att3';&#xD;
            if (action == 12) return 'king3';&#xD;
            if (action == 13) return 'nba';&#xD;
            return 'phenix';&#xD;
        }&#xD;
        // 按 cardAction 动态生成牌机型牌型下拉：0-12 完整13种 + 99关闭控制（倍率随游戏类型变化）&#xD;
        // 大字板(5)五鬼已下线：不提供五鬼选项，与服务端 AlgProb 控制通道封死一致&#xD;
        function valSelDataPAIJI(cardAction) {&#xD;
            var mags = TC_MAG_TAB[tcMagKey(cardAction)];&#xD;
            var arr = [];&#xD;
            for (var i = 0; i &lt; TC_CARD_TYPES.length; i++) {&#xD;
                var t = TC_CARD_TYPES[i];&#xD;
                // 隐藏牌型：杂牌(0)/五鬼(12)；大四梅(8)仅火凤凰保留（大字板五鬼已下线）&#xD;
                if (t.ht == 0 || t.ht == 12) continue;&#xD;
                if (t.ht == 8 &amp;&amp; cardAction != 14) continue;&#xD;
                var item = { id: t.ht, text: t.name + '(' + mags[t.ht] + '倍)' };&#xD;
                if (t.ht == 4) item.selected = true; // 默认选中杂顺&#xD;
                arr.push(item);&#xD;
            }&#xD;
            arr.push({ id: 99, text: '关闭控制' });&#xD;
            return arr;&#xD;
        }&#xD;
&#xD;
        function valSelDataPAIJI2() {&#xD;
            var arr = [];&#xD;
            arr.push({ id: 0, text: '杂牌(0倍)' });&#xD;
            arr.push({ id: 1, text: '一对(1倍)' });&#xD;
            arr.push({ id: 2, text: '两对(2倍)' });&#xD;
            arr.push({ id: 3, text: '三条(3倍)' });&#xD;
            arr.push({ id: 4, text: '顺子(5倍)' });&#xD;
            arr.push({ id: 5, text: '同花(7倍)' });&#xD;
            arr.push({ id: 6, text: '葫芦(15倍)' });&#xD;
            arr.push({ id: 7, text: '小四梅(65倍)' });&#xD;
            arr.push({ id: 8, text: '大四梅(65倍)' });&#xD;
            arr.push({ id: 9, text: '同花顺(150倍)' });&#xD;
            return arr;&#xD;
        }&#xD;
&#xD;
