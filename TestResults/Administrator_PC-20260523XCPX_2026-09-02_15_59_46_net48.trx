        function SaveUserPwd() {&#xD;
            var para = $('#form2').serializeObject();&#xD;
            request('/Game/UserInfo/ChgPwd', para, function (data) {&#xD;
                //提示消息&#xD;
                showUserResult(data);&#xD;
                if (data &amp;&amp; data.code == 1) {&#xD;
                    $('#chgWin').dialog('close');&#xD;
                    $('#form2').form('reset');&#xD;
                    refreshChangedUserRow(para.ID, 300);&#xD;
                }&#xD;
            });&#xD;
        }&#xD;
        function SaveUserSafePwd() {&#xD;
            var para = $('#formSafePwd').serializeObject();&#xD;
            request('/Game/UserInfo/ChgSafePwd', para, function (data) {&#xD;
                showUserResult(data);&#xD;
                if (data &amp;&amp; data.code == 1) {&#xD;
                    $('#chgSafePwdWin').dialog('close');&#xD;
                    $('#formSafePwd').form('reset');&#xD;
                    refreshChangedUserRow(para.ID, 300);&#xD;
                }&#xD;
            });&#xD;
        }&#xD;
