            arr.push({ id: 413, text: '四连·林冲(30倍)' });&#xD;
            arr.push({ id: 414, text: '四连·鲁智深(20倍)' });&#xD;
            arr.push({ id: 415, text: '四连·刀(15倍)' });&#xD;
            arr.push({ id: 416, text: '四连·枪(10倍)' });&#xD;
            arr.push({ id: 417, text: '四连·斧(5倍)' });&#xD;
            arr.push({ id: 420, text: '五连·忠义堂(1000倍)' });&#xD;
            arr.push({ id: 421, text: '五连·替天行道(400倍)' });&#xD;
