        function resetPlayerCoins(tipId, btnId) {&#xD;
            $(tipId).text('--');&#xD;
            $(btnId).linkbutton('disable');&#xD;
        }&#xD;
        function bindUserRechargeCoinTriggers() {&#xD;
            var queryRechargeByEnter = function (e) {&#xD;
                if (e.which == 13) {&#xD;
                    e.preventDefault();&#xD;
                    QueryPlayerCoins('#hfUID3', '#txtCurrentCoins_Recharge', '#btnSaveReChange');&#xD;
                }&#xD;
            };&#xD;
            var queryDeductByEnter = function (e) {&#xD;
                if (e.which == 13) {&#xD;
                    e.preventDefault();&#xD;
                    QueryPlayerCoins('#hfUID5', '#txtCurrentCoins_Deduct', '#btnSaveDeduct');&#xD;
                }&#xD;
            };&#xD;
            $('#txtE_UID3').textbox();&#xD;
            $('#txtE_UID3').textbox('textbox')&#xD;
                .on('blur', function () { QueryPlayerCoins('#hfUID3', '#txtCurrentCoins_Recharge', '#btnSaveReChange'); })&#xD;
                .on('keydown', queryRechargeByEnter);&#xD;
            $('#txtE_UID5').textbox();&#xD;
            $('#txtE_UID5').textbox('textbox')&#xD;
                .on('blur', function () { QueryPlayerCoins('#hfUID5', '#txtCurrentCoins_Deduct', '#btnSaveDeduct'); })&#xD;
                .on('keydown', queryDeductByEnter);&#xD;
        }&#xD;
        function QueryPlayerCoins(hiddenId, tipId, btnId) {&#xD;
            var id = $(hiddenId).val();&#xD;
            request('/Game/UserInfo/QueryPlayerCoins', { ID: id }, function (data) {&#xD;
                if (data &amp;&amp; data.code == 1) {&#xD;
                    $(tipId).text(top.goldFormat(data.datas.displayCoins || data.datas.coins || 0));&#xD;
                    $(btnId).linkbutton('enable');&#xD;
                } else {&#xD;
                    showUserResult(data);&#xD;
                }&#xD;
            });&#xD;
        }&#xD;
&#xD;
        function SaveGive() {&#xD;
            var para = $('#form9').serializeObject();&#xD;
            request('/Game/UserInfo/SaveGive', para, function (data) {&#xD;
                //提示消息&#xD;
                showUserResult(data);&#xD;
                if (data &amp;&amp; data.code == 1) {&#xD;
                    $('#chgGive').dialog('close');&#xD;
                    $('#form9').form('reset');&#xD;
                    refreshChangedUserRow(para.ID4, 500);&#xD;
                }&#xD;
            });&#xD;
        }&#xD;
&#xD;
        function SaveDeduct() {&#xD;
            var para = $('#form10').serializeObject();&#xD;
            request('/Game/UserInfo/SaveDeduct', para, function (data) {&#xD;
                //提示消息&#xD;
                showUserResult(data);&#xD;
                if (data &amp;&amp; data.code == 1) {&#xD;
                    $('#chgDeduct').dialog('close');&#xD;
                    $('#form10').form('reset');&#xD;
                    refreshChangedUserRow(para.ID5, 500);&#xD;
                }&#xD;
            });&#xD;
        }&#xD;
&#xD;
        function loadGoldLimit(uid, inputId) {&#xD;
            $('#' + inputId).numberbox('setValue', 0);&#xD;
            if (!uid) return;&#xD;
            $.post('/Game/UserInfo/GetUserGoldLimit', { ID: uid }, function (data) {&#xD;
                if (data &amp;&amp; data.code == 1 &amp;&amp; data.content) {&#xD;
                    $('#' + inputId).numberbox('setValue', parseInt(data.content) || 0);&#xD;
                }&#xD;
            });&#xD;
        }&#xD;
        function showRateCtrlWin(uid) {&#xD;
            var para = {&#xD;
                winId: '#chgRateWin',&#xD;
                title: '【鱼机控制】',&#xD;
                iconCls: 'icon-chart_curve',&#xD;
                callBack: function () {&#xD;
                    $('#txtE_ID').textbox('setValue', uid);&#xD;
                    $('#hfID').val(uid);&#xD;
                    $('#selE_Action1').combobox('loadData', actionSelData());&#xD;
                    $('#selE_Val1').combobox('loadData', getComboValKill());&#xD;
                    loadGoldLimit(uid, 'numGoldLimit1');&#xD;
                }&#xD;
            };&#xD;
            openWin(para);&#xD;
        }&#xD;
        function showRateCtrlWinPAIJI(uid) {&#xD;
            var para = {&#xD;
                winId: '#chgRateWinPAIJI',&#xD;
                title: '【牌机控制】',&#xD;
                iconCls: 'icon-chart_curve',&#xD;
                callBack: function () {&#xD;
                    $('#txtE_ID1').textbox('setValue', uid);&#xD;
                    $('#hfID1').val(uid);&#xD;
                    $('#selE_Mode').combobox({&#xD;
                        onChange: function(n) {&#xD;
                            if (n == 1) { $('.trPaiJiCtrl').show(); $('.trPaiJiKill').hide(); $('#hfPaiJiMode').val(0); }&#xD;
                            else { $('.trPaiJiCtrl').hide(); $('.trPaiJiKill').show(); $('#hfPaiJiMode').val(1); }&#xD;
                        }&#xD;
                    });&#xD;
                    $('#selE_Mode').combobox('loadData', [{id:1,text:'控牌',selected:true},{id:2,text:'点杀'}]);&#xD;
                    $('#selE_KillVal').combobox('loadData', getComboValKill());&#xD;
                    $('#hfPaiJiMode').val(0);&#xD;
                    $('#selE_Action').combobox('loadData', actionSelDataPAIJI());&#xD;
                    loadGoldLimit(uid, 'numGoldLimit3');&#xD;
                    loadUserCtrlConfigs(uid, function(data) {&#xD;
                        if (data &amp;&amp; data.length &gt; 0) {&#xD;
                            var row = data[0];&#xD;
                            if (row.CtrlType == 5 || row.CtrlType == 7 || row.CtrlType == 12 || row.CtrlType == 13 || row.CtrlType == 14) {&#xD;
                                $('#selE_Action').combobox('setValue', row.CtrlType);&#xD;
                                $('#selE_Type').combobox('setValue', row.CtrlValue);&#xD;
                                $('#selE_Number').combobox('setValue', row.Number);&#xD;
                                $('#selE_Val').combobox('setValue', row.TotalNumber);&#xD;
                            }&#xD;
                        }&#xD;
                    });&#xD;
                }&#xD;
            };&#xD;
            openWin(para);&#xD;
        }&#xD;
        function showRateCtrlWinLaba(uid) {&#xD;
            var para = {&#xD;
                winId: '#chgRateWinLaba',&#xD;
                title: '【拉霸控制】',&#xD;
                iconCls: 'icon-chart_curve',&#xD;
                callBack: function () {&#xD;
                    $('#txtE_ID_Laba').textbox('setValue', uid);&#xD;
                    $('#hfID_Laba').val(uid);&#xD;
                    $('#selE_Action_Laba').combobox({ onChange: bindLabaAction });&#xD;
                    $('#selE_Action_Laba').combobox('loadData', actionSelDataLaba());&#xD;
                    $('#selE_Symbol_Laba').combobox('loadData', valSelDataShz());&#xD;
                    $('#selE_Number_Laba').combobox('loadData', valSelData());&#xD;
                    $('#selE_Total_Laba').combobox('loadData', valSelDataPAIJI1());&#xD;
                    $('#selE_ModeLaba').combobox({&#xD;
                        onChange: function(n) {&#xD;
                            if (n == 1) { $('.trLabaCtrl').show(); $('.trLabaKill').hide(); $('#hfLabaMode').val(0); }&#xD;
                            else { $('.trLabaCtrl').hide(); $('.trLabaKill').show(); $('#hfLabaMode').val(1); }&#xD;
                        }&#xD;
                    });&#xD;
                    $('#selE_ModeLaba').combobox('loadData', [{id:1,text:'控牌',selected:true},{id:2,text:'点杀'}]);&#xD;
                    $('#selE_Val_Laba').combobox('loadData', getComboValKill());&#xD;
                    $('#hfLabaMode').val(0);&#xD;
                    loadGoldLimit(uid, 'numGoldLimitLaba');&#xD;
                    loadUserCtrlConfigs(uid, function(data) {&#xD;
                        if (data &amp;&amp; data.length &gt; 0) {&#xD;
                            var row = data[0];&#xD;
                            if (row.CtrlType &gt;= 15 &amp;&amp; row.CtrlType &lt;= 17) {&#xD;
                                $('#selE_Action_Laba').combobox('setValue', row.CtrlType);&#xD;
                                $('#selE_Symbol_Laba').combobox('setValue', row.CtrlValue);&#xD;
                                $('#selE_Number_Laba').combobox('setValue', row.Number);&#xD;
                                $('#selE_Total_Laba').combobox('setValue', row.TotalNumber);&#xD;
                                bindLabaAction(row.CtrlType);&#xD;
                            }&#xD;
                        }&#xD;
                    });&#xD;
                }&#xD;
            };&#xD;
            openWin(para);&#xD;
        }&#xD;
        function loadUserCtrlConfigs(uid, callback) {&#xD;
            if (!uid) { callback([]); return; }&#xD;
            $.post('/Game/UserInfo/GetUserCtrlConfigs', { ID: uid }, function(data) {&#xD;
                if (data &amp;&amp; data.code == 1 &amp;&amp; data.datas) { callback(data.datas); }&#xD;
                else { callback([]); }&#xD;
            });&#xD;
        }&#xD;
&#xD;
        @*合并控制按钮选择窗口*@&#xD;
        function showCtrlSelect(uid) {&#xD;
            var para = {&#xD;
                winId: '#chgCtrlSelect',&#xD;
                title: '【控制】',&#xD;
                iconCls: 'icon-chart_curve',&#xD;
                width: 280,&#xD;
                height: 260,&#xD;
                callBack: function () {&#xD;
                    $('#chgCtrlSelect').data('uid', uid);&#xD;
                    var canFish = @Html.Raw((loginUser.UserPriv == 0 || loginUser.IsKill == 1 || loginUser.IsProbability == 1) ? "true" : "false");&#xD;
                    var canPaiJi = @Html.Raw((loginUser.UserPriv == 0 || loginUser.IsRelease == 1) ? "true" : "false");&#xD;
                    if (canFish) $('#btnFishCtrl').show(); else $('#btnFishCtrl').hide();&#xD;
                    if (canPaiJi) $('#btnPaiJiCtrl').show(); else $('#btnPaiJiCtrl').hide();&#xD;
                    @*拉霸控制已收编进总控（吃分/控牌），不再单独显示入口*@&#xD;
                    var canTotal = @Html.Raw((loginUser.UserPriv == 0 || loginUser.IsKill == 1 || loginUser.IsProbability == 1 || loginUser.IsRelease == 1) ? "true" : "false");&#xD;
                    if (canTotal) $('#btnTotalCtrl').show(); else $('#btnTotalCtrl').hide();&#xD;
                }&#xD;
            };&#xD;
            openWin(para);&#xD;
        }&#xD;
        function subCtrlClick(type) {&#xD;
            var uid = $('#chgCtrlSelect').data('uid');&#xD;
            $('#chgCtrlSelect').dialog('close');&#xD;
            if (type == 'fish') showRateCtrlWin(uid);&#xD;
            else if (type == 'paiji') showRateCtrlWinPAIJI(uid);&#xD;
            else if (type == 'laba') showRateCtrlWinLaba(uid);&#xD;
            else if (type == 'total') showTotalCtrlWin(uid);&#xD;
        }&#xD;
&#xD;
        @*总控（总点杀/总放水/总控牌），达到金币阈值后自动失效并恢复桌台参数难度*@&#xD;
        function totalModeData() {&#xD;
            var items = [];&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsKill == 1)&#xD;
            {&#xD;
                @Html.Raw("items.push({ id: 4, text: '吃分' });");&#xD;
            }&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsProbability == 1)&#xD;
            {&#xD;
                @Html.Raw("items.push({ id: 5, text: '放水' });");&#xD;
            }&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsRelease == 1)&#xD;
            {&#xD;
                @Html.Raw("items.push({ id: 6, text: '控牌' });");&#xD;
            }&#xD;
            if (items.length &gt; 0) items[0].selected = true;&#xD;
            return items;&#xD;
        }&#xD;
        function totalCardActionData() {&#xD;
            return [&#xD;
                { id: 5, text: '大字版控制', selected: true },&#xD;
                { id: 7, text: 'ATT3控制' },&#xD;
                { id: 12, text: '金皇冠' },&#xD;
                { id: 13, text: 'NBA' },&#xD;
                { id: 14, text: '火凤凰' },&#xD;
                { id: 15, text: '水浒传' },&#xD;
                { id: 16, text: '明星97' },&#xD;
                { id: 17, text: '水果拉霸' }&#xD;
            ];&#xD;
        }&#xD;
        function totalModeName(m) {&#xD;
            m = parseInt(m);&#xD;
            return m == 4 ? '吃分' : (m == 5 ? '放水' : (m == 6 ? '控牌' : ''));&#xD;
        }&#xD;
        function bindTotalMode(n) {&#xD;
            n = parseInt(n);&#xD;
            if (n == 6) {&#xD;
                $('.trTotalStrength').hide();&#xD;
                $('.trTotalCard').show();&#xD;
                // 控牌按次数控制，不需要金币阈值&#xD;
                $('.trTotalGold').hide();&#xD;
                $('#numGold_Total').numberbox('setValue', 0);&#xD;
            } else {&#xD;
                $('.trTotalCard').hide();&#xD;
                $('.trTotalStrength').show();&#xD;
                // 吃分/放分需要金币阈值&#xD;
                $('.trTotalGold').show();&#xD;
                if (n == 5) $('#selE_Strength_Total').combobox('loadData', getComboValPut_Total());&#xD;
                else $('#selE_Strength_Total').combobox('loadData', getComboValKill_Total());&#xD;
            }&#xD;
        }&#xD;
        function bindTotalCardAction(newValue, oldValue) {&#xD;
            var n = parseInt(newValue);&#xD;
            if (n == 5 || n == 7 || n == 12 || n == 13 || n == 14) {&#xD;
                // 牌机型：按所选游戏动态生成0-12牌型+关闭(99)，倍率与台机设定一致&#xD;
                $('#selE_Type_Total').combobox('loadData', valSelDataPAIJI(n));&#xD;
            } else if (n == 15) $('#selE_Type_Total').combobox('loadData', valSelDataShz());&#xD;
            else if (n == 16) $('#selE_Type_Total').combobox('loadData', valSelDataMx97());&#xD;
            else if (n == 17) $('#selE_Type_Total').combobox('loadData', valSelDataFruit());&#xD;
        }&#xD;
        function showTotalCtrlWin(uid) {&#xD;
            var para = {&#xD;
                winId: '#chgTotalCtrlWin',&#xD;
                title: '【总控】',&#xD;
                iconCls: 'icon-chart_curve',&#xD;
                width: 430,&#xD;
                height: 460,&#xD;
                callBack: function () {&#xD;
                    $('#txtE_ID_Total').textbox('setValue', uid);&#xD;
                    $('#hfID_Total').val(uid);&#xD;
                    $('#selE_Action_Total').combobox({ onChange: bindTotalCardAction });&#xD;
                    $('#selE_Action_Total').combobox('loadData', totalCardActionData());&#xD;
                    // loadData 默认选中第一项(id=5)但不会触发 onChange，需显式初始化控制牌类型下拉，&#xD;
                    // 否则 #selE_Type_Total 为空，提交时 CardValue="" 被解析为 0(杂牌)，导致送牌型失败。&#xD;
                    bindTotalCardAction($('#selE_Action_Total').combobox('getValue'));&#xD;
                    $('#selE_Number_Total').combobox('loadData', valSelData());&#xD;
                    $('#selE_Total_Total').combobox('loadData', valSelDataPAIJI1());&#xD;
                    // 次数/总次数默认值：次数=1，总次数=五把之内(id5)。loadData 未必自动选中首项，故显式指定。&#xD;
                    $('#selE_Number_Total').combobox('setValue', 1);&#xD;
                    $('#selE_Total_Total').combobox('setValue', 5);&#xD;
                    $('#selE_Strength_Total').combobox('loadData', getComboValKill_Total());&#xD;
                    $('#numGold_Total').numberbox('setValue', 0);&#xD;
                    $('#selE_Mode_Total').combobox({ onChange: bindTotalMode });&#xD;
                    $('#selE_Mode_Total').combobox('loadData', totalModeData());&#xD;
                    bindTotalMode($('#selE_Mode_Total').combobox('getValue'));&#xD;
                    loadTotalCtrlStatus(uid);&#xD;
                }&#xD;
            };&#xD;
            openWin(para);&#xD;
        }&#xD;
        function loadTotalCtrlStatus(uid) {&#xD;
            $('#divTotalStatus').html('加载中...');&#xD;
            request('/Game/UserInfo/GetTotalControlStatus', { ID: uid }, function (data) {&#xD;
                if (!data || data.code != 1 || !data.datas || data.datas.length == 0) {&#xD;
                    $('#divTotalStatus').html('&lt;span style="color:#999;"&gt;当前无执行中的总控&lt;/span&gt;');&#xD;
                    return;&#xD;
                }&#xD;
                var html = '';&#xD;
                for (var i = 0; i &lt; data.datas.length; i++) {&#xD;
                    var r = data.datas[i];&#xD;
                    if (r.ControlMode == 6) {&#xD;
                        // 控牌：显示控牌值 + 次数/总次数（牌机消耗后未回写，此处为下发时的配置值）&#xD;
                        html += '&lt;div style="margin:2px 0;"&gt;'&#xD;
                            + totalModeName(r.ControlMode)&#xD;
                            + '（控牌值 ' + labaTypeName(r.GameId, r.LimitCoins) + '）'&#xD;
                            + ' 次数 ' + r.CardNumber + '/' + r.CardTotal&#xD;
                            + '&lt;/div&gt;';&#xD;
                    } else {&#xD;
                        var isRelease = (r.ControlMode == 5);&#xD;
                        var progress = isRelease ? r.GrantedCoins : r.ConsumedCoins;&#xD;
                        html += '&lt;div style="margin:2px 0;"&gt;'&#xD;
                            + totalModeName(r.ControlMode)&#xD;
                            + '（强度 ' + r.LimitCoins + '）'&#xD;
                            + ' 阈值 ' + r.TargetCoins&#xD;
                            + ' 已' + (isRelease ? '放' : '吃') + '分 ' + progress&#xD;
                            + '&lt;/div&gt;';&#xD;
                    }&#xD;
                }&#xD;
                $('#divTotalStatus').html(html);&#xD;
            });&#xD;
        }&#xD;
        function SaveTotalCtrl() {&#xD;
            var uid = $('#hfID_Total').val();&#xD;
            var mode = parseInt($('#selE_Mode_Total').combobox('getValue'));&#xD;
            var para = { ID: uid, Mode: mode };&#xD;
            if (mode == 6) {&#xD;
                // 控牌按次数控制，不需要金币阈值&#xD;
                para.GoldThreshold = 0;&#xD;
                para.CardAction = $('#selE_Action_Total').combobox('getValue');&#xD;
                para.CardValue = $('#selE_Type_Total').combobox('getValue');&#xD;
                para.CardNumber = $('#selE_Number_Total').combobox('getValue');&#xD;
                para.CardTotal = $('#selE_Total_Total').combobox('getValue');&#xD;
            } else {&#xD;
                // 吃分/放分需要金币阈值&#xD;
                var gold = $('#numGold_Total').numberbox('getValue');&#xD;
                if (!gold || parseInt(gold) &lt;= 0) {&#xD;
                    showUserToast('请填写大于 0 的目标！', 'danger');&#xD;
                    return;&#xD;
                }&#xD;
                para.GoldThreshold = gold;&#xD;
                para.Strength = $('#selE_Strength_Total').combobox('getValue');&#xD;
            }&#xD;
            request('/Game/UserInfo/ApplyTotalControl', para, function (data) {&#xD;
                showUserResult(data);&#xD;
                if (data &amp;&amp; data.code == 1) {&#xD;
                    loadTotalCtrlStatus(uid);&#xD;
                    refreshChangedUserRow(uid, 500);&#xD;
                }&#xD;
            });&#xD;
        }&#xD;
        function CloseTotalCtrl() {&#xD;
            var uid = $('#hfID_Total').val();&#xD;
            var mode = parseInt($('#selE_Mode_Total').combobox('getValue'));&#xD;
            @Html.Raw(@"confirm('确认关闭该玩家的' + totalModeName(mode) + '？', function () {&#xD;
                request('/Game/UserInfo/CloseTotalControl', { ID: uid, Mode: mode }, function (data) {&#xD;
                    showUserResult(data);&#xD;
                    if (data &amp;&amp; data.code == 1) {&#xD;
                        loadTotalCtrlStatus(uid);&#xD;
                        refreshChangedUserRow(uid, 500);&#xD;
                    }&#xD;
                });&#xD;
            });")&#xD;
        }&#xD;
        function actionSelData() {&#xD;
            var items = [];&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsKill == 1)&#xD;
            {&#xD;
                @Html.Raw("items.push({ id: 1, text: '鱼机点杀' });");&#xD;
            }&#xD;
            @if (loginUser.UserPriv == 0 || loginUser.IsProbability == 1)&#xD;
            {&#xD;
                @Html.Raw("items.push({ id: 2, text: '鱼机放水' });");&#xD;
            }&#xD;
            if (items.length &gt; 0) items[0].selected = true;&#xD;
            return items;&#xD;
        }&#xD;
&#xD;
